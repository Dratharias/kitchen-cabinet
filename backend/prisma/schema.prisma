datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model app_user {
  user_id  String   @id @default(uuid())
  username String   @unique
  password String
  role     String   @default("user")
  updated  DateTime @default(now())
  created  DateTime @default(now())

  @@map("app_user")
}

model category {
  category_id String @id @default(uuid())
  str_value   String
  type        String

  publications_type   publication[]      @relation("PublicationType")
  publications_style  publication[]      @relation("PublicationStyle")
  publications_author publication[]      @relation("PublicationAuthor")
  prep_time           prep_time[]        @relation("PrepTimeStyle")
  publication_tags    publication_tag[]
  product_categories  product_category[]

  @@unique([str_value, type])
  @@index([type])
  @@index([str_value])
  @@index([str_value, type])
}

model publication {
  publication_id String   @id @default(uuid())
  title          String
  description    String[]
  note           String[]
  public         Boolean  @default(false)
  published      Boolean  @default(false)
  thumbnail      String?
  type_id        String?
  style_id       String?
  author_id      String?
  gallery        String[] // Rétrocompatibilité
  date_created   DateTime @default(now())

  type   category? @relation("PublicationType", fields: [type_id], references: [category_id])
  style  category? @relation("PublicationStyle", fields: [style_id], references: [category_id])
  author category? @relation("PublicationAuthor", fields: [author_id], references: [category_id])

  contents   content[]
  productRef product[]         @relation("RecipeReference")
  reviews    review[]
  tags       publication_tag[]

  @@index([type_id])
  @@index([style_id])
  @@index([author_id])
  @@index([published])
}

model publication_tag {
  publication_id String
  category_id    String

  publication publication @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade)
  category    category    @relation(fields: [category_id], references: [category_id], onDelete: Cascade)

  @@id([publication_id, category_id])
}

model content {
  content_id      String   @id @default(uuid())
  publication_id  String
  total_prep_time Int      @default(0) @db.SmallInt
  servings        Int?     @db.SmallInt
  subtitle        String?
  thumbnail      String?
  gallery        String[] // Nouvelle gallerie
  is_ingredient   Boolean?

  publication         publication          @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade)
  content_segments    content_segment[]
  content_ingredients content_ingredient[]
  content_prep_times  content_prep_time[]

  @@index([publication_id])
}

model segment {
  segment_id String  @id @default(uuid())
  title      String?
  paragraph  String  @unique

  content_segments  content_segment[]
  segment_prep_time segment_prep_time[]
}

model unit {
  unit_id String @id @default(uuid())
  name    String @unique

  ingredient_units ingredient_unit[]
}

model macro {
  macro_id  String @id @default(uuid())
  calories  Int?   @db.SmallInt
  protein   Int?   @db.SmallInt
  fiber     Int?   @db.SmallInt
  sugar     Int?   @db.SmallInt
  saturated Int?   @db.SmallInt
  trans     Int?   @db.SmallInt
  caffein   Int?   @db.SmallInt

  products product[]
}

model product {
  product_id   String       @id @default(uuid())
  name         String       @unique
  en_name      String?
  macro_id     String?
  is_recipe_id String?
  isRecipe     publication? @relation("RecipeReference", fields: [is_recipe_id], references: [publication_id])

  macro              macro?             @relation(fields: [macro_id], references: [macro_id])
  ingredients        ingredient[]
  reviews            review[]
  product_categories product_category[]
}

model ingredient {
  ingredient_id   String   @id @default(uuid())
  quantity        Decimal? @db.Decimal(10, 2)
  product_id      String
  cut             String?
  title           String?
  multiply_factor Decimal  @default(1.00) @db.Decimal(10, 2)

  product             product              @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  content_ingredients content_ingredient[]
  ingredient_units    ingredient_unit[]
}

model prep_time {
  prep_time_id String  @id @default(uuid())
  duration     Int     @db.SmallInt
  style_id     String?

  style category? @relation("PrepTimeStyle", fields: [style_id], references: [category_id])

  content_prep_times content_prep_time[]
  segment_prep_time  segment_prep_time[]
}

model content_segment {
  content_id String
  segment_id String
  position   Int?   @db.SmallInt

  content content @relation(fields: [content_id], references: [content_id], onDelete: Cascade)
  segment segment @relation(fields: [segment_id], references: [segment_id], onDelete: Cascade)

  @@id([content_id, segment_id])
}

model content_ingredient {
  content_id    String
  ingredient_id String

  content    content    @relation(fields: [content_id], references: [content_id], onDelete: Cascade)
  ingredient ingredient @relation(fields: [ingredient_id], references: [ingredient_id], onDelete: Cascade)

  @@id([content_id, ingredient_id])
}

model content_prep_time {
  content_id   String
  prep_time_id String

  content   content   @relation(fields: [content_id], references: [content_id], onDelete: Cascade)
  prep_time prep_time @relation(fields: [prep_time_id], references: [prep_time_id], onDelete: Cascade)

  @@id([content_id, prep_time_id])
}

model segment_prep_time {
  segment_id   String
  prep_time_id String

  segment   segment   @relation(fields: [segment_id], references: [segment_id], onDelete: Cascade)
  prep_time prep_time @relation(fields: [prep_time_id], references: [prep_time_id], onDelete: Cascade)

  @@id([segment_id, prep_time_id])
}

model ingredient_unit {
  ingredient_id String
  unit_id       String

  ingredient ingredient @relation(fields: [ingredient_id], references: [ingredient_id], onDelete: Cascade)
  unit       unit       @relation(fields: [unit_id], references: [unit_id], onDelete: Cascade)

  @@id([ingredient_id, unit_id])
  @@index([unit_id])
}

model product_category {
  product_id  String
  category_id String

  product  product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  category category @relation(fields: [category_id], references: [category_id], onDelete: Cascade)

  @@id([product_id, category_id])
}

model review {
  review_id      String   @id @default(uuid())
  product_id     String?
  publication_id String?
  rating         Int?     @db.SmallInt
  comment        String[]
  description    String[]
  buy_again      String?  @db.Char(1)
  date_review    DateTime @default(now())

  product     product?     @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  publication publication? @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade)
}
