datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model app_user {
  user_id  String   @id @default(uuid())
  username String   @unique
  password String
  role     String   @default("user")
  updated  DateTime @default(now())
  created  DateTime @default(now())

  @@map("app_user")
}

// ============================================================================
// CORE PUBLICATION SYSTEM
// ============================================================================

model publication {
  publication_id String   @id @default(uuid())
  title          String
  description    String[] @default([])
  note           String[] @default([])
  public         Boolean  @default(false)
  published      Boolean  @default(false)
  thumbnail      String?
  date_created   DateTime @default(now())
  date_updated   DateTime @updatedAt

  contents content[]
  reviews  review[]
  tags     publication_tag[]

  @@index([published, public])
  @@index([date_created])
}

model content {
  content_id       String  @id @default(uuid())
  publication_id   String
  subtitle         String?
  thumbnail        String?
  note             String? @db.Text

  // Prep time
  total_prep_time  Int     @default(0) @db.SmallInt
  prep_time_note   String?

  // Servings (denormalized from servings table)
  serving_yield    Int?    @db.SmallInt
  serving_value    String?

  // Gallery (denormalized from gallery + content_gallery tables)
  gallery          Json?   @default("[]")

  publication         publication          @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade)
  content_segments    content_segment[]
  content_ingredients content_ingredient[]

  @@index([publication_id])
}

// ============================================================================
// RECIPE COMPONENTS
// ============================================================================

model segment {
  segment_id String  @id @default(uuid())
  title      String?
  paragraph  String  @db.Text
  note       String? @db.Text
  section    String? // Group title for visual segmentation

  content_segments content_segment[]
}

model ingredient {
  ingredient_id   String   @id @default(uuid())
  product_id      String
  quantity        Decimal? @db.Decimal(10, 2)
  unit_id         String?
  cut             String?
  title           String?
  note            String?  @db.Text
  multiply_factor Decimal  @default(1.00) @db.Decimal(10, 2)
  section         String?  // Group title for visual segmentation

  product             product              @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  unit                unit?                @relation(fields: [unit_id], references: [unit_id])
  content_ingredients content_ingredient[]

  @@index([product_id])
  @@index([unit_id])
}

model product {
  product_id  String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text

  ingredients ingredient[]

  @@index([name])
}

model unit {
  unit_id String @id @default(uuid())
  name    String @unique

  ingredients ingredient[]
}

// ============================================================================
// JUNCTION TABLES (M:N Relationships)
// ============================================================================

model content_segment {
  content_id String
  segment_id String
  position   Int?   @db.SmallInt

  content content @relation(fields: [content_id], references: [content_id], onDelete: Cascade)
  segment segment @relation(fields: [segment_id], references: [segment_id], onDelete: Cascade)

  @@id([content_id, segment_id])
}

model content_ingredient {
  content_id    String
  ingredient_id String

  content    content    @relation(fields: [content_id], references: [content_id], onDelete: Cascade)
  ingredient ingredient @relation(fields: [ingredient_id], references: [ingredient_id], onDelete: Cascade)

  @@id([content_id, ingredient_id])
}

// ============================================================================
// TAGGING SYSTEM
// ============================================================================

model tag {
  tag_id      String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  publication_tags publication_tag[]

  @@index([name])
}

model publication_tag {
  publication_id String
  tag_id         String

  publication publication @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade)
  tag         tag         @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade)

  @@id([publication_id, tag_id])
  @@index([tag_id])
}

// ============================================================================
// REVIEWS
// ============================================================================

model review {
  review_id      String   @id @default(uuid())
  publication_id String
  rating         Int?     @db.SmallInt
  comment        String[] @default([])
  description    String[] @default([])
  date_review    DateTime @default(now())

  publication publication @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade)

  @@index([publication_id])
  @@index([date_review])
}
