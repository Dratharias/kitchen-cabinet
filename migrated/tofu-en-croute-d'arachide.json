          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol moyen, mélangez le beurre d'arachide et l'eau chaude jusqu'à consistance lisse."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez la sauce soja, le jus de lime, le sucre brun, l'ail, le gingembre et les flocons de piment rouge (si désiré), mélangez bien."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Chauffez l'huile de sésame dans une petite casserole à feu moyen. Versez le mélange de beurre d'arachide dans la casserole et faites chauffer pendant 2 à 3 minutes, en remuant constamment, jusqu'à ce que la sauce soit chaude et légèrement épaissie."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Goûtez la sauce et ajustez les assaisonnements selon vos préférences. Ajoutez plus de sucre, de sauce soja ou de jus de lime si nécessaire."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Retirez du feu et laissez refroidir légèrement avant de servir avec votre plat préféré."
                }
              }
            }
