          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Égouttez d'abord et séchez le tofu avec du papier absorbant. Coupez le bloc en rectangles de 1 pouce sur 1/2 pouce."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Mélangez le beurre de cacahuète, le soja, le citron vert, le piment et l'ail."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Trempez les filets de tofu dans le mélange de beurre de cacahuète puis dans la chapelure de cacahuètes et assurez-vous qu'ils sont tous bien enrobés."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Une fois que vous avez enrobé tout le tofu, placez le tofu sur une plaque à pâtisserie recouverte de papier sulfurisé."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Préchauffez votre four à 350°F."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Colorez ensuite légèrement le tofu enrobé dans une poêle antiadhésive sèche placée sur feu moyen pendant environ 2 minutes de chaque côté."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Une fois doré, remettez le tofu sur la plaque à pâtisserie puis dans votre four préchauffé pendant 15 minutes."
                }
              }
            }
          ]
        },
