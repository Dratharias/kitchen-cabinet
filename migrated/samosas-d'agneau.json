          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Retirez les feuilles de rouleaux de printemps du congélateur et mettez-les de côté pour décongeler pendant que vous préparez la garniture."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Pour la garniture, mettez les pois dans un bol, versez de l'eau bouillante pour les couvrir et laissez reposer pendant 5 secondes, puis égouttez bien."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Chauffez l'huile dans une casserole moyenne à feu moyen. Ajoutez les graines de cumin et laissez-les crépiter pendant 30 secondes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Baissez le feu, ajoutez l'oignon rouge et faites cuire jusqu'à ce qu'il devienne translucide, environ 5 minutes ; ne le laissez pas colorer. Ajoutez les pâtes d'ail et de gingembre ainsi que le piment vert et faites sauter pendant 3 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Ajoutez la poudre de piment, le cumin en poudre, le curcuma, le poivre noir et le sel et faites sauter pendant 2 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Ajoutez la viande d'agneau hachée, augmentez un peu le feu et faites sauter pendant 5 minutes, en remuant presque constamment. La viande doit être légèrement dorée partout."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Baissez le feu, ajoutez le jus de lime, couvrez et laissez cuire pendant 15 minutes, en remuant régulièrement. Le mélange doit être assez sec ; si nécessaire, faites cuire à découvert pendant quelques minutes pour évaporer l'excès de liquide."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Ajoutez les pois, la coriandre hachée, le garam masala et la cannelle. Mélangez bien et laissez refroidir complètement avant de former les samosas."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Mélangez la farine avec suffisamment d'eau froide (1 à 2 cuil. à soupe) pour obtenir une colle (elle doit être suffisamment épaisse pour enrober mais assez fine pour s'étaler facilement)."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Pliez les samosas pour enfermer la garniture, en suivant l'une des deux méthodes illustrées ci-dessous."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Samosas D Agneau",
                  "paragraph": "Pour frire les samosas, chauffez l'huile dans une friteuse ou une autre poêle profonde et à base lourde à 325°F. Faites frire par lots pendant 4 à 5 minutes, en retournant les samosas de temps en temps, jusqu'à ce que la pâte soit d'un brun doré foncé. Égouttez bien sur du papier absorbant avant de servir, avec des quartiers de lime."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Placez une enveloppe de samosa sur une surface plane. Prenez une cuillère à soupe de mélange et serrez-la avec vos mains pour essayer de la maintenir ensemble. Placez-la dans le coin inférieur gauche de l'enveloppe, en laissant suffisamment d'espace pour pouvoir replier ce coin par-dessus."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Repliez le coin en ramenant le point inférieur gauche sur la garniture."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Amenez le coin vers le centre de la pâte."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Pliez le côté gauche sur le côté droit pour créer un rectangle."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Repliez le coin inférieur droit vers le haut."
                }
              }
            },
            {
              "position": 17,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Maintenant, pliez le triangle vers le haut. Vous devriez avoir une forme de samosa avec un rabat ouvert."
                }
              }
            },
            {
              "position": 18,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Appliquez de la colle de farine sur le rabat ouvert."
                }
              }
            },
            {
              "position": 19,
              "segment": {
                "data": {
                  "title": "Méthode De Pliage 1",
                  "paragraph": "Repliez le rabat pour enfermer la garniture et sceller."
                }
              }
            },
            {
              "position": 20,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Coupez les enveloppes de samosa en deux pour créer des rectangles et en déposez une horizontalement sur la surface de travail."
                }
              }
            },
            {
              "position": 21,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Prenez le coin supérieur droit et pliez-le en diagonale vers le bas de sorte que le coin droit chevauche maintenant le bas de la bande. Appuyez très légèrement, juste pour faire un pli et le maintenir en place, plutôt que de sceller. Vous aurez ainsi créé une ligne diagonale à travers la pâte."
                }
              }
            },
            {
              "position": 22,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Maintenant, pliez la pâte de gauche sur cette ligne diagonale pour amener les bords inférieurs au même niveau et créer un cône."
                }
              }
            },
            {
              "position": 23,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Versez la garniture de samosa dans le cône de filo et enfoncez la garniture avec vos doigts pour qu'elle ne soit pas tout à fait jusqu'au sommet."
                }
              }
            },
            {
              "position": 24,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Vous devriez maintenant avoir un cône rempli avec un grand rabat de pâte. Pliez fermement la pâte sur le samosa, en suivant sa forme."
                }
              }
            },
            {
              "position": 25,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Appliquez la dernière pliure avec la colle de farine."
                }
              }
            },
            {
              "position": 26,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Repliez le rabat sur la garniture pour l'enclore et la fermer hermétiquement."
                }
              }
            },
            {
              "position": 27,
              "segment": {
                "data": {
                  "title": "Pour Servir",
                  "paragraph": "Faites un cercle avec votre pouce et votre index, puis prenez délicatement la pâte de manière à encastrer le cône dans le cercle."
                }
              }
            }
          ]
        }
      ]
    }
  }
}