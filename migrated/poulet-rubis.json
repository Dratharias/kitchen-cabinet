          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Poulet Rubis",
                  "paragraph": "Pour la marinade, mélanger les ingrédients ensemble dans un mixeur jusqu'à obtenir une pâte lisse. Transférer dans un bol."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Poulet Rubis",
                  "paragraph": "Couper le poulet en morceaux de 4 cm. Ajouter à la marinade et retourner pour enrober. Couvrir et laisser mariner au réfrigérateur pendant 6 à 24 heures."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Poulet Rubis",
                  "paragraph": "Préchauffer le gril à feu moyen-élevé. Placer le poulet mariné sur une grille dans le plat du gril, badigeonner de beurre fondu et griller pendant 8 à 10 minutes, jusqu'à ce qu'il soit cuit à travers et bien grillé."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Poulet Rubis",
                  "paragraph": "Chauffer une grande casserole à feu moyen-doux. Ajouter la sauce makhani, la crème et le poulet grillé et laisser mijoter très doucement pendant 10 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Poulet Rubis",
                  "paragraph": "Servir le curry garni d'allumettes de gingembre, de coriandre hachée et de graines de grenade, avec un bol de riz cuit à la vapeur à côté."
                }
              }
            }
          ]
