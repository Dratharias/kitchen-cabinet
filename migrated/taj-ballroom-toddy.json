          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Taj Ballroom Toddy",
                  "paragraph": "Mettez le cidre, le jus de pomme, le jus de gingembre et les épices dans une casserole. Chauffez à feu moyen-doux, en remuant de temps en temps, jusqu'à ce que le liquide atteigne le point de frémissement. Laissez frémir très doucement pendant 2 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Taj Ballroom Toddy",
                  "paragraph": "Ajoutez le sirop d'agave et mélangez bien."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Taj Ballroom Toddy",
                  "paragraph": "Mesurez 25 ml de whisky dans chaque tasse ou petit verre résistant à la chaleur."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Taj Ballroom Toddy",
                  "paragraph": "Versez 100 ml de cidre chaud dans chaque tasse."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Taj Ballroom Toddy",
                  "paragraph": "Garnissez avec la tranche d'orange séchée ou la bande de zeste d'orange et servez immédiatement."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Jus De Gingembre",
                  "paragraph": "Pour faire ceci, râpez du gingembre pelé dans un carré de mousseline placé dans un bol. Rassemblez les bords de la mousseline et pressez le jus. Vous aurez besoin d'environ 8 cm de racine de gingembre pour obtenir 40 ml de jus (c'est-à-dire 1 cm pour 5 ml)."
                }
              }
            }
          ]
        }
      ]
