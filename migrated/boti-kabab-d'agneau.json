          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Placer une passoire sur un bol et la recouvrir d'une mousseline. Verser le yogourt dans le tissu en mousseline et laisser égoutter pendant au moins 3 heures (voir note)."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Pendant ce temps, tailler l'agneau pour éliminer tout excès de gras et le couper en morceaux de 3 cm. Éponger autant que possible avec du papier absorbant. Placer dans un bol, ajouter la pâte de papaye et mélanger pour enrober les morceaux d'agneau. Couvrir et laisser reposer pendant 30 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Dans un grand bol, mélanger le yogourt égoutté avec les ingrédients restants de la marinade."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Lorsque les 30 minutes sont écoulées, transférer l'agneau dans une passoire pour égoutter le liquide et secouer la passoire pour éliminer l'excès d'humidité. Mélanger la viande dans la marinade au yogourt, couvrir et réfrigérer pendant 24 heures."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Sortir l'agneau du réfrigérateur 30 minutes avant la cuisson. (Si vous utilisez des brochettes en bois, les faire tremper maintenant.) Préchauffer le gril à feu moyen-élevé."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Enfiler la viande sur vos brochettes, en prenant soin de ne pas la tasser trop fermement."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Boti Kabab D Agneau",
                  "paragraph": "Griller les kababs pendant 6 à 8 minutes, en les retournant régulièrement, jusqu'à ce qu'ils soient légèrement grillés et cuits à point mais pas trop cuits. Saupoudrer de masala de kabab, de beurre fondu et de jus de lime, en retournant les kababs pour les enrober uniformément. Terminer avec une pincée de menthe émincée. Servir immédiatement, avec du kachumber et des quartiers de lime à presser."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Note",
                  "paragraph": "Égoutter le yogourt pendant 3 heures réduit la teneur en eau afin que la marinade adhère à la viande ; c'est encore mieux si vous parvenez à le laisser égoutter toute la nuit au réfrigérateur."
                }
              }
            }
          ]
        }
      ]
    }
