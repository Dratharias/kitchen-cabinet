          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Aubergines",
                  "paragraph": "Préchauffer le four à 200 °C (400 °F)."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Aubergines",
                  "paragraph": "Déposer les aubergines dans un plat allant au four, côté pelure en dessous. "
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Aubergines",
                  "paragraph": "Quadriller les aubergines avec la pointe d'un petit couteau puis assaisonner, huiler et ajouter les branches de thym."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Aubergines",
                  "paragraph": "Cuire de 45 minutes à 1 heure ou jusqu'à ce qu'elles soient bien tendres. "
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Tomates",
                  "paragraph": "Mélanger tous les ingrédients des tomates à l'exception de l'aneth dans un plat allant au four, saler et poivrer. "
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Tomates",
                  "paragraph": "Cuire 15 minutes à 200°C (400 °F). "
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Mélasse De Canneberges",
                  "paragraph": "Dans une petite casserole, mélanger le jus de canneberge et le sucre."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Mélasse De Canneberges",
                  "paragraph": "Amener à ébullition, baisser le feu et laisser réduire jusqu'à l'obtention d'un sirop. Réserver. "
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Muhammara",
                  "paragraph": "Blanchir les noix de Grenoble à l'eau bouillante pendant 5 minutes, égoutter et sécher sur un linge."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Muhammara",
                  "paragraph": "Verser tous les ingrédients du muhammara dans la cuve du mélangeur, assaisonner et broyer jusqu'à l'obtention d'une purée assez lisse. "
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Service",
                  "paragraph": "Déposer le muhammara dans le fond d'une assiette de service, y déposer l'aubergine, garnir des tomates et d'aneth. "
                }
              }
            }
          ]
        }
      ]
    }
