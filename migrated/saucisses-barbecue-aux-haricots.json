          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Faire revenir l'oignon, le poivron, les champignons, l'ail, les herbes et les épices à feu moyen."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Ajoutez les haricots dans un bol à mélanger avec la farine et les noix."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Une fois le mélange d'oignons ramolli, ajoutez-le dans le bol de mixage. À l'aide d'un presse-purée, écrasez le mélange jusqu'à ce qu'il commence à peine à se rassembler. N'écrasez pas trop le mélange, vous voulez de la texture."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Farinez légèrement vos mains, puis façonnez le mélange en forme de saucisses. J'obtiens généralement 8 à 9 saucisses du mélange."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Enveloppez les saucisses individuellement d'abord dans du papier sulfurisé, puis dans une feuille de papier d'aluminium, bien serrées."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Une fois que vous avez emballé toutes les saucisses, placez-les dans une casserole d'eau frémissante. Laissez-les cuire 20 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Retirez les saucisses de l'eau une fois cuites. Une fois suffisamment refroidi pour être manipulé, retirez l'emballage. Recyclez le papier d'aluminium."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Pour la salsa verde, hachez enfin les herbes avec l'ail, les cornichons et les câpres. Une fois bien, ajoutez le mélange dans un bol et incorporez la moutarde, le vinaigre et l'huile. Assaisonner selon l'envie."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "Faites griller ou griller les saucisses pendant 4 à 5 minutes et servez-les avec la salsa."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Saucisses Barbecue Aux Haricots",
                  "paragraph": "J'ai légèrement grillé de la chicorée pour accompagner les saucisses."
                }
              }
            }
          ]
        }
      ]
