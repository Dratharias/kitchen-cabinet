          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Écrasez grossièrement les graines de coriandre et les grains de poivre noir et blanc dans un mortier avec un pilon ou dans un moulin à épices ou dans un sac en plastique à l'aide d'un maillet lourd. L'idée est de les concasser plutôt que de les pulvériser."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Placez-les dans un bol et ajoutez l'ail, les graines de moutarde, le sel, le sucre et le paprika. Utilisez vos doigts pour bien mélanger."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Transférez dans un bocal, couvrez et réfrigérez. Le rub se conservera au moins une semaine."
                }
              }
            }
          ]
        }
