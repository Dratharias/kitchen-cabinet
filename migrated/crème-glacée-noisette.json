          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Faites chauffer le lait et la crème jusqu'à frémissement puis incorporez le praliné noisette et mélangez pour le diluer (au besoin n'hésitez pas à utiliser le mixer à bras)."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Fouettez les jaunes d'œufs avec le miel, versez le mélange lait-praliné par dessus, mélangez et reversez le tout dans la casserole, faites chauffer à feu moyen sans cesser de remuer jusqu'à ce que la crème épaississe et nappe la cuillère. Laissez refroidir complètement avant de placer au frais pour la nuit."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Le lendemain, mixez la crème au mixer à bras en prenant soin d'incorporer le plus d'air possible, ainsi la crème glacée sera plus onctueuse et moins dure à la sortie du congélateur. Versez la crème dans la sorbetière et turbinez pendant 15 minutes en incorporant la poudre pralinée à la fin du turbinage."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Versez la crème glacée dans une boite hermétique et réservez au congélateur."
                }
              }
            }
          ]
        }
      ]
