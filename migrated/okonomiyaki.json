          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Mélanger la farine, la levure chimique, le sel, les œufs entiers et le dashi. Les grumeaux sont ok."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Assaisonnez votre chou vert avec du sel et pressez-le pour en extraire l'eau."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Pochez vos crevettes dans un peu de dashi. Refroidir et couper en petits morceaux"
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Mélanger le chou, les crevettes, le gingembre mariné, l'agedama et les blancs d'oignon dans la pâte."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Pour faire cuire la crêpe, démarrez une poêle antiadhésive avec un aérosol de cuisson à feu moyen."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Ajouter de fines lanières de poitrine de porc ou bacon."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Retourner la crêpe et badigeonner de sauce okonomiyaki. Attendre que le bacon soit bien cuit."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Retourner à nouveau la crêpe et badigeonner l'autre côté de sauce."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Okonomiyaki",
                  "paragraph": "Une fois la crêpe cuite, terminer avec un dernier filet de sauce okonomiyaki, avec des flocons de bonite, de la mayonnaise, des oignons verts émincés et du nori."
                }
              }
            }
          ]
        }
      ]
