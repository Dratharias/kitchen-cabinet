          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Malabar Paratha",
                  "paragraph": "Mettez la farine, le sel et le sucre dans un grand bol et mélangez pour combiner. Faites un puits au centre."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Malabar Paratha",
                  "paragraph": "Dans un pichet, mélangez le lait, 190ml d'eau et l'huile. Versez dans le puits de la farine et incorporez progressivement la farine avec un couteau à lame ronde, puis pétrissez avec vos mains jusqu'à obtenir une pâte lisse et élastique. Versez une goutte d'huile dans votre main, puis huilez légèrement la surface de la pâte. Couvrez légèrement avec du film plastique et laissez reposer à température ambiante pendant 1 heure."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Malabar Paratha",
                  "paragraph": "Divisez la pâte en morceaux de 70g, roulez-les en boules sur une surface légèrement farinée et façonnez les parathas (comme montré ci-après). Laissez reposer les disques de pâte pendant 15 minutes avant de les cuire. La première boule de pâte sera probablement prête à cuire lorsque vous aurez fini de rouler la dernière."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Malabar Paratha",
                  "paragraph": "Pour cuire les parathas, chauffez une grande poêle antiadhésive à feu vif et gardez le beurre fondu et un pinceau à portée de main."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Malabar Paratha",
                  "paragraph": "Placez un paratha dans la poêle et appuyez pour aplatir. La pâte devrait grésiller légèrement en touchant la poêle, et après 30 à 45 secondes, vous devriez voir de l'air commencer à la gonfler. Retournez la pâte et répétez le processus, en la regardant gonfler un peu plus."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Malabar Paratha",
                  "paragraph": "Dès que le deuxième côté a gonflé et que vous ne voyez plus de pâte crue, badigeonnez la surface de beurre fondu, retournez-la et badigeonnez l'autre côté. Transférez sur une assiette chaude et servez immédiatement."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "Étalez une boule de pâte aussi finement que possible pour obtenir un rectangle approximatif de 20 x 14cm."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "Badigeonnez toute la surface de la pâte finement étalée avec de l'huile."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "Saupoudrez très légèrement la surface de la pâte avec de la farine simple."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "En commençant d'un côté, pliez la feuille de pâte en accordéon, en faisant des plis de 1 à 2cm."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "Continuez à plier en accordéon jusqu'à obtenir une bande de 20cm de long avec de nombreuses couches."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "En commençant par une extrémité de la bande, enroulez la pâte pour former un disque."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "Placez la seconde extrémité de la bande au centre du disque et posez ce côté vers le bas pour cacher l'extrémité. Pressez légèrement le disque pour l'aplatir avec des doigts huilés."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Manipulations",
                  "paragraph": "Répétez le roulage et le façonnage avec les autres boules de pâte pour former le reste des parathas."
                }
              }
            }
          ]
        }
      ]
