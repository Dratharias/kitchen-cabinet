          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Chauffez une poêle sèche à feu moyen. Ajoutez la moitié des graines de sésame blanc et faites-les griller, en remuant de temps en temps, jusqu'à ce qu'elles soient parfumées et dorées, environ 2 à 4 minutes. Transférez les graines de sésame dans un bol pour refroidir."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Écrasez grossièrement les grains de poivre rose et vert dans un moulin à épices et ajoutez-les aux graines de sésame. Ajoutez les graines de sésame non grillées et les autres ingrédients et mélangez."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Transférez dans un grand bocal, couvrez et conservez à l'abri de la chaleur et de la lumière. Le blast se conservera plusieurs semaines."
                }
              }
            }
          ]
