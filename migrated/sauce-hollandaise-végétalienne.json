          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans un pichet doseur, ajoutez le lait de soja, le vinaigre, l'assaisonnement et la moutarde. À l'aide d'un mixeur plongeant/mixeur électrique, mélanger jusqu'à ce que le tout soit bien mélangé."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Tout en mélangeant, ajoutez lentement l'huile jusqu'à ce que la sauce commence à épaissir. Une fois que vous avez ajouté toute l'huile, elle doit être épaisse et crémeuse, mais toujours versable. Si votre sauce est trop épaisse, ajoutez quelques cuillères à soupe supplémentaires de lait de soja. Vérifiez l'assaisonnement."
                }
              }
            }
          ]
