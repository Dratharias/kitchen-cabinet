          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 400°F. Tapisser deux plaques à biscuits de papier parchemin."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol, mélanger la farine, le bicarbonate et le sel. Réserver."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Dans un autre bol, crémer le beurre et la cassonade au batteur électrique. Ajouter l'oeuf et fouetter jusqu'à ce que le mélange soit lisse et homogène. Incorporer les ingrédients secs, les noix et le chocolat"
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Former des boules de 30 ml de mélange de pâte pour biscuits. Mettre 8 biscuits par plaques."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Cuire au four, une plaque à la fois, environ 7 minutes ou jusqu'à ce qu'ils commencent à dorer légèrement autour. Les biscuits seront encore très mou au centre. Laisser refroidir complètement."
                }
              }
            }
          ]
        }
