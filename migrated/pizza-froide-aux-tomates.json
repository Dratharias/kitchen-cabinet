          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Mélanger légèrement dans un bol avec un peu d'eau chaude et une cuil. à soupe de sucre avec la levure instantanée. Laisser reposer pendant 5 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Mélanger la farine, l'huile, le sel, le sucre. Ajouter la levure."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Pétrir la pâte jusqu'à ce qu'elle soit lisse et élastique en ajustant la densité avec l'eau supplémentaire, environ 8 à 10 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Mettre la pâte dans un grand bol huilé, couvrir d'un linge humide et laisser monter dans un endroit chaud pendant 1h30. Préparer la sauce."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Dans une grande plaque de cuisson couverte de papier parchemin, applatir la pâte avec les doigts jusqu'à ce qu'elle forme un large rectangle."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "En utilisant une fourchette, piquer la pâte sur toute sa surface, couvrir de papier plastique et laisser reposer un autre 30 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Préchauffer le four à 500°F."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Lorsque la pâte a reposé et le four chauffer, retirer le plastique, baisser la température du four à 425°F."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Saupoudrer la pâte de fromage parmesan et gros sel, puis enfourner pour 15 minutes. Laisser tempérer quelques minutes."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Mettre la sauce sur la pâte et enfourner de nouveau pour un dernier 10 minutes. Attendre un peu avant de servir ou manger froid."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Préchauffer le four à 350°F."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Mettre les tomates et le poivron saupoudrées de sel, poivre et huile d'olive. Rotir au four 45 minutes."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Combiner les ingrédients dans une casserole et laisser mijoter 30 minutes."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Lorsque les légumes sont rotis, retirer leur peau."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Pulser le tout avec un mélangeur et laisser mijoter jusqu'à une consistence épaisse. Réserver."
                }
              }
            }
          ]
        }
      ]
    }
