          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "La journée d'avant, frotter la viande avec de l'oignon en poudre, de l'ail en poudre, du paprika fumé et badigeonner de la moutarde de dijon."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Faites chauffer votre four à 300°F."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Pendant que le four chauffe, épluchez et hachez grossièrement l'oignon. Ensuite, épluchez et écrasez l'ail dans un presse-ail ou hachée."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Placez une poêle à feu moyen jusqu'à ce qu'elle soit chaude, puis ajoutez l'huile d'olive, l'oignon et l'ail. Frire pendant 4 à 5 minutes ou jusqu'à ce que l'oignon ait ramolli."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Ajouter le piment (le cas échéant), poivron, les graines de fenouil et la cassonade et cuire, en remuant, encore 1 à 2 minutes jusqu'à ce que le sucre ait fondu."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Ajouter le ketchup et la sauce soja et mélanger le tout. Porter à ébullition, puis réduire le feu et laisser mijoter 10 minutes, jusqu'à ce que la sauce épaississe."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Mettez les côtes levées dans un plat à rôtir profond, ou une mijoteuse, et versez la sauce."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Couvrez la plaque de papier d'aluminium, mettre le couvercle le cas échéant, et mettez-la au four à couvert pendant 4 à 6 heures, puis augmentez la température du four à 350°F, retirez le papier d'aluminium et laissez cuire encore 30 à 45 minutes. Surveiller pour que ça ne brûle pas."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Côtes Levées Collantes",
                  "paragraph": "Une fois cuites, retirez la plaque du four et laissez les côtes refroidir afin qu'elles ne soient pas trop chaudes à manipuler avant de servir."
                }
              }
            }
          ]
        }
      ]
