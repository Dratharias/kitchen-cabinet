          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une casserole, faire colorer l'oignon dans l'huile d'olive."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les framboises et les écraser."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Déglacer avec le vinaigre balsamique et ajouter la demi-glace de viande."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Laisser cuire à feu doux 5 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Assaisonner et ajouter une noix de beurre ou un trait de crème au moment de servir."
                }
              }
            }
          ]
