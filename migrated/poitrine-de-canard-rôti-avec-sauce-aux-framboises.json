              "ingredient_units": []
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 400°F."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "À l'aide d'un couteau, parer les poitrines de canard en retirant les tissus conjonctifs et l'excédent de gras, puis quadriller le gras sans entailler la chair. Assaisonner généreusement de sel et poivre."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Dans une poêle antiadhésive froide, à feu doux, poêler les poitrines côté gras. Ça peut prendre jusqu'à 10 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Dégraisser la poêle, colorer le côté gras à feu vif pendant quelques minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Sur une plaque allant au four, déposer les magrets côté chair sur la plaque et poursuivre la cuisson au four pendant 7 à 10 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Au terme de la cuisson, retirer le canard du four, les envelopper de papier d'aluminium et les laisser reposer quelques minutes avant de les trancher."
                }
              }
            }
          ]
        },
