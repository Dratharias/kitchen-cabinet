          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Préparation De La Farce De Porc",
                  "paragraph": "Hachez finement les carottes, les champignons shiitake, l'oignon, l'ail et la ciboule."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Préparation De La Farce De Porc",
                  "paragraph": "Dans une poêle, faites revenir le porc haché jusqu'à ce qu'il soit bien cuit."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Préparation De La Farce De Porc",
                  "paragraph": "Ajoutez les légumes hachés dans la poêle avec le porc et faites-les sauter jusqu'à ce qu'ils soient tendres."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Préparation De La Farce De Porc",
                  "paragraph": "Assaisonnez avec la sauce soja légère, la sauce d'huître, la sauce soja, le sucre et le poivre blanc. Mélangez bien. Laissez refroidir."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte De Riz",
                  "paragraph": "Dans un bol, mélangez la farine de riz gluant avec de l'eau jusqu'à obtenir une pâte homogène."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte De Riz",
                  "paragraph": "Formez de petites boules avec la pâte et aplatissez-les pour créer des disques."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte De Riz",
                  "paragraph": "Assemblage des boulettes de riz :"
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte De Riz",
                  "paragraph": "Prenez un disque de pâte de riz, ajoutez une cuillerée de farce au centre, puis refermez la pâte autour de la farce, en formant une boulette. Répétez jusqu'à épuisement de la farce."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte De Riz",
                  "paragraph": "Répétez l'opération jusqu'à ce que toutes les boulettes de riz soient formées."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Cuisson Des Boulettes De Riz",
                  "paragraph": "Portez une casserole d'eau à ébullition."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Cuisson Des Boulettes De Riz",
                  "paragraph": "Plongez les boulettes de riz dans l'eau bouillante. Lorsqu'elles remontent à la surface, laissez-les cuire encore quelques minutes jusqu'à ce qu'elles soient bien cuites. Retirez-les de l'eau et égouttez-les."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Préparation Du Bouillon",
                  "paragraph": "Dans une marmite, faites chauffer de l'eau et ajoutez le bouillon de porc concentré. Laissez mijoter."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Préparation Du Bouillon",
                  "paragraph": "Ajoutez les légumes de votre choix, tels que le chou chinois, le bok choy et les champignons shiitake, et laissez cuire jusqu'à ce qu'ils soient tendres."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Service",
                  "paragraph": "Disposez les boulettes de riz cuites dans des bols."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Service",
                  "paragraph": "Versez le bouillon chaud avec les légumes sur les boulettes de riz."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Service",
                  "paragraph": "Servez la soupe aux boulettes de riz salées immédiatement, et régalez-vous !"
                }
              }
            }
          ]
        }
      ]
