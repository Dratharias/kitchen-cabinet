          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 350 degrés et remplir un moule à muffins avec des caissettes en papier ou en silicone (ou bien graisser avec un aérosol de cuisson)."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol moyen, fouetter ensemble la farine, le sucre, les épices, le bicarbonate de soude, la poudre à pâte et le sel."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Dans un grand bol, mélanger l'huile, la cassonade, les œufs et la vanille et bien mélanger. Incorporer les carottes râpées."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Incorporer les ingrédients secs aux ingrédients humides jusqu'à ce qu'ils soient complètement incorporés."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Remplir les moules à muffins."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Cuire au four préchauffé pendant 20 à 22 minutes jusqu'à ce qu'un cure-dent inséré au centre des muffins en ressorte propre."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Laisser refroidir 5 minutes avant de transférer sur une grille de refroidissement pour poursuivre le refroidissement."
                }
              }
            }
          ]
        }
