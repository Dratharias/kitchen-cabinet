          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Tamisez la farine, le sucre glace, le sel et la cannelle dans un grand bol à mélanger."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Frottez la margarine dans le mélange de farine avec vos mains jusqu'à ce que le mélange ressemble à une consistance semblable à de la chapelure."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Versez suffisamment d'eau pour former une boule de pâte et récupérez tous les morceaux du bol."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Pétrissez légèrement pendant 2 minutes et c'est tout."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Placez la pâte au réfrigérateur pendant au moins une heure."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Pendant que la pâte refroidit, dans une grande casserole, ajoutez le sucre en poudre et faites chauffer à feu moyen jusqu'à ce qu'elle commence à fondre."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Ajoutez les pommes puis le reste des ingrédients sauf les mûres. Laissez cuire le mélange de pommes pendant 4 à 5 minutes."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Retirez les pommes du feu et réservez."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Divisez la pâte en deux, puis roulez une moitié en un grand carré d'environ 3 mm d'épaisseur. Placez la pâte dans votre plat à tarte et coupez le pourtour."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Ajouter le mélange de pommes dans le plat et garnir de mûres."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Etalez à nouveau la 2ème moitié de la pâte sur 3 mm d'épaisseur puis coupez-la en bandes. Vous pouvez faire preuve de créativité et tresser quelques bandes."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Étalez les bandes de pâte sur la tarte afin qu'elles s'entrelacent pour former un effet de treillis."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Saupoudrez de sucre supplémentaire puis remettez dans un four préchauffé réglé à 180 degrés C pendant 25 minutes."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Tarte Aux Pommes Et Aux Mûres",
                  "paragraph": "Laissez refroidir légèrement avant de servir."
                }
              }
            }
          ]
        }
