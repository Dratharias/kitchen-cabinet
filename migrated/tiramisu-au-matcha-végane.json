          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche D Éponge",
                  "paragraph": "Dans un bol à matcha, utilisez un fouet en bambou ou un fouet à matcha pour mélanger l'eau chaude et la poudre de matcha jusqu'à ce qu'elle soit lisse et mousseuse. Vous pouvez également utiliser un mousseur à lait électrique ou un petit fouet pour mélanger l'eau chaude et la poudre de matcha."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche D Éponge",
                  "paragraph": "150 ml d'eau chaude, 1,5 cuil. à thé de poudre de matcha"
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche D Éponge",
                  "paragraph": "Transférez le thé matcha préparé dans un bol large et fouettez-y le sucre en poudre et le sake jusqu'à ce qu'il ne reste plus de grains de sucre."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche D Éponge",
                  "paragraph": "5 cuil. à soupe de sucre en poudre, 4 cuil. à soupe de sake"
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche D Éponge",
                  "paragraph": "Un par un, trempez chaque doigt d'éponge savoiardi dans le mélange de matcha et laissez-le tremper pendant 1 à 2 minutes. Retournez-le et trempez-le à nouveau avant de le placer sur une plaque de cuisson ou une assiette séparée."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche D Éponge",
                  "paragraph": "12 doigts d'éponge savoiardi végétaliens"
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche De Crème",
                  "paragraph": "Placez tous les ingrédients de la couche de crème dans le récipient d'un mixeur haute vitesse et mélangez jusqu'à obtenir une consistance lisse. Si le mélange semble s'être séparé ou s'il n'est pas tout à fait lisse, mettez le couvercle sur le récipient du mixeur et placez-le dans un bol d'eau bouillante pendant 5 à 10 minutes avant de mélanger à nouveau."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche De Crème",
                  "paragraph": "170 g de beurre végétalien, 350 g de tofu soyeux ferme, 120 g de yaourt de soja, 120 g de sucre en poudre, 1 cuil. à thé d'extrait de vanille"
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche De Crème",
                  "paragraph": "Versez un tiers du mélange de crème dans un plat profond de 21x15 cm. Recouvrez de six doigts d'éponge savoiardi trempés. Ajoutez un autre tiers du mélange de crème, suivi d'une autre couche de six doigts d'éponge savoiardi trempés. Terminez par le dernier tiers du mélange de crème et secouez légèrement le plat pour lisser la dernière couche de crème et combler les fissures entre les doigts d'éponge."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche De Crème",
                  "paragraph": "Couvrez avec un couvercle ou un film plastique (en vous assurant qu'il ne touche pas la surface de la crème) et placez au réfrigérateur pendant au moins 6 heures ou de préférence toute la nuit."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Pour Préparer La Couche De Crème",
                  "paragraph": "Juste avant de servir, saupoudrez du reste de matcha, puis découpez et dégustez."
                }
              }
            }
          ]
        }
