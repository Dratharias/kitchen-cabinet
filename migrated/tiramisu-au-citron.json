          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Crème De Citron",
                  "paragraph": "Mettre tous les ingrédients dans une casserole et cuire à feu moyen-doux en remuant constamment."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Crème De Citron",
                  "paragraph": "Une fois que le beurre est fondu, la consistance du mélange sera fine, ne pas augmenter la chaleur. Continuer à remuer jusqu'à ce que le mélange épaississe pendant environ 5 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Crème De Citron",
                  "paragraph": "Lorsque le mélange épaissit, le passer au tamis à mailles fines placé au-dessus d'un bol et filtrer le mélange de tous les grumeaux inutiles. Cela vous donnera une crème de citron parfaite et lisse."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Crème De Citron",
                  "paragraph": "Couvrir le bol hermétiquement avec du film plastique et laisser refroidir le mélange pendant environ 20 à 30 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Mascarpone Au Citron",
                  "paragraph": "Dans un grand bol, ajouter la crème épaisse, l'extrait de vanille, le zeste de citron, la crème de citron, le jus de citron et le sucre, et mélanger avec un batteur électrique jusqu'à ce que le tout soit bien mélangé et que des pics moyens se forment."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Mascarpone Au Citron",
                  "paragraph": "Ajouter le fromage mascarpone et le mélanger à basse vitesse jusqu'à ce que le mélange soit lisse."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": "Tremper rapidement les biscuits à la cuillère dans le sirop de citron et les disposer en une couche uniforme dans le plat de cuisson de 11 pouces."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": "Garnir les biscuits trempés de la moitié du mélange mascarpone et l'étaler avec une spatule."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": "Verser 4 cuillères à soupe de crème de citron par-dessus et lisser avec une cuillère."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": "Ajouter une autre couche de biscuits trempés et la recouvrir du reste du mélange mascarpone. Lisser avec une spatule coudée."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": "Couvrir le plat hermétiquement avec du film plastique et réfrigérer pendant au moins 4 heures."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": "Garnir le tiramisu de crème de citron et lisser avec une spatule."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Montage",
                  "paragraph": ""
                }
              }
            }
          ]
        }
