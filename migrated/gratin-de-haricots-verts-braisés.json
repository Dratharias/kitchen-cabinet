          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Faire revenir l'oignon, l'ail (en réservant 1 gousse) pendant 5 minutes dans une grande casserole avant d'ajouter les tomates, l'origan, le sel, le poivre et un peu d'eau. Laissez bouillonner la sauce 15 minutes à feu doux."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Pendant ce temps, placez une grande poêle ou une poêle en fonte sur feu vif et ajoutez un peu d'huile, une branche de romarin et la gousse d'ail réservée. Faites cuire le romarin et l'ail jusqu'à ce qu'ils soient dorés, puis retirez-les de la poêle. Ajoutez les haricots et faites sauter pendant 10 minutes en assaisonnant avec un peu de sel. Essayez de carboniser un peu les haricots."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Une fois les haricots cuits, mélangez-les à la sauce tomate. Baissez ensuite le feu et poursuivez la cuisson du mélange pendant 15 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Pendant ce temps préchauffez votre four à 200°C et préparez vos garnitures. Coupez enfin votre courgette, votre pomme de terre et votre tomate."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Transférer le mélange de haricots dans un plat allant au four et garnir de morceaux alternés de courgette, de pomme de terre et de tomate."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Arrosez d'un peu d'huile et d'une pincée d'assaisonnement, puis faites cuire les haricots pendant 20 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Gratin De Haricots Verts Braisés",
                  "paragraph": "Lorsque la belle garniture est caramélisée et dorée, servez-la avec quelques légumes verts."
                }
              }
            }
          ]
        }
