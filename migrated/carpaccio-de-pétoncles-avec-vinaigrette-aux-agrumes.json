          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une casserole, réduisez sans ébullition le jus d'agrumes à 80 ml (1/3 de tasse). Laissez refroidir."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez la moutarde, le gingembre, le sel, le piment d'Espelette et à l'aide du mélangeur à main, émulsionnez le tout."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Montez progressivement à l'huile d'olive en filet. Réservez en pipette au réfrigérateur."
                }
              }
            }
