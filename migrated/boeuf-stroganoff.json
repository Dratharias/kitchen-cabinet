          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Boeuf Stroganoff",
                  "paragraph": "Dans un bol, fariner la viande."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Boeuf Stroganoff",
                  "paragraph": "Dans une grande poêle à feu vif, dorer la viande, une petite quantité à la fois, dans l'huile. Saler et poivrer. Transvider la viande dans la mijoteuse au fur et à mesure."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Boeuf Stroganoff",
                  "paragraph": "Dans la même poêle, dorer les oignons et les champignons dans le beurre. Saler et poivrer. Ajouter l'ail et poursuivre la cuisson une minute."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Boeuf Stroganoff",
                  "paragraph": "Déglacer avec le vin et transvider dans la mijoteuse. Ajouter le reste des ingrédients et mélanger."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Boeuf Stroganoff",
                  "paragraph": "Cuire à Low pendant 6 heures."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Boeuf Stroganoff",
                  "paragraph": "Servir sur des nouilles aux oeufs et garnir."
                }
              }
            }
          ]
