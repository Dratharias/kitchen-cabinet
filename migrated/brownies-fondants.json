          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 350°F."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Hacher la moitié du chocolat et fondre le reste en intervales de 20 secondes au micro-ondes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Dans un large bol, mélanger le beurre et le sucre au mélangeur à main, puis battre les oeufs et la vanille pour 1-2 minutes, jusqu'à ce que la mixture deviennes légère et pâle."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Fouetter le chocolat fondu dans le mélange liquide, puis incorporer en pliant à l'aide d'une spatule la farine et la poudre de cacao tamisée, puis un peu de sel en faisant attention à ne pas surmélanger pour qu'ils restent plus aériens."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter en pliant le mélange les morceaux de chocolat et transférer dans un plat de cuisson couvert d'un papier parchemin."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Cuire de 30 à 35 minutes pour 1 pouce d'épaisseur, dépendant d'à quel point vous le voulez fondant et laissez refroidir complètement (il doit figer). Ça peut prendre quelques heures s'il est très fondant."
                }
              }
            }
          ]
        }
      ]
