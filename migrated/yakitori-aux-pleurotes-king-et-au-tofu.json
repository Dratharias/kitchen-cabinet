          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Yakitori Aux Pleurotes King Et Au Tofu",
                  "paragraph": "Préchauffez votre four à 350°F/180°C."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Sauté",
                  "paragraph": "Faire frire une dizaine de minutes dans une poêle très chaude avec un peu d'huile, ou dans un air fryer à 400°F. En même temps, dans une poêle très chaude, dorer les champignons."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Yakitori",
                  "paragraph": "Placez les champignons et le tofu sur vos brochettes et réservez."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Teriyaki",
                  "paragraph": "Pendant ce temps, à l'exception de la fécule, ajoutez tous les ingrédients de la sauce dans une casserole et placez sur feu moyen, portez le liquide à ébullition. Laisser mijoter 5 minutes avant d'incorporer le mélange de fécule de maïs."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Teriyaki",
                  "paragraph": "Le liquide doit s'épaissir pour former un joli glaçage semblable à la consistance. S'il devient trop épais, ajoutez un peu d'eau, et s'il est trop liquide, ajoutez un peu plus de mélange fécule de maïs/eau ou laissez-le simplement réduire."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Cuisson",
                  "paragraph": "Badigeonner le tofu et les champignons avec 1/4 de tasse de la sauce."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Cuisson",
                  "paragraph": "Faites griller le tout dans une poêle bien chaude ou sur votre barbecue. Cuire 4 à 5 minutes de chaque côté avant de placer les brochettes ou le sauté sur une plaque à pâtisserie, ajouter de la sauce au goût (suggestion: 1 tasse) et de les mettre au four pendant 15 à 20 minutes."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Salade De Concombre Mariné",
                  "paragraph": "Pendant ce temps, mélangez les ingrédients de la salade dans un petit bol à mélanger."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Servir",
                  "paragraph": "Lorsque les brochettes sont cuites, servir avec des nouilles, de la salade et garnir de noix et d'herbes fraîches."
                }
              }
            }
          ]
        }
      ]
    }
