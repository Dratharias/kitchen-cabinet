          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Placez le ketchup, le vinaigre, le sucre, la mélasse, la moutarde, le cumin, le poivre de Cayenne et les graines de céleri dans une grande casserole non réactive. Remuez et portez progressivement à ébullition à feu moyen-élevé."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Réduisez le feu et laissez mijoter doucement la sauce, à découvert, jusqu'à ce qu'elle soit épaisse, concentrée et riche en saveur, en remuant souvent pour éviter qu'elle ne brûle, 15 à 20 minutes. Transférez dans des bocaux propres pour servir. Couvert et réfrigéré, la sauce se conservera plusieurs semaines."
                }
              }
            }
          ]
