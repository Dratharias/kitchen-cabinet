          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Poulet Tikka",
                  "paragraph": "Coupez chaque cuisse de poulet en 3 morceaux et épongez-les avec du papier de cuisine. Placez-les dans un grand bol."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Poulet Tikka",
                  "paragraph": "Pour la marinade, mixez les ingrédients ensemble dans un blender ou un mini robot culinaire jusqu'à obtenir une pâte lisse."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Poulet Tikka",
                  "paragraph": "Versez la marinade sur les morceaux de poulet et retournez-les pour les enrober. Couvrez et laissez mariner au réfrigérateur pendant 6 à 24 heures."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Poulet Tikka",
                  "paragraph": "Sortez le poulet mariné du réfrigérateur 20 minutes avant de le cuire. (Si vous utilisez des brochettes en bois, faites-les tremper maintenant.)"
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Poulet Tikka",
                  "paragraph": "Préchauffez le grill à feu vif. Enfilez les morceaux de poulet marinés sur des brochettes, en laissant suffisamment d'espace entre les morceaux pour que la chaleur puisse pénétrer. Faites griller pendant 12 à 15 minutes, en retournant et en badigeonnant régulièrement avec le beurre fondu, jusqu'à ce qu'ils soient bien dorés avec quelques traces de carbonisation. Vérifiez que les morceaux de poulet sont bien cuits."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Poulet Tikka",
                  "paragraph": "Laissez reposer le poulet cuit pendant 5 minutes avant de servir, avec des quartiers de lime à presser."
                }
              }
            }
          ]
        }
