              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Mélangez le beurre de cacahuète, si le beurre de cacahuète est grumeleux, chauffez-le encore 30 secondes au micro-ondes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Incorporez les Rice Krispies et les flocons d'avoine."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Répartissez dans le moule à muffins."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Mettez au réfrigérateur pendant 1 heure."
