          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Gadbad Mithai",
                  "paragraph": "Coupez le gâteau en cubes d'environ 2cm et placez quelques morceaux dans chacun des 6 verres à sundae ou bols de service en verre."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Gadbad Mithai",
                  "paragraph": "Mélangez la crème anglaise avec le lait pour l'assouplir un peu."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Gadbad Mithai",
                  "paragraph": "Préparez les fruits choisis et coupez les plus gros en morceaux de la taille d'une bouchée. Répartissez-les entre les verres ou bols."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Gadbad Mithai",
                  "paragraph": "Versez un peu de purée de mangue sur chaque portion, puis ajoutez un filet de crème. Ajoutez une généreuse quantité de crème anglaise par-dessus."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Gadbad Mithai",
                  "paragraph": "Terminez avec une boule de glace et servez immédiatement."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Note",
                  "paragraph": "Vous pouvez acheter de la purée de mangue en conserve de bonne qualité dans les épiceries indiennes."
                }
              }
            }
          ]
        }
