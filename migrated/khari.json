          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Khari",
                  "paragraph": "Sortez la pâte du réfrigérateur, retirez tout emballage et laissez reposer environ 20 minutes pour qu'elle atteigne la température ambiante."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Khari",
                  "paragraph": "Préchauffez le four à 410°F/Fan 375°F/Gaz 6–7 et tapissez deux grandes plaques à pâtisserie de papier sulfurisé."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Khari",
                  "paragraph": "Déroulez la pâte et coupez-la en deux pour créer deux bandes longues, d'environ 11.5cm de large. Taillez pour uniformiser, si nécessaire."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Khari",
                  "paragraph": "Coupez chaque morceau de pâte en bandes, d'environ 11 x 2.5cm, en les laissant où elles sont au fur et à mesure (un coupe-pizza fariné est idéal pour cela). Badigeonnez la pâte de blanc d'œuf et saupoudrez les épices masala et le sel, en vous assurant d'obtenir une couverture uniforme avec chaque ingrédient."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Khari",
                  "paragraph": "Pressez légèrement les épices masala avec vos doigts, puis transférez les rectangles de pâte sur les plaques à pâtisserie, en laissant environ 2cm entre chacun. Faites cuire au four pendant 15 à 18 minutes, ou jusqu'à ce que la pâte soit gonflée, dorée et assez croustillante."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Khari",
                  "paragraph": "Laissez refroidir les kharis sur une grille avant de les servir."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Variante",
                  "paragraph": "Khari aux piments: Au lieu de la garniture masala, utilisez 1–1½ cuil. à thé de poudre de piment deggi mirch et 1–1½ cuil. à thé de sel de mer en flocons."
                }
              }
            }
          ]
        }
      ]
