          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Hachis Brouillé Au Tofu Fumé",
                  "paragraph": "Faire revenir l'oignon et le jalapeño dans une poêle antiadhésive placée à feu moyen avec l'huile d'olive jusqu'à ce qu'ils soient dorés. Émietter le tofu, puis ajouter la pomme de terre et les haricots noirs. Après quelques minutes supplémentaires, lorsque le tofu est légèrement coloré, ajoutez le paprika, le curcuma et le sel marin."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Hachis Brouillé Au Tofu Fumé",
                  "paragraph": "Déglacez la poêle avec le lait végétal puis laissez-la bouillonner avec le couvercle pendant encore 2-3 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Hachis Brouillé Au Tofu Fumé",
                  "paragraph": "Pendant ce temps, faites griller votre pain et vos tomates."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Hachis Brouillé Au Tofu Fumé",
                  "paragraph": "Servir le brouillage avec du houmous, des graines, des herbes fraîches et un peu d'huile de piment avec le pain grillé et les tomates cerises en accompagnement."
                }
              }
            }
          ]
        }
      ]
