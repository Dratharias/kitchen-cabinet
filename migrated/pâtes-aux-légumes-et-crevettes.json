          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Crevettes",
                  "paragraph": "Faire dorer les crevettes dans le beurre. Réserver."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Crevettes",
                  "paragraph": "Ajouter les tomates et l'oignon. Faire mijoter jusqu'à l'obtention d'un bouillon."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Crevettes",
                  "paragraph": "Ajouter le lait et laissez réduire de moitié."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Crevettes",
                  "paragraph": "Ajouter le sel, poivre, basilic et persil. Laissez mijoter 10 minutes et retirer du feu."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Sauté De Légumes",
                  "paragraph": "Faire sauter les légumes dur dans une casserole avec du beurre, environ 7 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Sauté De Légumes",
                  "paragraph": "Ajouter les légumes mou à mi-cuisson et l'ail, et poursuivre la cuisson jusqu'à ce qu'ils soient tendre."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Sauté De Légumes",
                  "paragraph": "Saler et poivrer, ajouter l'origan. Retirer du feu."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Pâtes",
                  "paragraph": "Incorporer les pâtes au sauté de légumes. Ajouter la sauce et les crevettes."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Pâtes",
                  "paragraph": "Réchauffer le tout et servir avec du parmesan."
                }
              }
            }
          ]
        }
