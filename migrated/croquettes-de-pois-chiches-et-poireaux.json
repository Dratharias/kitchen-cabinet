          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Prenez un grand bol à mélanger et ajoutez les pois chiches, le sel, le persil et le citron. A l'aide d'un presse-purée ou d'une fourchette, écrasez légèrement les pois chiches."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "A côté du bol ajouter le reste des ingrédients (sauf le poireau) & bien mélanger à la spatule."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Placez une grande poêle antiadhésive sur feu moyen et ajoutez un peu d'huile d'olive. Lorsque la poêle est chaude, versez quelques cuillères à soupe de pâte dans la poêle et, à l'aide du dos de la cuillère, formez un cercle grossier avec la pâte. J'ai tendance à faire frire 3 beignets à la fois."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Faites frire chaque beignet pendant 3 à 4 minutes de chaque côté. Avant de retourner, je dépose quelques morceaux de poireau sur chaque beignet. Les poireaux caramélisent bien, mais c'est surtout pour leur donner un petit côté fantaisie."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Pendant la cuisson, les beignets doivent gonfler et doubler plus ou moins d'épaisseur."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Une fois frits et les beignets dorés, retirez-les de la poêle et poursuivez la cuisson jusqu'à épuisement de la pâte."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Alternativement, si vous ne voulez pas manger autant de beignets tout de suite, vous pouvez conserver la pâte dans un récipient hermétique jusqu'à 2 jours dans votre réfrigérateur."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Croquettes De Pois Chiches Et Poireaux",
                  "paragraph": "Je recommande de servir les beignets avec de la salade et une trempette."
                }
              }
            }
          ]
        }
      ]
