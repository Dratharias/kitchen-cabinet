          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Crevettes Tandoori",
                  "paragraph": "Placez les crevettes dans un plat de cuisson en verre et versez la marinade dessus. Couvrez avec du film plastique et laissez mariner pendant 2 à 4 heures au réfrigérateur. Remuez plusieurs fois pour bien enrober."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Crevettes Tandoori",
                  "paragraph": "Préparez un gril pour une cuisson directe et préchauffez-le à feu vif. Brossez et huilez la grille du gril."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Crevettes Tandoori",
                  "paragraph": "Retirez les crevettes de la marinade et enfilez-les sur des brochettes. Placez-les sur la grille et faites griller jusqu'à ce qu'elles soient fermes, roses et bien cuites, environ 2 à 3 minutes de chaque côté, en badigeonnant de beurre fondu."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Crevettes Tandoori",
                  "paragraph": "Transférez les crevettes sur un plat et saupoudrez des tranches d'oignon et des brins de coriandre. Servez avec des quartiers de citron et des bols de raita et des chutneys."
                }
              }
            }
          ]
        }
