          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Mettre les champignons à tremper dans l'eau chaude au moins 1 heure avant de préparer la farce des calmars."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Verser un bon filet d'huile dans une grande poêle en inox et y faire revenir l'oignon avec une pincée de sel, pendant 2 minutes, sans coloration."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajouter l'ail et les pâtissons et poursuivre la cuisson 2 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le riz et bien incorporer."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Égoutter les champignons, les ajouter à la poêlée de légumes et cuire pendant 5 minutes en remuant régulièrement."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Verser le liquide de trempage des champignons, saler et poivrer, porter à doux frémissement, couvrir et cuire jusqu'à ce que le riz soit presque cuit."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Retirer, transférer dans un cul de poule et laisser refroidir complètement."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les graines de fenouil et de coriandre, puis les fanes de fenouil et bien mélanger."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 200°C (400°F)"
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "paragraph": "Farcir les tubes de calmars avec la préparation, sans trop compacter la farce; les tubes vont rétrécir à la cuisson."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "paragraph": "Insérer les tentacules dans le tiers supérieur des tubes (comme un bouchon), puis fixer le tout à l'aide d'un cure-dent."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "paragraph": "Badigeonner le fond d'un plat à four d'huile, y déposer les calmars farcis côte à côte, verser la concassé de tomate tout autour et enfourner le tout pendant 20 minutes. Servir chaud."
                }
              }
            }
          ]
        }
      ]
