          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Sécher le poulet avec du papier absorbant et le placer dans un grand bol."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Mélanger les ingrédients de la première marinade dans un petit bol. Verser sur le poulet et remuer pour enrober. Couvrir et réfrigérer pendant la préparation de la deuxième marinade, idéalement jusqu'à 2 heures."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Mixer le fromage râpé, le yogourt, la crème, l'œuf, le sel et la fécule de maïs au robot culinaire jusqu'à l'obtention d'une pâte lisse. Ajouter les piments hachés et les tiges de coriandre, puis bien mélanger."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Sortir le poulet du réfrigérateur et verser la deuxième marinade dessus. Remuer et couvrir. Remettre au réfrigérateur pour mariner pendant 6 à 24 heures."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Sortir le poulet mariné du réfrigérateur environ 20 minutes avant la cuisson."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Enfiler le poulet sur des brochettes en laissant suffisamment d'espace entre les morceaux pour la cuisson. Griller pendant 12 à 15 minutes, en retournant régulièrement, jusqu'à ce qu'il soit doré foncé et légèrement carbonisé. S'assurer que le poulet est bien cuit."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": "Arroser le poulet cuit de beurre, de kabab masala et de jus de lime, en retournant les brochettes pour enrober le tout. Garnir de feuilles de coriandre et servir avec des quartiers de lime."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Murgh Malai",
                  "paragraph": ""
                }
              }
            }
          ]
        }
