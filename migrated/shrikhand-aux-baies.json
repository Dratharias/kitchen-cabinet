          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Shrikhand Aux Baies",
                  "paragraph": "Placez une passoire sur un bol et tapissez-la de mousseline ou de papier essuie-tout épais. (Utilisez un kit de filtrage de confiture, si vous en avez un.) Versez le yogourt dans le tissu de mousseline, couvrez le dessus lâchement avec du film alimentaire et placez au réfrigérateur pour filtrer pendant 8 heures."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Shrikhand Aux Baies",
                  "paragraph": "Versez le yogourt filtré dans un bol, ajoutez le sucre glace et mélangez bien."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Shrikhand Aux Baies",
                  "paragraph": "Coupez les baies en deux ou en quartiers et incorporez-les délicatement dans le yogourt sucré et filtré pour créer un effet marbré. Couvrez et réfrigérez jusqu'au moment de servir. (Le shrikhand se conserve au moins 3 jours au réfrigérateur.)"
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Shrikhand Aux Baies",
                  "paragraph": "Pour servir, répartissez le shrikhand dans des petits bols ou des verres et garnissez de baies supplémentaires."
                }
              }
            }
          ]
        }
      ]
