          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Dans un bol, mélanger le chou vert râpé avec une pincée de sel et laisser reposer."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Ajouter la courge musquée râpée, les oignons verts tranchés, le poulet haché, l'ail, le gingembre, le poivre blanc, la sauce soja, l'édulcorant et l'huile de sésame. Bien mélanger."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Placer une cuillère à thé de la garniture au centre de chaque enveloppe de dumpling."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Humidifier les bords de l'enveloppe et plier en deux pour former le dumpling. Presser les bords pour bien sceller."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Dans un bol, mélanger l'eau, la fécule de maïs, la farine, l'huile et une pincée de sel."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Chauffer de l'huile dans une poêle à feu moyen."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Faire frire les dumplings avec la croustille liquide dans une poêle et couvrir 3-4 minutes (cuire vapeur), retirer et laisser évaporer jusqu'à ce que la croustille devienne brun ambrée au centre."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Placer une assiète à l'envers sur les dumplings et retourner le contenu de la poêle dans l'assiète."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Dans un bol, mélanger le sambal, le sirop d'érable, le mirin, la sauce soja et le vinaigre de riz."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Dumpling Croustillants D Automne",
                  "paragraph": "Servir les dumplings croustillants avec la croustille sur le dessus et la sauce piquante au soja et à l'érable à côté."
                }
              }
            }
          ]
        }
      ]
    }
