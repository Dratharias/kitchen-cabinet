          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 400 degrés"
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Coupez le dessus des bulbes d'ail. Placer les bulbes, côté coupé vers le haut, dans un morceau de papier d'aluminium assez grand pour se replier et fermer hermétiquement le tout."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Verser 1 cuillère à soupe d'huile d'olive sur chaque bulbe."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Fermez le papier d'aluminium."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Cuire au four pendant 45 à 50 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Laisser refroidir 10 minutes."
                }
              }
            }
          ]
        },
