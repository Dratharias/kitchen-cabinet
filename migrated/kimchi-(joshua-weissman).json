          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Préparation Des Légumes",
                  "paragraph": "Coupez le chou napa en quartiers, puis en bandes d'un pouce."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Préparation Des Légumes",
                  "paragraph": "Placez le chou dans un bol, saupoudrez de sel et massez vigoureusement."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Préparation Des Légumes",
                  "paragraph": "Laissez reposer 30 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Préparation Des Légumes",
                  "paragraph": "Coupez les oignons verts, hachez les carottes et le radis daikon en julienne."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte",
                  "paragraph": "Mixez le gingembre, la poire asiatique, l'ail et la sauce de poisson."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Préparation De La Pâte",
                  "paragraph": "Mélangez la pâte avec les flocons de piment rouge."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Assemblage Et Fermentation",
                  "paragraph": "Rincez le chou et pressez-le pour éliminer l'excès de sel."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Assemblage Et Fermentation",
                  "paragraph": "Mélangez le chou avec les légumes et la pâte."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Assemblage Et Fermentation",
                  "paragraph": "Tassez le mélange dans un bocal en verre."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Assemblage Et Fermentation",
                  "paragraph": "Laissez fermenter 4 à 7 jours à température ambiante, en pressant régulièrement pour éliminer les bulles d'air."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Assemblage Et Fermentation",
                  "paragraph": "Fermez le bocal et conservez au réfrigérateur."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Simplifications",
                  "paragraph": "Vous pouvez utiliser un robot culinaire pour hacher le chou plus rapidement."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Simplifications",
                  "paragraph": "Si vous n'avez pas de poire asiatique, vous pouvez la remplacer par une pomme ou une poire ordinaire."
                }
              }
            }
          ]
        }
      ]
