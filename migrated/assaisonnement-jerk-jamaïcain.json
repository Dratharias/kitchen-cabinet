          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Mélangez les piments, l'oignon, les shallots, la ciboulette, l'ail, le persil, la coriandre, le gingembre, le sel, le thym, le piment de la Jamaïque, le poivre, la cannelle, la muscade et les clous de girofle dans un robot culinaire jusqu'à obtenir une pâte grossière."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez les ingrédients restants, y compris l'eau, une cuillère à soupe à la fois, et mixez jusqu'à obtenir une pâte épaisse mais tartinable."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Utilisez immédiatement ou transférez dans un bocal, couvrez et réfrigérez. L'assaisonnement est meilleur s'il est utilisé dans les quelques heures suivant sa préparation."
                }
              }
            }
          ]
        }
