          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Mettre dans un grand bol les ingrédients secs et une pincée de sel, ajouter et incorporer au mélange avec une fourchette les jaunes d'oeufs."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Ajouter le beurre froid et briser le beurre avec la fourchette (ou les mains) sans faire fondre le beurre jusqu'à ce que le mélange soit semblable à du sable."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Ajouter de l'eau en petites quantités jusqu'à ce que la pâte se forme en restant cassante."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Rouler sous forme de bûche la pâte, emballer hermétiquement et réfrigérer au moins 1 heure."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Lorsque la pâte a fini de refroidir, couper un tier de la bûche et congelé ce morceau."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Huiler un moule à pain avec un aérosol, couvrir de papier parchemin, huiler le papier parchemin."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Rouler la croûte à tarte en large rectangle, jusqu'à environ 3 millimètres d'épaisseur. Mettre dans le moule à pain. Couper les excès de pâte."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Croûte",
                  "paragraph": "Très bien piquer le fond et les côtés de la pâte avec une fourchette sur toute sa surface. Congelé 20 à 30 minutes."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Faire La Garniture",
                  "paragraph": "Éplucher et râper les pommes. Drainer le l'eau de pomme et presser les pommes râpés pour en extraire le maximum de liquide dans un bol. Réserver le liquide."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Faire La Garniture",
                  "paragraph": "Ajouter les épices et le sucre aux pommes râpés et bien mélanger. Ajouter un peu du liquide de pomme pour lié le tout, tout en évitant que le mélange soit trop mouillé."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Faire La Garniture",
                  "paragraph": "Ajouter les épices et le sucre aux pommes râpés et bien mélanger. Ajouter un peu du liquide de pomme pour lié le tout, tout en évitant que le mélange soit trop mouillé. La mixture de pommes et d'épices devrait légèrement couler et se tenir légèrement. Goûter et rectifié l'assaisonnement."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Faire La Meringue",
                  "paragraph": "Briser les blancs d'oeufs au mélangeur jusqu'à ce qu'ils aient une texture crémeuse. En mélangeant, ajouter très doucement le sucre aux blancs d'oeufs."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Faire La Meringue",
                  "paragraph": "Toujours en mélangeant, ajouter très doucement la fécule de maïs à la meringue. Réserver la meringue."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Egg Wash",
                  "paragraph": "Battre le mélange avec une fourchette jusqu'à ce que ce soit combiné."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Préchauffer le four à 400°F."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Mettre toute la garniture dans le moule aussi égale que possible."
                }
              }
            },
            {
              "position": 17,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Ajouter la meringue aussi égale que possible avec un couteau à beurre ou une spatule décalée."
                }
              }
            },
            {
              "position": 18,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Râper le tier de pâte congelé qui à été réserver plus tôt et répartir également sur le dessus de la tarte."
                }
              }
            },
            {
              "position": 19,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Râper le tier de pâte congelé qui à été réserver plus tôt et répartir également sur le dessus de la tarte."
                }
              }
            },
            {
              "position": 20,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Avec un pinceau, répendre « l'egg wash » sur la croûte rapée sur le dessus de la pâte. Saupourer avec du sucre granulé."
                }
              }
            },
            {
              "position": 21,
              "segment": {
                "data": {
                  "title": "Montage De La Tarte",
                  "paragraph": "Cuire pendant environ 45 minutes. Laisser reposer."
                }
              }
            }
          ]
        }
      ]
