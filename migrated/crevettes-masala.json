          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Placer une passoire au-dessus d'un bol et tapisser la passoire de mousseline. Mixer tous les ingrédients de la marinade au robot jusqu'à l'obtention d'une pâte lisse. Verser dans la passoire tapissée de mousseline, couvrir d'un film alimentaire et laisser égoutter au réfrigérateur pendant 6 à 12 heures."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Sécher les crevettes le plus possible avec du papier absorbant et les placer dans un bol."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Chauffer une poêle sèche à feu moyen. Ajouter la farine de pois chiche et griller pendant 2-3 minutes, en la remuant constamment. Elle dégagera un arôme fort lorsqu'elle sera prête. Verser sur une assiette et laisser refroidir."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Sortir la marinade du réfrigérateur et jeter tout liquide accumulé dans le bol."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Ajouter la farine de pois chiche grillée aux crevettes et mélanger, puis ajouter la marinade et bien enrober les crevettes. Couvrir et réfrigérer pendant 2-3 heures."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Au moment de la cuisson, chauffer le grill à feu vif. Tapisser une plaque à pâtisserie de papier d'aluminium et y déposer les crevettes. Badigeonner-les de beurre fondu et griller pendant 3-4 minutes jusqu'à ce qu'elles soient légèrement carbonisées. Ne les retourner pas, sauf si elles sont très grosses."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Crevettes Masala",
                  "paragraph": "Servir les crevettes parsemées de coriandre et accompagnées de quartiers de lime."
                }
              }
            }
          ]
        }
