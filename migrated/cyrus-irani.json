          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Cyrus Irani",
                  "paragraph": "Mesurez le jus de lime, le sirop de curcuma et la tequila dans votre shaker."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Cyrus Irani",
                  "paragraph": "Ajoutez beaucoup de glace et secouez vigoureusement pendant 1 minute."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Cyrus Irani",
                  "paragraph": "Versez à travers une passoire dans un verre à sours ou à sherry, et servez avec un quartier de lime sur le bord du verre."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Mélangez le miel avec l'eau chaude."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Ajoutez le curcuma moulu et le poivre de Cayenne, et mélangez bien pour combiner."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Ajoutez le yogourt grec entier égoutté et mélangez jusqu'à consistance lisse."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Versez dans une petite casserole et placez sur un feu très doux. Chauffez à 176°F et maintenez cette température pendant 2 minutes (vérifiez avec un thermomètre de cuisine); vous devrez peut-être soulever la casserole de la source de chaleur de temps en temps; remuez régulièrement pour éviter que le mélange n'attache."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Ajoutez le jus de lime fraîchement pressé, remuez légèrement juste deux fois, puis retirez du feu. Laissez le mélange reposer et cailler pendant 1 à 2 heures."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Versez le mélange caillé dans une passoire tapissée de mousseline posée sur un bol et laissez égoutter pendant 2 à 3 heures."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Sirop De Curcuma",
                  "paragraph": "Versez le liquide dans une bouteille ou un bocal stérilisé et conservez au réfrigérateur jusqu'à 2 semaines; il s'adoucira en vieillissant. Donne environ 200 ml."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Note",
                  "paragraph": "Les solides de yogourt que vous obtenez lorsque vous filtrez le sirop de curcuma sont fantastiques; utilisez-les pour mariner du poulet, de l'agneau ou du porc, ou ajoutez-les à un curry de tomates et de pois chiches."
                }
              }
            }
          ]
        }
      ]
