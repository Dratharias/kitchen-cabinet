          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Crevettes Koliwada",
                  "paragraph": "Mélanger les farines, les épices et le sel dans un bol."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Crevettes Koliwada",
                  "paragraph": "Ajouter les pâtes de gingembre et d'ail, les feuilles de curry hachées et le jus de lime, puis mélanger jusqu'à obtenir une pâte lisse et épaisse."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Crevettes Koliwada",
                  "paragraph": "Éponger les crevettes aussi bien que possible à l'aide de papier absorbant. Étaler la pâte d'épices sur les crevettes et masser pour s'assurer qu'elles sont uniformément enrobées. Couvrir et laisser mariner au réfrigérateur pendant 6 à 24 heures."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Crevettes Koliwada",
                  "paragraph": "Chauffer l'huile dans une friteuse ou une poêle à fond épais adaptée à la friture à 180°C (350°F). Frire les crevettes, en plusieurs lots si nécessaire, pendant 2 à 3 minutes, jusqu'à ce qu'elles soient dorées et bien cuites à l'intérieur."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Crevettes Koliwada",
                  "paragraph": "Servir avec des quartiers de lime à presser et du chutney de tamarin et/ou de coriandre et menthe pour tremper."
                }
              }
            }
          ]
        }
      ]
