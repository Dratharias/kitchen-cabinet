          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Cuire l'échalotte française dans une cassorole jusqu'à ce qu'elle soit dorée. Réserver la moitié."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le vin, la crème et le vinaigre. Porter à ébullition et cuire à feu très vif quelques minutes, jusqu'à ce que le volume du mélange réduise de moitié, en brassant de temps à autre."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Mettre le tout dans un tamis et presser vigoureusement avec une spatule la partie solide du mélange pour en extraire le maximum de liquide. Jeter la partie solide ainsi essorée et récolter la sauce dans une petite casserole."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Chauffer le tout à feu très doux et ajouter le beurre, un morceau à la fois, en fouettant constamment. Ajouter le jus de citron, en fouettant. Saler et poivrer au goût. Réserver."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Cuire les filets de truite."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Déposer les filets de truite sur des assiettes chaudes, les napper de sauce et servir."
                }
              }
            }
          ]
        }
      ]
