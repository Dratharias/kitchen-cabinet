          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Mettez le beurre et le sucre dans un grand bol et battez jusqu'à ce que le mélange soit léger et mousseux."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Mélangez la farine, le sel, les graines de cumin et la levure chimique ensemble, puis ajoutez-les au mélange de beurre et de sucre. Mélangez pour combiner, en rassemblant doucement la pâte sans trop la travailler. Formez un cylindre d'environ 5 cm de diamètre et enveloppez-le dans du film plastique. Placez-le au réfrigérateur pendant 30 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Préchauffez le four à 400°F (chaleur tournante à 350°F). Tapissez une grande plaque à pâtisserie de papier sulfurisé."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Sortez la pâte du réfrigérateur, coupez-la en disques d'environ 7 à 8 mm d'épaisseur et disposez-les sur la plaque à pâtisserie préparée. Faites cuire au four pendant 15 à 18 minutes, ou jusqu'à ce qu'ils soient dorés et cuits."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Transférez les biscuits sur une grille et laissez-les refroidir. Ils se conserveront dans un conteneur hermétique jusqu'à 2 jours."
                }
              }
            }
          ]
        }
      ]
