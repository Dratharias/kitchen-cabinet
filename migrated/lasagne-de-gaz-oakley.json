          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Tout d'abord, vous devez faire infuser le lait pour la béchamel, dans une casserole moyenne, ajouter le lait de soja/avoine suivi de l'oignon, du laurier, de la muscade et des assaisonnements. Mettez la casserole sur feu doux et remuez de temps en temps."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Pour le ragoût, dans une grande casserole placée sur feu moyen, ajoutez l'huile suivi de l'oignon, de l'ail, du céleri et d'une pincée de sel. Faites suer le mélange pendant environ 3-4 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Ajoutez la courgette, l'aubergine et le mélange d'herbes. Baissez le feu, mettez un couvercle et laissez le mélange cuire pendant 3-4 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Ajoutez le hachis végétalien et remuez bien. Cuire 2-3 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Déglacer la poêle avec le vinaigre balsamique et les tomates concassées."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Incorporez le concentré de tomates, puis ouvrez le couvercle et laissez cuire à feu doux pendant 10 à 15 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Pour la béchamel, dans une casserole ajoutez la margarine vegan et placez la casserole sur feu doux."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Lorsque la margarine est fondue, ajoutez la farine. A l'aide d'une spatule, mélangez bien. Faites cuire le mélange en remuant pendant quelques minutes pour faire cuire la farine. Cela devrait ressembler à une consistance pâteuse."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Incorporez progressivement le lait infusé, petit à petit."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Une fois que vous avez ajouté tout le lait, la béchamel doit être crémeuse, si vous voulez la rendre ringarde, ajoutez du fromage végétalien et de la levure nutritionnelle."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Préchauffez votre four à 180°C."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Construisez vos lasagnes dans votre plat allant au four, une couche à la fois, comme j'aime le faire – ragoût, béchamel puis feuilles de pâtes. Répétez cette opération jusqu'à ce que vous ayez rempli votre plat. Assurez-vous que la couche supérieure est de la béchamel."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Lasagne De Gaz Oakley",
                  "paragraph": "Faites cuire les lasagnes dans votre four pendant 45 minutes. Puis servez."
                }
              }
            }
          ]
        }
      ]
