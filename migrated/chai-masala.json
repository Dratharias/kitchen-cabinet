          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Chai Masala",
                  "paragraph": "Mettez le thé, le gingembre et les épices dans une casserole, versez 1 litre d'eau bouillante et portez à ébullition. Baissez le feu et laissez mijoter jusqu'à ce que vous puissiez sentir les épices, environ 10 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Chai Masala",
                  "paragraph": "Ajoutez le sucre et le lait, augmentez le feu et portez à ébullition. Laissez cuire 10 minutes en remuant de temps en temps. (Une peau se formera, mais elle sera filtrée à la fin.) Goûtez pour voir si le chai vous convient ; faites bouillir un peu plus si vous souhaitez un goût plus fort. La patience sera récompensée !"
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Chai Masala",
                  "paragraph": "Filtrez, jetez les solides, et servez immédiatement."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Quelques Unes Des Nombreuses Façons De Déguster",
                  "paragraph": "Chai iranien : Utilise du lait concentré. Sucré et laiteux, il est parfait pour tremper du pain beurré et des pâtisseries."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Quelques Unes Des Nombreuses Façons De Déguster",
                  "paragraph": "Chai Badshahi : Une portion digne d'un roi, servie dans un verre beaucoup plus grand et utilisant une proportion plus élevée de lait."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Quelques Unes Des Nombreuses Façons De Déguster",
                  "paragraph": "Chai Doodhpati : Pas d'eau, juste du lait."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Quelques Unes Des Nombreuses Façons De Déguster",
                  "paragraph": "Chai Noon : Avec une pincée de sel supplémentaire."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Quelques Unes Des Nombreuses Façons De Déguster",
                  "paragraph": "Chai Kali : Noir (sans lait)."
                }
              }
            },
            {
              "position": 9,
