              "position": 1,
              "segment": {
                "data": {
                  "title": "Mousse Au Chocolat À La Menthe Et",
                  "paragraph": "Pour la mousse, ajoutez tous les ingrédients sauf le chocolat fondu dans votre mixeur et mixez jusqu'à consistance lisse. Mettez le mixeur à basse vitesse puis versez lentement le chocolat fondu."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Mousse Au Chocolat À La Menthe Et",
                  "paragraph": "Une fois lisse et crémeuse, transférez la mousse dans un bol et placez-la au réfrigérateur pendant quelques minutes pour qu'elle prenne."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Mousse Au Chocolat À La Menthe Et",
                  "paragraph": "Pendant ce temps, nettoyez votre mixeur, ajoutez les ingrédients du crumble et mixez en miettes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Mousse Au Chocolat À La Menthe Et",
                  "paragraph": "Servir la mousse garnie de compote de cerises ou de baies fraîches de votre choix, du crumble au chocolat et d'un brin de menthe."
                }
              }
            }
          ]
