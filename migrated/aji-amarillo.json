          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Aji Amarillo",
                  "paragraph": "Si vous utilisez des piments surgelés, laissez-les décongeler à température ambiante. Si vous utilisez des piments séchés, faites-les tremper dans de l'eau pendant 2 heures, puis égouttez-les."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Aji Amarillo",
                  "paragraph": "Équeutez les piments et, si vous désirez une sauce plus douce, retirez les graines. Placez les piments, le beurre de cacahuète, le fromage et l'eau dans un mixeur et réduisez en purée lisse. Ajoutez le huacatay en mixant par impulsions."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Aji Amarillo",
                  "paragraph": "Faites chauffer l'huile d'olive dans une petite casserole à feu moyen-doux. Ajoutez la purée de piment et de beurre de cacahuète et faites cuire en remuant souvent jusqu'à ce qu'elle soit épaisse, crémeuse et riche en saveur, environ 5 à 8 minutes. Réduisez le feu si nécessaire; la sauce doit mijoter doucement, non bouillir."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Aji Amarillo",
                  "paragraph": "Ajoutez 1 cuil. à soupe de jus de lime, ou au goût, et du sel : le mélange doit être bien assaisonné et épicé. Servez chaud ou à température ambiante."
                }
              }
            }
          ]
        }
      ]
