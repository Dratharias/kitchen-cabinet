          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Rub De Barbecue Basique",
                  "paragraph": "Combinez tous les ingrédients dans un bol et mélangez. Transférez dans un bocal, couvrez et conservez à l'abri de la chaleur et de la lumière. Le rub se conservera plusieurs semaines."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Style Espagnol",
                  "paragraph": "Remplacez le paprika doux par le paprika fumé."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Style Espagnol",
                  "paragraph": "Ajoutez les autres ingrédients supplémentaires au mélange de base."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Style Espagnol",
                  "paragraph": "Mélangez bien et utilisez comme le rub de barbecue basique."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Les Composants De Saveur Quand Partir De",
                  "paragraph": "Sucré : Sucre, cassonade, sucre d'érable, sucre de palme ou jus de canne à sucre lyophilisé (comme le Sucanat)"
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Les Composants De Saveur Quand Partir De",
                  "paragraph": "Salé : Sel de mer, sel kasher, sel fumé ou sels spéciaux, comme le sel noir indien ou le sel d'épinette d'Alaska"
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Les Composants De Saveur Quand Partir De",
                  "paragraph": "Acide : Poivre citron, citron frais ou séché, zeste de lime ou d'orange, sumac, etc."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Les Composants De Saveur Quand Partir De",
                  "paragraph": "Piquant: Poivre noir, grains de poivre vert, grains de poivre rose, poivre de Sichuan, poivre blanc, flocons ou poudre de piment séchés, gingembre, wasabi, paprika fort"
                }
              }
            }
          ]
        }
      ]
