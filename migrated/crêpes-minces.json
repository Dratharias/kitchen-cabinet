          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol, mélanger la farine, le sucre et le sel. Ajouter les oeufs, le lait et la vanille puis bien mélanger au fouet jusqu'à ce que la pâte soit lisse et homogène."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Lorsque la poêle est chaude, graisser avec du beurre."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Verser environ ⅓ de tasse de pâte au centre de la poêle et la faire pivoter pour répendre la pâte de façon égale."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Placer les crêpes cuites dans une assiette au fur et à mesure. Couvrir de papier d'aluminium pour éviter qu'elles sèchent. Garder au chaud."
