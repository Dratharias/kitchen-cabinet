          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Xni Pec",
                  "paragraph": "Placez l'oignon dans un bol avec de l'eau glacée pour couvrir et laissez tremper pendant 10 minutes. Égouttez bien dans une passoire et essuyez doucement avec des serviettes en papier. Transférez l'oignon dans un bol et incorporez le jus d'orange amère. Laissez reposer pendant 5 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Xni Pec",
                  "paragraph": "Incorporez délicatement les autres ingrédients. Corrigez l'assaisonnement en ajoutant du sel ou du jus d'orange amère. La salsa est meilleure servie dans les quelques heures suivant sa préparation."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Variante",
                  "paragraph": "Les maîtres grillardins du Yucatán font également une version grillée de cette salsa. Faites griller l'oignon, la tomate et le piment sur le gril ou dans les braises, puis préparez la salsa."
                }
              }
            }
          ]
        }
