          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Bollywood Bellini",
                  "paragraph": "À l'aide d'un pilon et d'un mortier, écrasez les gousses de cardamome pour libérer les graines."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Bollywood Bellini",
                  "paragraph": "Versez le sirop de rose dans un petit pichet et ajoutez la cardamome écrasée. Remuez bien et laissez infuser pendant 30 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Bollywood Bellini",
                  "paragraph": "Versez le sirop de rose infusé à travers un tamis fin ou une passoire à boissons dans un grand pichet (assez grand pour contenir les autres ingrédients). Ajoutez le sirop de sucre et remuez bien."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Bollywood Bellini",
                  "paragraph": "Ajoutez la purée de framboise et le jus de litchi et mélangez bien."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Bollywood Bellini",
                  "paragraph": "Ajoutez le prosecco dans le pichet et remuez doucement pour combiner. Répartissez entre 8 flûtes et dégustez immédiatement."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Note",
                  "paragraph": "Pour la purée de framboise, mixez 175 g de framboises avec 20 ml de sirop simple et passez au tamis pour enlever les graines. (Ou utilisez de la purée prête à l'emploi Funkin Pro ou Boiron.)"
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Sirop De Rose Environ 250 Ml",
                  "paragraph": "Mettez le sucre blanc granulé, l'eau, l'eau de rose et des pétales de rose séchés dans une casserole et portez à ébullition."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Sirop De Rose Environ 250 Ml",
                  "paragraph": "Baissez le feu et laissez mijoter doucement pendant 5 minutes. Retirez du feu et laissez le sirop infuser pendant qu'il refroidit, puis filtrez-le si vous avez utilisé des pétales de rose."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Sirop De Rose Environ 250 Ml",
                  "paragraph": "Il se conserve dans un contenant hermétique au réfrigérateur pendant 2 à 3 semaines."
                }
              }
            }
          ]
        }
