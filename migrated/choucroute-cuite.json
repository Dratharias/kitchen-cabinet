            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Chauffez l'huile dans une grande casserole lourde. Ajoutez les graines de carvi et faites-les cuire à feu moyen pendant 1 minute."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez l'oignon et faites-le cuire jusqu'à ce qu'il soit tendre mais non brun, environ 3 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Incorporez la choucroute et la bière, et laissez mijoter doucement, couvert, jusqu'à ce que la choucroute soit tendre et richement parfumée, environ 20 à 30 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Servez chaud ou à température ambiante. Les restes se conserveront, couverts, au réfrigérateur pendant au moins 3 jours."
                }
              }
            }
          ]
