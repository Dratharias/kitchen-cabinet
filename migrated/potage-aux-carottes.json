          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Hacher grossièrement les légumes. "
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Fondre le beurre et chauffer l'huile dans une casserole à feu moyen. "
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Faire revenir l'oignon haché environ 5 minutes en brassant régulièrement, jusqu'à ce que les morceaux ramollissent.  "
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter l'ail et le thym. Remuer quelques secondes jusqu'à ce qu'un parfum s'en dégage. Incorporer les carottes et la pomme de terre. Brasser pour enrober les légumes de toutes les saveurs. Saler et poivrer.  "
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le bouillon. Couvrir et amener à ébullition. Réduire le feu et laisser mijoter pendant environ 25 minutes, jusqu'à ce que les légumes soient tendres. "
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Réduire en purée lisse à l'aide d'un robot-mélangeur ou d'un mélangeur à main."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Rectifier l'assaisonnement."
                }
              }
            }
          ]
        }
      ]
