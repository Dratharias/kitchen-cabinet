          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Döner Kebab",
                  "paragraph": "Commencez par râper l'oignon en essayant de conserver autant de jus que possible. Dans un bol, ajoutez la viande hachée, l'oignon, le yaourt, le lait, le paprika, le thym, le sel et le poivre. Mélangez bien, puis façonnez en une très grosse saucisse. Enveloppez-la étroitement dans du papier sulfurisé et du film plastique, puis laissez-la au congélateur toute la nuit."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Döner Kebab",
                  "paragraph": "Pour la sauce, hachez le persil et l'aneth et mélangez-les avec le yaourt et la mayonnaise. Pressez le jus de citron, râpez l'ail et assaisonnez de sel et de poivre. Mélangez bien et laissez reposer au réfrigérateur pendant que vous préparez les garnitures."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Döner Kebab",
                  "paragraph": "Tranchez les oignons et hachez grossièrement le persil. Mélangez le tout dans un bol et ajoutez le sumac, le sel et l'huile d'olive. Remuez bien."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Döner Kebab",
                  "paragraph": "Coupez les tomates et les cornichons."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Döner Kebab",
                  "paragraph": "Ensuite, sortez le kebab du congélateur et, avec un couteau très tranchant, découpez la viande en fines lanières. Une fois que vous en avez assez, remettez le kebab au congélateur et réutilisez-le quand vous voulez."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Döner Kebab",
                  "paragraph": "Chauffez une poêle à feu vif, ajoutez du beurre et faites cuire les lanières de viande jusqu'à ce qu'elles soient bien grillées des deux côtés. Retirez-les, puis faites tremper le pain dans les sucs."
                }
              }
            }
          ]
        }
      ]
