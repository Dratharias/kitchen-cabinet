                "data": {
                  "title": "Muffins Véganes Salés",
                  "paragraph": "Préchauffez votre four à 180 °C et tapissez votre moule à muffins de 9 caissettes à muffins."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Muffins Véganes Salés",
                  "paragraph": "Dans un grand bol, ajoutez tous les ingrédients secs et mélangez bien."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Muffins Véganes Salés",
                  "paragraph": "Dans un bol ou un pichet séparé, mélanger les ingrédients humides."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Muffins Véganes Salés",
                  "paragraph": "Ajouter le mélange humide au mélange sec et bien mélanger."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Muffins Véganes Salés",
                  "paragraph": "Versez environ 3 cuillères à soupe du mélange à muffins dans les moules à muffins, le dessus avec une demi-tomate cerise, quelques morceaux d'olive et quelques graines de citrouille."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Muffins Véganes Salés",
                  "paragraph": "Placez la plaque au four pendant 25 à 30 minutes."
                }
              }
            }
          ]
