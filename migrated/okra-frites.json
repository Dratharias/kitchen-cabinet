          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Okra Frites",
                  "paragraph": "aver les okras à l'eau froide et les sécher complètement avec du papier absorbant. Retirer et jeter le haut de chaque okra, en laissant la queue intacte. Les couper en deux dans le sens de la longueur s'ils sont jeunes et petits ; les couper en quartiers dans le sens de la longueur s'ils sont gros."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Okra Frites",
                  "paragraph": "Mélanger les pâtes d'ail et de gingembre, la poudre de piment et 4 cuil. à thé d'eau. Ajouter les moitiés d'okra et bien mélanger pour qu'elles soient bien enrobées."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Okra Frites",
                  "paragraph": "Chauffer l'huile dans une friteuse ou autre poêle profonde et à base lourde à 355°F."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Okra Frites",
                  "paragraph": "Mélanger les deux farines ensemble. Saupoudrer sur les okras et mélanger très doucement pour les enrober."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Okra Frites",
                  "paragraph": "Frire les okras dans l'huile chaude, en plusieurs lots si nécessaire, jusqu'à ce qu'ils soient dorés et croustillants, environ 4 à 5 minutes. Égoutter sur du papier absorbant, saupoudrer de magic masala et servir immédiatement, avec le(s) chutney(s) de votre choix."
                }
              }
            }
          ]
        }
