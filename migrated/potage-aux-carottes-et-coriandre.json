          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Préchauffez votre four à 180°C."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Faire suer les oignons et l'ail dans une grande casserole jusqu'à ce qu'ils soient translucides à feu moyen."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Ajoutez la coriandre moulue puis laissez cuire encore une minute."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Salez et poivrez puis ajoutez les carottes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Baissez le feu très doux et couvrez la casserole. Laissez les carottes cuire jusqu'à ce qu'elles soient presque tendres, en remuant souvent. Ajoutez ensuite votre bouillon et votre lait puis portez à ébullition."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Pendant ce temps, ajoutez les cubes de pain sur une plaque à pâtisserie et arrosez d'huile d'olive, d'herbes et d'une pincée de sel et de poivre. Placez la plaque dans votre four pour cuire pendant 10 minutes ou jusqu'à ce qu'elle soit dorée et croustillante."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Incorporez la coriandre fraîche à la soupe, puis ajoutez délicatement le mélange dans votre mixeur et mixez. Une fois lisse, remettez la soupe dans votre casserole et vérifiez l'assaisonnement."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Ajoutez du sel, du poivre et du jus de citron pour faire ressortir les saveurs."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Potage Aux Carottes Et Coriandre",
                  "paragraph": "Servez votre soupe avec des croûtons & quelques feuilles de coriandre."
                }
              }
            }
          ]
        }
