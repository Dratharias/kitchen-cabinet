          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Effilocher à l'aide d'une fourchette les champignons. Le bout des pieds sont comestibles, mais un peu plus caoutchouteux et fibreux."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Mélanger les épices dans un bol avec les champignons et l'huile."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Préchauffer le four à 400F."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Dans une poêle qui peut supporter une température élevée préchauffée, dorer les champignons jusqu'à les avoirs vidés de leur eau et qu'ils aient une belle caramélisation. Pour se faire, on les étends dans le fond de la poêle et on les laisses cuire. Lorsqu'on les presses, on y voit l'eau s'échapper."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Lorsque la cuisson est terminée ou est jugée satisfaisante, remettre les champignons dans le bol."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Ajouter le reste des ingrédients et mélanger."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Étaler sur une plaque de cuisson couverte de papier parchemin le mélange de sauce et champignons, enfourner pour 10 à 12 minutes. Lorsque la sauce a suffisamment épaissis. Retirer et laisser reposer."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Burger De Pleurotes King Effilochés",
                  "paragraph": "Monter le burger."
                }
              }
            }
          ]
        }
