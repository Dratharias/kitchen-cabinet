          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Retirer les boulettes du réfrigérateur juste avant de servir. Les sortir du bol, presser pour enlever l'excès d'eau et déchirer chaque boulette en 2 ou 3 morceaux."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Répartir les boulettes déchirées sur le fond d'un grand plat de service. Saupoudrer de sel et de la plupart du piment en poudre et du cumin grillé. Casser la moitié des papdis par-dessus."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Couvrir généreusement avec le topping de yaourt sucré (vous devriez pouvoir distinguer les formes des boulettes, mais elles devraient par ailleurs être recouvertes)."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Parsemer de raisins secs et de graines de grenade, puis faire des tourbillons avec la sauce tamarin et le topping de chutney vert. Saupoudrer d'un peu plus de piment en poudre et de cumin grillé, pour créer un joli motif. Garnir de feuilles de coriandre et du reste des papdis, si vous en utilisez, en les cassant légèrement. Saupoudrer de sev fin et servir."
                }
              }
            }
          ]
