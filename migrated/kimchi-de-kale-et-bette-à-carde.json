          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Ajouter tous les ingrédients dans un grand bol à mélanger et peser. Déterminez ce que représentent 2 % du poids, puis ajoutez ce poids en sel marin."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Massez avec le sel pendant environ 5 minutes. Couvrez ensuite le bol avec un torchon propre. Mettez le bol de côté pendant au moins 2 heures pour que l'eau soit aspirée."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Transférez le kimchi dans des bocaux propres puis placez une feuille de nori directement dessus."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Laissez fermenter le kimchi hors du réfrigérateur pendant environ 3 jours. Transférez-le ensuite au réfrigérateur où il se conservera jusqu'à 4 semaines."
                }
              }
            }
          ]
        }
