          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Salade Chana Chaat",
                  "paragraph": "Mettre le couscous dans un récipient allant au micro-ondes (une grande tasse est parfaite). Ajouter 60ml d'eau bouillante et l'huile d'olive et faire chauffer au micro-ondes pendant 1 minute à puissance élevée. Laisser reposer pendant 5 minutes, puis égrener le couscous à l'aide d'une fourchette. (Alternativement, le couscous peut être cuit dans une petite casserole à feu moyen.) Une fois égrené, laisser refroidir le couscous."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Salade Chana Chaat",
                  "paragraph": "Mettre les grains germés dans un bol et verser de l'eau bouillante pour les recouvrir. Égoutter immédiatement dans une passoire et rincer sous l'eau froide du robinet. Secouer pour sécher et réserver."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Salade Chana Chaat",
                  "paragraph": "Chauffer une poêle à sec à feu vif et ajouter les graines de citrouille. Faire griller pendant 2 minutes ou jusqu'à ce qu'elles soient dorées, en secouant la poêle pour que les graines ne brûlent pas. Ajouter les graines de sésame et faire griller pendant une minute supplémentaire. Retirer de la poêle et réserver."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Salade Chana Chaat",
                  "paragraph": "Dans un grand saladier, mélanger le couscous, les pois chiches, la tomate en dés, les grains germés, les raisins secs et les graines de grenade. Assaisonner généreusement de sel de mer en flocons."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Salade Chana Chaat",
                  "paragraph": "Pour préparer la vinaigrette, mixer les ingrédients à l'aide d'un mixeur ou d'un mini robot culinaire jusqu'à obtenir une pâte lisse."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Salade Chana Chaat",
                  "paragraph": "Ajouter la vinaigrette au saladier ainsi que la coriandre hachée et les trois quarts des graines grillées. Bien mélanger, puis goûter pour ajuster l'assaisonnement, en ajoutant plus de sel si nécessaire. Garnir avec les graines grillées restantes avant de servir."
                }
              }
            }
          ]
        }
      ]
