          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Chauffer l'huile dans une grande casserole. Ajouter les oignons et mélanger occasionnellement, jusqu'à ce qu'ils soient translucides."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le gingembre, l'ail, la poudre de moutarde, le tout épice et le piment de cayenne et mélanger pour une minute."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajouter la pâte de tomate et mélanger une autre minute, puis ajouter les tomates et grater avec une cuillère en bois le fond de la casserole. Retirer de la chaleur."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Transformer le ketchup en purée avec un mélangeur jusqu'à consistence homogène, ajouter le laurier, sel, cassonade, vinaigre et mélasse, puis remettre à mijoter à feu doux en mélangeant occasionnellement jusqu'à une consistence très épaisse, environ 1h45 minutes."
                }
              }
            }
          ]
