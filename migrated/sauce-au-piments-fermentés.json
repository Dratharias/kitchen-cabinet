          "content_segments": [
            {
              "position": 1,
              "segment": {
                "paragraph": "Frire l'ail doucement à feu moyen-doux dans la 1/2 tasse d'huile jusqu'à ce qu'elle deviennent brun-doré."
              }
            },
            {
              "position": 2,
              "segment": {
                "paragraph": "Passer-les à travers une passoire à mailles fines, réserver l'ail et l'huile séparément."
              }
            },
            {
              "position": 3,
              "segment": {
                "paragraph": "Dans un mélangeur, mélanger l'ail, les piments fermentés, le vinaigre blanc et la saumure de piment."
              }
            },
            {
              "position": 4,
              "segment": {
                "paragraph": "Commencez à mélanger à grande vitesse jusqu'à ce que le mélange devienne lisse."
              }
            },
            {
              "position": 5,
              "segment": {
                "paragraph": "Tout en continuant de mélanger, émulsifier lentement environ la moitié de l'huile d'ail dans la sauce jusqu'à obtenir la consistance désirée."
              }
            },
            {
              "position": 6,
              "segment": {
                "paragraph": "Ajouter du sel au goût."
              }
            }
          ]
        },
        {
          "total_prep_time": 0,
          "servings": null,
          "subtitle": "Piments Lacto Fermentés",
          "is_ingredient": false,
