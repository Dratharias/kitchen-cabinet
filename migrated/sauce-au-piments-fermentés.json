            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "paragraph": "Retirez le dessus de vos piments et coupez-les tous en deux dans le sens de la longueur."
              }
            },
            {
              "position": 2,
              "segment": {
                "paragraph": "Placez-les dans un bocal mason 500 ml propre de préférence stérile. Ajouter la solution d'eau saline jusqu'au cou du bocal."
              }
            },
            {
              "position": 3,
              "segment": {
                "paragraph": "Gardez-les immergé avec un objet lourd et sceller avec un couvercle."
              }
            },
            {
              "position": 4,
              "segment": {
                "paragraph": "Laissez-les à température ambiante à l'abris du soleil pendant 5 jours à 2 semaines."
              }
            },
            {
              "position": 5,
              "segment": {
                "paragraph": "Une fois que vos piments ont atteint le point où vous pensez qu'ils sont prêt, passez-les à travers une passoire en filet. Réserver la saumure."
              }
            }
          ]
        }
