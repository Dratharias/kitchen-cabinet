          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Préchauffez votre four à 180°C."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Placez la citrouille dans une plaque à rôtir avec le cajun, la sauge, l'assaisonnement et l'huile. Mélangez le tout avec vos mains."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Faites rôtir la citrouille dans votre four pendant environ 45 minutes à une heure – ou jusqu'à ce qu'elle soit tendre."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Quand le potiron est cuit. Placez une grande casserole sur feu moyen et une goutte d'huile ou d'eau si vous gardez cette recette sans huile, oignon et ail. Faire revenir le mélange avec une pincée de sel pendant 4 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Ajoutez le potiron dans la casserole, suivi du bouillon de lait et de légumes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Laissez la soupe mijoter pendant 10 minutes avant de la mélanger jusqu'à ce qu'elle soit très lisse."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Mélangez la soupe quelques louches à la fois et si elle est trop épaisse, ajoutez du bouillon de légumes."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "Vérifiez que la soupe est bien assaisonnée avant de servir avec les garnitures."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Soupe Cajun À La Citrouille",
                  "paragraph": "La soupe peut être conservée au réfrigérateur jusqu'à 4 jours."
                }
              }
            }
          ]
        }
      ]
