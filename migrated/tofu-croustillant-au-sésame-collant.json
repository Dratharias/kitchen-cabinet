          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Sésame Collant",
                  "paragraph": "Placez le tofu en cubes dans un bol à mélanger puis saupoudrez de farine de maïs et de 5 épices. Mélangez bien en vous assurant que le tofu est uniformément enrobé."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Sésame Collant",
                  "paragraph": "Placez une poêle antiadhésive sur feu moyen et ajoutez l'huile. Lorsque la poêle est chaude, ajoutez le tofu et faites cuire 2 minutes de tous les côtés ou jusqu'à ce que le tofu se colore légèrement et gonfle. Jetez l'oignon rouge, l'ail, le piment et le gingembre dans la poêle, puis baissez le feu et laissez l'oignon ramollir, en remuant le mélange de temps en temps."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Sésame Collant",
                  "paragraph": "Déglacez la poêle avec la sauce soja, puis ajoutez le hoisin, le sirop d'érable et le tahini. Remuez doucement pour ne pas briser le tofu mais pour vous assurer que tout est bien enrobé, puis laissez la sauce bouillonner et épaissir pendant 4 à 5 minutes. En remuant souvent."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Sésame Collant",
                  "paragraph": "Pendant ce temps préparez vos garnitures."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Sésame Collant",
                  "paragraph": "Avant de servir, incorporez les graines de sésame."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Sésame Collant",
                  "paragraph": "Garnissez votre recette de riz avec du tofu gluant et servez avec des légumes verts, du pak choi, de l'oignon nouveau haché et quelques graines de sésame supplémentaires saupoudrées sur le dessus."
                }
              }
            }
          ]
        }
      ]
