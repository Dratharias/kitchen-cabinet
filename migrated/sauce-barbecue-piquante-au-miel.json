          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Combinez tous les ingrédients dans une grande casserole non réactive. Portez à ébullition à feu moyen, en remuant fréquemment pour dissoudre le sucre."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Réduisez le feu et laissez mijoter, à découvert, jusqu'à ce que les piments soient tendres et que la sauce soit épaisse et savoureuse, environ 10 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Utilisez immédiatement ou transférez la sauce dans un bocal, couvrez, laissez refroidir à température ambiante et réfrigérez. La sauce se conserve plusieurs semaines."
                }
              }
            }
          ]
