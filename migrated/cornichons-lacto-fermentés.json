          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Placez les concombres dans un bocal en verre propre ou dans une cuve de fermentation. Versez dessus votre eau de source afin qu'elle recouvre vos concombres sur environ 1 cm."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Versez l'eau puis pesez l'eau. Ajoutez 4% du poids de l'eau dans le sel marin et fouettez jusqu'à dissolution."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez l'ail, les fleurs d'aneth et les épices pour marinades dans le pot avec les concombres. Versez ensuite dessus la saumure d'eau salée."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Placez un poids sur les concombres pour les maintenir sous la saumure. Vous pouvez même utiliser un caillou propre pour cela."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Couvrez le pot et laissez-le à température ambiante pendant 4 à 7 jours ou jusqu'à ce qu'il atteigne le niveau de piquant souhaité. Si vous utilisez un pot scellé, vous devrez faire roter le pot de temps en temps pour laisser échapper le gaz qui s'accumule."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Après fermentation, placez le pot au réfrigérateur jusqu'à 6 semaines."
                }
              }
            }
          ]
        }
      ]
