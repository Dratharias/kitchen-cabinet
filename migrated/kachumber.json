          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Trancher l'oignon rouge en fines lamelles. Placer dans un petit bol et couvrir d'eau froide."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Couper la tomate en deux, retirer et jeter les graines, puis trancher la chair en fines lamelles et placer dans un grand bol."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Couper le concombre en deux dans le sens de la longueur et retirer délicatement les graines à l'aide d'une cuillère à café. Trancher le concombre en fines croissants et ajouter à la tomate."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Égoutter l'oignon, éponger avec du papier absorbant et ajouter à la tomate et au concombre."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le sel, bien mélanger et laisser reposer pendant 5 minutes pour permettre aux jus de se mélanger."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Déchiqueter la moitié des feuilles de coriandre, garder l'autre moitié entière."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Ajouter toute la coriandre à la salade, assaisonner de jus de lime, bien mélanger et servir."
                }
              }
            }
          ]
        }
      ]
