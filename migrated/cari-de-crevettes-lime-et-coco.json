          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une grande poêle, dorer l'oignon dans l'huile. Ajouter l'ail et le gingembre. Cuire 1 minute."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les tomates, le lait de coco et la sauce tomate, les épices, le piment, le sel et le poivre. Couvrir et laisser mijoter à feu doux pendant 10 à 15 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les crevettes. Porter à ébullition, réduire le feu et laisser mijoter de 3 à 5 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le jus de lime et garnir. Rectifier l'assaisonnement et servir sur riz blanc."
                }
              }
            }
          ]
        }
