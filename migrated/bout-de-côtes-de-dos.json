          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Faites chauffer votre four à 300°F."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Pendant que le four chauffe, épluchez et hachez grossièrement l'oignon. Ensuite, épluchez et écrasez l'ail dans un presse-ail ou hachée."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Placez une poêle à feu moyen jusqu'à ce qu'elle soit chaude, puis ajoutez l'huile d'olive, l'oignon et l'ail. Frire pendant 4 à 5 minutes ou jusqu'à ce que l'oignon ait ramolli."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le piment (le cas échéant), les graines de fenouil et la cassonade et cuire, en remuant, encore 1 à 2 minutes jusqu'à ce que le sucre ait fondu."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le ketchup et la sauce soja et mélanger le tout. Porter à ébullition, puis réduire le feu et laisser mijoter 10 minutes, jusqu'à ce que la sauce épaississe."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Mettez les côtes levées dans un plat à rôtir profond, ou une cocotte, et versez la sauce."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Couvrez la plaque de papier d'aluminium, mettre le couvercle de la cocotte le cas échéant, et mettez-la au four pendant 2 heures, puis augmentez la température du four à 350°F, retirez le papier d'aluminium et laissez cuire encore 30 à 45 minutes."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Une fois cuites, retirez la plaque du four et laissez les côtes refroidir afin qu'elles ne soient pas trop chaudes à manipuler avant de servir."
                }
              }
            }
          ]
        }
      ]
