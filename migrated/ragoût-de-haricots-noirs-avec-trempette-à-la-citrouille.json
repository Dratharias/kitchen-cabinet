          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Ragoût De Haricots Noirs Avec Trempette À",
                  "paragraph": "Préchauffez une casserole à feu moyen et ajoutez l'huile suivie de l'oignon, de l'ail, du piment et du sel. Faire sauter jusqu'à ce qu'il soit ramolli."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Ragoût De Haricots Noirs Avec Trempette À",
                  "paragraph": "Ajouter les épices et herbes séchées puis cuire 3-4 minutes. En remuant souvent. Ajoutez ensuite dans la poêle la pâte de chipotle, les haricots noirs et les pois chiches suivis de l'eau, de la purée de tomates et de la sauce soja."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Ragoût De Haricots Noirs Avec Trempette À",
                  "paragraph": "Placez un couvercle sur la casserole et laissez mijoter les haricots pendant environ 20 minutes ou jusqu'à ce que le joli liquide épaississe."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Ragoût De Haricots Noirs Avec Trempette À",
                  "paragraph": "Pendant ce temps, préparez la trempette aux graines de citrouille, ajoutez simplement tous les ingrédients dans un mélangeur et mélangez jusqu'à ce qu'elle ressemble à une trempette épaisse."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Ragoût De Haricots Noirs Avec Trempette À",
                  "paragraph": "Faites cuire votre quinoa et autres garnitures. Puis juste avant de servir, incorporez le chocolat et la coriandre hachée au ragoût."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Ragoût De Haricots Noirs Avec Trempette À",
                  "paragraph": "Servir immédiatement ou en portions dans vos contenants de préparation de repas. La préparation de repas se conserve jusqu'à 5 jours au réfrigérateur. Assurez-vous que les repas sont très chauds."
                }
              }
            }
          ]
        }
      ]
    }
