          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Porridge À La Tarte Aux Pommes",
                  "paragraph": "Mettez les pommes en cubes dans une casserole avec l'eau, la cannelle et le sucre de coco. Placez la poêle sur feu moyen et faites mijoter pendant 5 à 6 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Porridge À La Tarte Aux Pommes",
                  "paragraph": "Pendant ce temps, dans une autre casserole, ajoutez le lait végétal et les épices. Placez la casserole sur feu doux pour infuser pendant 4 à 5 minutes, puis incorporez les flocons d'avoine. Continuez à remuer jusqu'à ce que le mélange soit épais et crémeux."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Porridge À La Tarte Aux Pommes",
                  "paragraph": "Garnir le porridge avec la compote de pommes, les noix et les graines."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Porridge À La Tarte Aux Pommes",
                  "paragraph": "La compote de pommes se conserve 4 à 5 jours dans un récipient fermé au réfrigérateur."
                }
              }
            }
          ]
        }
      ]
