          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Combiner le persil, la coriandre et l'ail dans un robot culinaire et hacher finement."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le sel, le paprika, le poivre, le cumin, les flocons de piment rouge, le jus de citron, l'huile et l'eau, et réduire en purée grossière en utilisant des pulsations courtes. Rectifier l'assaisonnement, en ajoutant du sel et/ou du jus de citron; la charmoula doit être bien assaisonnée."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Comme la plupart des sauces faites avec des herbes fraîches, la charmoula est meilleure lorsqu'elle est servie dans les quelques heures suivant sa préparation."
                }
              }
            }
          ]
