              "position": 1,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Dans une casserole à feu moyen, verser le lait évaporé et la crème."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Porter doucement à ébullition."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Si vous utilisez du lait en poudre, ajoutez-le à ce stade."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Laisser mijoter doucement pendant 2 minutes en remuant presque constamment."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Ajouter le sucre et la cardamome."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Bien mélanger et laisser mijoter en remuant pendant encore 2 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Préparation Du Mélange De Base",
                  "paragraph": "Laisser refroidir complètement le mélange."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Congélation Et Service",
                  "paragraph": "Verser le mélange dans des moules à kulfi ou à glace."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Congélation Et Service",
                  "paragraph": "Congeler jusqu'à ce qu'il soit complètement solide (environ 6 heures)."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Congélation Et Service",
                  "paragraph": "Au moment de servir, retirer les kulfis des moules et servir immédiatement."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Kulfi À La Mangue",
                  "paragraph": "Remplacer 30g de sucre par 120g de purée de mangue Alphonso."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Kulfi À La Mangue",
                  "paragraph": "Ajouter la purée de mangue en même temps que le sucre."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Kulfi À La Mangue",
                  "paragraph": "Bien mélanger et laisser mijoter pendant 2 minutes avant d'ajouter la cardamome."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Mixer 90g de pistaches émondées et non salées avec un peu de lait évaporé."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Réserver la purée de pistache."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Dans une casserole, porter le reste du lait évaporé et la crème à ébullition."
                }
              }
            },
            {
              "position": 17,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Laisser mijoter 2 minutes en remuant."
                }
              }
            },
            {
              "position": 18,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Ajouter 60g de sucre et la purée de pistache."
                }
              }
            },
            {
              "position": 19,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Mélanger et laisser mijoter 2 minutes."
                }
              }
            },
            {
              "position": 20,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Retirer du feu et mixer jusqu'à consistance lisse."
                }
              }
            },
            {
              "position": 21,
              "segment": {
                "data": {
                  "title": "Kulfi À La Pistache",
                  "paragraph": "Laisser refroidir, congeler et servir."
                }
              }
            },
            {
              "position": 22,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Pour un kulfi plus onctueux, utilisez de la crème entière."
                }
              }
            },
            {
              "position": 23,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Vous pouvez parfumer votre kulfi avec d'autres épices, comme de la cannelle ou du safran."
                }
              }
            },
            {
              "position": 24,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Pour une version plus saine, utilisez du sucre de coco ou du miel."
                }
              }
            },
            {
              "position": 25,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Dégustez votre kulfi avec des fruits frais ou des noix concassées."
                }
              }
            }
          ]
        }
