            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Cuire le quinoa. Réserver."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Broyer en poudre entre 2 tasses à 2 ½ de flocon d'avoines et réserver dans un grand bol."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Toujours au robot, hacher finement l'oignon, le poivron et l'ail. Ajouter dans le bol de farine d'avoine."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Hacher très grossièrement les haricots noirs dans le robot (6-7 pulses). Ajouter dans le bol."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter tout les ingrédients manquants au bol et mélanger jusqu'à obtenir une pâte rougâtre humide."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Façonner la pâte en burger. Peut être congelé. Peut-être directement mise à cuire en sortant du congélateur."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "La cuisson est selon la préférence, elle peut-être bien cuite comme presque crue, ce sont des légumes."
                }
              }
            }
          ]
