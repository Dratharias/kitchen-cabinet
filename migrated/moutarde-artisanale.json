          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Placez les graines de moutarde dans un bol et ajoutez le vinaigre de cidre de pomme. Ajoutez également l'eau pour couvrir les graines. Laissez tremper les graines pendant la nuit pour les ramollir."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Le lendemain, mettez les graines de moutarde trempées dans un mixeur ou un robot culinaire. Ajoutez le sel et le miel. Mixez jusqu'à obtenir une pâte lisse."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Selon la consistance que vous souhaitez, vous pouvez ajouter un peu plus d'eau si la pâte est trop épaisse."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Transférez la pâte dans un bocal en verre propre et stérile. Assurez-vous que la pâte est bien tassée pour éliminer les bulles d'air. Fermez le bocal de manière lâche pour permettre la libération des gaz pendant la fermentation."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Laissez la moutarde fermenter à température ambiante pendant 3 jours. Pendant cette période, la moutarde développera des saveurs plus complexes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Après la fermentation, serrez bien le couvercle du bocal et placez-le au réfrigérateur."
                }
              }
            }
          ]
        }
