          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une grande casserole, dorer les oignons dans l'huile. Ajouter le poivron, l'ail, le piment, les épices et faire revenir environ 2 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les tomates, les haricots, les patates douces, le bouillon et porter à ébullition. Laisser mijoter à découvert, en remuant fréquemment, environ 30 minutes ou jusqu'à ce que les patates soient tendres. Ajouter le maïs, les arachides et poursuivre la cuisson environ 5 minutes. Ajouter la coriandre. Rectifier l'assaisonnement."
                }
              }
            }
          ]
        }
