          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préparez un gril pour une cuisson directe et préchauffez à feu vif."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Badigeonnez le poisson des deux côtés avec un peu de beurre à l'ail et à la coriandre ou de beurre au sésame et à la sauce soja. Assaisonnez le poisson des deux côtés avec du sel et du poivre. Placez le poisson dans le panier à gril huilé."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Grillez le poisson jusqu'à ce qu'il soit doré à l'extérieur et cuit à cœur (la température interne sera d'environ 140°F sur un thermomètre instantané), 4 à 6 minutes de chaque côté. Badigeonnez le poisson avec le reste du beurre pendant la cuisson."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Transférez le poisson dans un plat ou des assiettes. Garnissez avec le relish de melon à la menthe et dégustez!"
                }
              }
            }
          ]
        }
      ]
