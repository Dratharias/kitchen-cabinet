          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pour préparer le dahl, faites revenir les poireaux, l'ail, le piment, le céleri et le gingembre à feu moyen avec l'huile d'olive pendant environ 5 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Ajoutez ensuite les feuilles de curry, le curcuma, le sel, les graines de moutarde et de coriandre. Cuire encore quelques minutes avant d'ajouter le potiron."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Mettez un couvercle sur la casserole et baissez le feu, laissez le mélange suer pendant 5 minutes puis ajoutez le bouillon de légumes et les pois cassés rincés. Laissez le dahl bouillonner pendant 35 minutes. Remuez de temps en temps."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Une fois les petits pois cuits, incorporez le lait de coco, le citron et le garam masala. Ajoutez un peu de sel supplémentaire si nécessaire, puis mixez jusqu'à obtenir une consistance lisse mais toujours un peu texturée (vous n'êtes pas obligé de mixer du tout si vous ne le souhaitez pas)."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pour faire le pain naan, mélangez l'eau tiède avec la levure. Laisser reposer environ 5 minutes jusqu'à ce que le mélange bouillonne."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pendant ce temps, mélangez la farine, le curcuma et le sel dans un grand bol ou un mixeur à pain."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Faire un puits au milieu puis ajouter le mélange eau & levure + l'huile d'olive. Remuer jusqu'à ce que le mélange commence à se combiner."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Une fois que tout est réuni, étalez la pâte sur un plan de travail légèrement fariné."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Il est maintenant temps de pétrir, si vous utilisez un mixeur à pain, utilisez votre crochet pétrisseur et mélangez/pétrissez pendant 5 minutes."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pétrir à la main pendant environ 5 minutes. La pâte doit être bien lisse et élastique au bout de 8 minutes. Ajoutez un peu de farine en pétrissant si vous la trouvez trop collante. Mais pas trop!"
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Placez la pâte dans un bol légèrement huilé et couvrez-la d'un torchon humide. Laissez la pâte lever (doubler de volume) pendant 1 à 2 heures."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pendant ce temps, pour la garniture, mélangez les raisins secs, la noix de coco, la farine de noix de coco, la farine d'amande, le lait d'érable et d'amande dans un petit bol pour former une pâte. Réservez jusqu'à ce que vous soyez prêt à l'utiliser."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Lorsque la pâte a levé, étalez-la sur un plan de travail légèrement fariné et pétrissez légèrement pendant une minute. Divisez la pâte en 8 morceaux de taille égale."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pour remplir la pâte, étirez la pâte avec les mains farinées ou étalez la pâte sur environ 3 mm d'épaisseur en forme de disque. Prenez quelques cuillères à soupe de garniture à la noix de coco et placez-les au centre de la pâte, ramassez les bords pour que la garniture soit enveloppée et scellée dans la pâte."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Répétez jusqu'à ce que vous ayez farci toutes les boules de pâte."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pour cuire le naan, placez une poêle en fonte sur feu moyen."
                }
              }
            },
            {
              "position": 17,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Abaissez la pâte selon la forme souhaitée, idéalement sur environ 3 mm d'épaisseur."
                }
              }
            },
            {
              "position": 18,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Avant de cuire chaque naan, ajoutez un peu d'eau, puis du naan. Laissez le naan lever légèrement et l'eau s'évapore. L'eau fera adhérer le pain à la poêle, ce qui vous permettra de retourner la poêle pour l'exposer à la flamme. Ce qui offrira une saveur inspirée du carbonisé/tandoor. Si vous ne cuisinez pas sur un feu ou au gaz, sautez simplement l'étape de l'eau et faites simplement cuire le pain des deux côtés pendant 3 à 4 minutes en utilisant un peu d'huile."
                }
              }
            },
            {
              "position": 19,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Quand vos pains sont légers, moelleux et colorés. Ils sont prêts."
                }
              }
            },
            {
              "position": 20,
              "segment": {
                "data": {
                  "title": "Dhal À La Citrouille Et Naan Peshwari",
                  "paragraph": "Pour la vinaigrette, mélangez simplement tous les ingrédients ensemble."
                }
              }
            }
          ]
        }
      ]
    }
  }
}