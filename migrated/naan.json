          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Mélangez 15 g de cheddar râpé, 1/2 cuil. à thé de piment vert finement haché et 1 cuil. à thé d'oignon vert finement haché dans un bol."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Prenez une boule de pâte dans la paume de votre main. Avec l'autre main, aplatissez la pâte en un disque."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Pincez les bords, en utilisant votre index et votre pouce, pour créer un puits au centre entouré de bords légèrement plus fins."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Pressez la garniture au fromage dans le puits et pincez les bords de la pâte autour de la garniture pour la sceller, puis reformez délicatement en une boule. Laissez reposer 5 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Roulez la boule de pâte farcie en un pain plat rond de 3-4 mm d'épaisseur."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Cuisez comme dans la recette principale, mais laissez environ deux fois plus longtemps sous le gril; le naan devrait encore gonfler, même avec la garniture à l'intérieur. Enveloppez dans un torchon propre pendant 1 minute avant de servir."
                }
              }
            }
          ]
