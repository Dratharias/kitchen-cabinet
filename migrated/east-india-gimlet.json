          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Pressez le quartier de lime dans votre shaker à cocktail et jetez l'écorce. Placez la branche d'aneth sur une paume et donnez-lui une claque rapide avec l'autre main; cela aide à libérer les huiles. Ajoutez-la au shaker."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez le cordial de lime, l'amer de céleri et le gin. Remplissez avec beaucoup de glaçons et secouez vigoureusement pendant au moins 30 secondes. Goûtez le cocktail; il doit être acide, sucré, assez fort et très rafraîchissant."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Filtrez dans une coupe ou un verre à martini et équilibrez soigneusement une petite branche d'aneth à l'intérieur du verre."
                }
              }
            }
          ]
        }
