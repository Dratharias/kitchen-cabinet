          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Paneer Tikka Achari",
                  "paragraph": "Couper le paneer en cubes de 3 cm et placer dans un bol. Mélanger les ingrédients de la première marinade avec 2 cuillères à soupe d'eau. Ajouter aux cubes de paneer, remuer pour enrober et laisser mariner pendant la préparation de la deuxième marinade et des poivrons."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Paneer Tikka Achari",
                  "paragraph": "Chauffer une poêle sèche à feu vif. Ajouter la farine de pois chiche et griller jusqu'à ce qu'elle soit dorée. Verser dans un grand bol et laisser refroidir. Ajouter le cornichon moulu, la poudre de chili, le curcuma, le sel et l'huile de moutarde. Mélanger jusqu'à ce que le tout soit bien combiné, puis ajouter le yogourt et mélanger à nouveau."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Paneer Tikka Achari",
                  "paragraph": "Couper les poivrons en morceaux de la même taille que le paneer. Ajouter les poivrons et le paneer à la deuxième marinade et laisser mariner au réfrigérateur pendant 6 à 24 heures."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Paneer Tikka Achari",
                  "paragraph": "Si vous utilisez des brochettes en bois, faites-les tremper 30 minutes avant de les assembler."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Paneer Tikka Achari",
                  "paragraph": "Préchauffer le gril à feu vif. Enfiler des morceaux de poivron et de paneer en alternance sur des brochettes en métal ou en bois et badigeonner de beurre fondu. Griller les brochettes pendant 8 à 10 minutes jusqu'à ce qu'elles soient dorées et bien chaudes, en les retournant à quelques reprises et en les arrosant de beurre fondu."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Paneer Tikka Achari",
                  "paragraph": "Saupoudrer les brochettes de masala pour kebab et servir immédiatement."
                }
              }
            }
          ]
        }
