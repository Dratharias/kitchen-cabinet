          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 400℉."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Dorer l'oignon dans une rôtissoire pouvant aller au four, ou le transférer dans une cocotte une fois dorer."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajouter l'ail, le piment, les épices et saler/poivrer - bien mélanger."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Torréfié les épices, l'ail et le piment et ajouter à la rôtissoire"
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les lentilles, les tomates, le lait de coco, saler/poivrer et 2 tasses de bouillon, bien mélanger."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Remettez le plat au four et laissez cuire 1h ou 1h10 ou jusqu'à ce que les lentilles soient cuites et le curry soit épais au goût."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Une fois cela fait, retirez le plat du four et, pendant que le mélange est encore chaud, mélangez d'abord le beurre d'amande."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Ajustez la saveur et les épices au besoin. Ajouter du jus de lime et de la coriandre pour la garniture, au choix."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Ajuster la consistance avec du bouillon si nécessaire."
                }
              }
            }
          ]
        }
      ]
