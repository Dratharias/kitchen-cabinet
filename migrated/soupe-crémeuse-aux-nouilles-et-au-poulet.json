          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Faites fondre le beurre dans une grande marmite ou cocotte à feu moyen."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez l'oignon, les carottes, le céleri et l'ail. Faites cuire en remuant de temps en temps pendant 5 minutes ou jusqu'à ce que les légumes ramollissent."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez la farine, le sel, le poivre, le thym et l'origan et faites cuire pendant 2 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez le bouillon de poulet et la pomme de terre. Remuez rapidement, puis augmentez le feu à moyen-élevé."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Portez la soupe à ébullition, sans remuer, et faites bouillir pendant 3 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Réduisez le feu à moyen-bas, couvrez partiellement la marmite et laissez mijoter pendant 25 minutes ou jusqu'à ce que les pommes de terre ramollissent."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Goûtez la soupe et ajoutez plus d'assaisonnements au goût, si nécessaire."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez le poulet, les produits laitiers et les nouilles. Faites cuire pendant 10 minutes jusqu'à ce que les nouilles soient tendres et que la soupe ait épaissi."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Goûtez la soupe et ajoutez plus d'assaisonnements selon vos préférences. Servez chaud."
                }
              }
            }
          ]
        }
