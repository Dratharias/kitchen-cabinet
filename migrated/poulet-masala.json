          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Dans une petite casserole, ajouter toutes les épices et griller pendant 2 minutes. Retirer et refroidir."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter les épices à un mélangeur et broyer le plus finemenent possible."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter l'ail, le gingembre pelé, le garam masala, la poudre de curcuma et les piments fresno. Ajouter l'eau et l'huile et mélanger jusqu'à consistance lisse."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Coupez le poulet en morceaux de la taille d'une bouchée."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Dans un bol, mettre le yogourt, la pâte de tikka masala et du sel. Fouetter ensemble."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter le poulet et mélanger pour enrober soigneusement. Couvrir d'une pellicule plastique et mariner pendant 20 minutes ou pendant la nuit au réfrigérateur."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Laver et rincer le riz et commencer sa cuisson."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "(Canne de tomate) Ajoutez la boîte de tomates au mélangeur et mélangez jusqu'à consistance lisse. Passer à travers une passoire à mailles fines. Réserver."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Dans une casserole à feu moyen-élevé, ajoutez assez d'huile pour couvrir le fond. Saisir le poulet 3-4 minutes de chaque côté. Réserver."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Réduisez le feu à moyen et ajoutez du beurre pour fondre avant d'ajouter des oignons en dés et faire revenir jusqu'à ce qu'ils soient translucides."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter le reste de la pâte Tikka masala avec le paprika et la poudre de chili. Cuire et remuer souvent jusqu'à ce que la pâte commence à coller dans la casserole."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter les tomates et amener à mijoter en remuant occasionnellement à feu moyen pendant 10 minutes."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter la crème épaisse et mélanger jusqu'à ce qu'ils soient soigneusement combinés."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Ajouter le poulet à la casserole de sauce et amener à mijoter. Laisser cuire pendant 10 à 15 minutes supplémentaires."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Assaisonner au goût avec du sel et de servir avec du riz."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Poulet Masala",
                  "paragraph": "Garnir de coriandre et servir."
                }
              }
            }
          ]
        }
      ]
