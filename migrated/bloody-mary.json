          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Bloody Mary",
                  "paragraph": "Pour le mélange Bloody Mary, combinez tous les ingrédients dans un pichet et mélangez bien pour que le sel et les épices soient bien répartis. Conservez dans une bouteille ou un bocal hermétique au réfrigérateur et utilisez dans les 4 à 5 jours."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Bloody Mary",
                  "paragraph": "Lorsque vous êtes prêt à servir, ajoutez la vodka au mélange Bloody Mary, remuez pour combiner et versez dans 4 grands verres. Ajoutez autant de glace que possible dans chaque verre."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Bloody Mary",
                  "paragraph": "Garnissez avec le céleri et les oignons grelots, puis saupoudrez d'un peu de sel et de poivre. Servez immédiatement."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Note",
                  "paragraph": "Pour une portion individuelle, versez 165 ml de mélange Bloody Mary dans un verre et ajoutez 25 ml de vodka et beaucoup de gla"
                }
              }
            }
          ]
        }
