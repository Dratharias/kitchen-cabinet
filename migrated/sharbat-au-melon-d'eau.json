          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Sharbat Au Melon D Eau",
                  "paragraph": "Émietter le sel dans un verre haut, ajouter le jus de lime et laisser reposer pendant 30 secondes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Sharbat Au Melon D Eau",
                  "paragraph": "Ajouter le sirop de sucre et la purée de pastèque."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Sharbat Au Melon D Eau",
                  "paragraph": "Prenez le brin de menthe, posez-le sur une paume et donnez-lui un coup sec avec votre autre main. La pression brève et la chaleur de vos mains feront ressortir les huiles. Ajoutez-les au verre."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Sharbat Au Melon D Eau",
                  "paragraph": "Ajoutez autant de glaçons que possible dans le verre, puis complétez avec de l'eau gazeuse. Remuez et servez immédiatement, garni d'un petit morceau de pastèque."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Sharbat À La Passion",
                  "paragraph": "Remplacez la purée de pastèque par de la purée de fruit de la passion. Utilisez soit une marque de bonne qualité, comme Boiron (qui peut être conservée au congélateur après ouverture), soit passez de la pulpe de fruit de la passion fraîche à travers un tamis, en utilisant 1 fruit de la passion par portion. Utilisez des feuilles de géranium odorant si vous en avez, au lieu de la menthe, et garnissez avec un quartier de lime."
                }
              }
            }
          ]
        }
      ]
