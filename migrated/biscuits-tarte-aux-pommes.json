          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Garniture De Tarte Aux Pommes",
                  "paragraph": "Ajoutez-les pommes dans une poêle avec le beurre, à feu moyen pendant 5 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Garniture De Tarte Aux Pommes",
                  "paragraph": "Ajoutez les ingrédients sauf la fécule de maïs. Laissez mijoter pendant 5 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Garniture De Tarte Aux Pommes",
                  "paragraph": "Ajoutez la fécule et laissez mijoter pendant 5 minutes supplémentaires."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Assemblage",
                  "paragraph": "Utilisez un couvercle de bocal en verre pour découper des cercles dans une pâte à tarte."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Assemblage",
                  "paragraph": "Étalez les restes et coupez-les en lanières égales (pour la couche supérieure). Ajoutez une cuillerée de garniture de tarte aux pommes aux cercles de mini-tarte."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Assemblage",
                  "paragraph": "Couvrez avec les lanières de pâte à tarte. Enrobez d'un œuf battu."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Assemblage",
                  "paragraph": "Faites cuire à 350 degrés pendant 30 à 35 minutes."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Glaçage Au Beurre Noisette",
                  "paragraph": "Faites brunir le beurre à feu moyen. Une fois doré, ajoutez le reste des ingrédients. Ajoutez le glaçage aux biscuits refroidis."
                }
              }
            }
          ]
        }
