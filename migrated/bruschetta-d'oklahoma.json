          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Bruschetta D Oklahoma",
                  "paragraph": "Préparez un gril pour la cuisson directe et préchauffez à feu moyen-vif. Brossez et huilez la grille du gril."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Bruschetta D Oklahoma",
                  "paragraph": "Coupez la baguette en tranches diagonales d'épaisseur d'un doigt. Badigeonnez légèrement chaque tranche des deux côtés avec du beurre fondu ou du gras de bacon."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Bruschetta D Oklahoma",
                  "paragraph": "Préparez la crème à la moutarde chinoise: Combinez la mayonnaise, la moutarde et la sriracha dans un bol et fouettez pour mélanger."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Bruschetta D Oklahoma",
                  "paragraph": "Disposez les tranches de pain sur la grille et faites griller le pain jusqu'à ce qu'il soit doré des deux côtés, 1 à 2 minutes par côté."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Bruschetta D Oklahoma",
                  "paragraph": "Transférez le pain grillé sur un plat. Étalez chaque tranche avec de la Confiture De Bacon. Garnissez d'une cuillerée de crème à la moutarde chinoise et de quelques tranches d'oignons verts."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Note",
                  "paragraph": "Pour une variation intéressante, substituez du pain de maïs à la baguette. Comme le pain de maïs est plus friable que le pain français, il est préférable de le griller dans un panier à griller."
                }
              }
            }
          ]
        }
      ]
