          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Chauffez une poêle sèche à feu moyen. Ajoutez les graines de sésame blanc et faites-les griller, en remuant de temps en temps, jusqu'à ce qu'elles soient parfumées et dorées, environ 2 à 4 minutes. Transférez les graines de sésame dans un bol et laissez refroidir."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez les graines de sésame noir, le sel et le poivre. Transférez dans un bocal, couvrez et conservez à l'abri de la chaleur et de la lumière. Le sel se conservera plusieurs semaines."
                }
              }
            }
