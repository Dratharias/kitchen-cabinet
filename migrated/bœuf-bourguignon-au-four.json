          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Préparation",
                  "paragraph": "Préchauffer le four à 160°C (320°F)."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Préparation",
                  "paragraph": "Dans une cocotte, chauffer un filet d'huile et faire dorer les cubes de bœuf sur toutes les faces. Réserver."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Préparation",
                  "paragraph": "Faire revenir oignons, carottes, panais, ail et pâte de tomate dans la cocotte pendant 5-6 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Préparation",
                  "paragraph": "Déglacer avec le vin rouge, gratter le fond, et laisser réduire quelques minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Préparation",
                  "paragraph": "Ajouter les patates, la viande, le bouillon, le thym et le laurier. Saler, poivrer."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Cuisson",
                  "paragraph": "Couvrir la cocotte et enfourner pour 2h30 à 3h."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Cuisson",
                  "paragraph": "Ajouter les champignons dans la dernière heure de cuisson."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Cuisson",
                  "paragraph": "Découvrir pour la dernière demi-heure si on veut épaissir la sauce."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Finition Et Service",
                  "paragraph": "Griller les tranches de pain (optionnel : frotter avec de l'ail)."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Finition Et Service",
                  "paragraph": "Parsemer le plat de persil frais avant de servir."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Finition Et Service",
                  "paragraph": "Servir chaud avec le pain en accompagnement."
                }
              }
            }
          ]
        }
