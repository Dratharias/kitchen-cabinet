          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Tranchez l'oignon rouge en fines demi-lunes et plongez-les dans un bol d'eau froide."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Émincez le chou aussi finement que possible, en utilisant soit un couteau bien aiguisé, soit une mandoline, et placez-le dans un grand bol. (Ne le râpez pas, car cela rendra la salade humide.)"
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Coupez le poivron rouge en fines allumettes longues et ajoutez-les au bol, ainsi que 2 cuil. à soupe de graines de grenade."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Empilez les feuilles de menthe les unes sur les autres, puis roulez-les en forme de petit cigare. Utilisez votre couteau pour les trancher finement, ce qui créera des rubans. Ajoutez-les au bol."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Déchirez délicatement les feuilles de coriandre dans le bol. Égouttez les oignons rouges, tamponnez-les avec du papier absorbant et ajoutez-les également à la salade."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez la mayonnaise et la confiture de tomate-piment et mélangez bien pour combiner."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Servez la salade garnie de quelques graines de grenade et de feuilles de coriandre."
                }
              }
            }
          ]
        }
      ]
