          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "paragraph": "Écraser le fruit dans un bocal avec l'eau et le sucre."
              }
            },
            {
              "position": 2,
              "segment": {
                "paragraph": "Couvrir d'un tissu, remuer 2 fois par jour."
              }
            },
            {
              "position": 3,
              "segment": {
                "paragraph": "En 3 à 6 jours, filtrer quand ça pétille et sent bon."
              }
            }
