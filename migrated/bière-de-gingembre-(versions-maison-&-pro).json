        {
          "total_prep_time": 10,
          "servings": null,
          "subtitle": "Levain De Gingembre",
          "is_ingredient": true,
          "content_ingredients": [
            {
              "quantity": 250,
              "multiply_factor": 1,
              "product": {
                "name": "eau"
              },
              "ingredient_units": [
                {
                  "unit": {
                    "name": "ml"
                  }
                }
              ]
            },
            {
              "quantity": 10,
              "multiply_factor": 1,
              "product": {
                "name": "gingembre"
              },
              "ingredient_units": [
                {
                  "unit": {
                    "name": "g"
                  }
                }
              ],
              "cut": "haché"
            },
            {
              "quantity": 10,
              "multiply_factor": 1,
              "product": {
                "name": "sucre"
              },
              "ingredient_units": [
                {
                  "unit": {
                    "name": "g"
                  }
                }
              ]
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "paragraph": "Dans un pot propre, mélanger eau, sucre et gingembre."
              }
            },
            {
              "position": 2,
              "segment": {
                "paragraph": "Laisser à température pièce (21–30°C), à l'abri de la lumière."
              }
            },
            {
              "position": 3,
              "segment": {
                "paragraph": "Chaque jour, pendant 3 à 5 jours, ajouter 10g de gingembre et 10g de sucre."
              }
            },
            {
              "position": 4,
              "segment": {
                "paragraph": "Quand ça mousse et sent bon, c'est prêt. Filtrer avant usage."
              }
            }
          ]
        },
        {
          "total_prep_time": 10,
