          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Dans un petit bol, mélanger les ingrédients de la sauce et réserver."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Cuire les nouilles soba selon l'emballage dans une eau bien salée."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Rincez les nouilles soba sous l'eau courante froide pour les refroidir et les empêcher de cuire, sinon elles deviendront pâteuses."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Pendant ce temps, préparez votre concombre à l'aide d'un outil à julienne ou en allumettes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Une fois les nouilles rincées, remettre dans la casserole dans laquelle elles ont cuit, ajouter le concombre, la coriandre et environ les 3/4 de la sauce, bien mélanger."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Dans un plat à portion individuelle, ajouter des nouilles, garnir avec un peu de la sauce restante et saler et poivrer au goût."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Ajoutez une bonne quantité de jus de citron vert, toujours au goût."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Nouilles Soba Concombre Gingembre",
                  "paragraph": "Servir chaud ou froid."
                }
              }
            }
          ]
        }
