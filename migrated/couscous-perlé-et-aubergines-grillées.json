          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Couscous Perlé Et Aubergines Grillées",
                  "paragraph": "Préchauffer le four à 240 °C (475 °F), placer la grille au centre du four. Tapisser une plaque de cuisson d'un tapis de silicone.   "
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Couscous Perlé Et Aubergines Grillées",
                  "paragraph": "Arroser généreusement les rondelles d'aubergine d'huile et les assaisonner. Déposer sur la plaque et enfourner 25 minutes en les retournant à la mi-cuisson.   "
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Couscous Perlé Et Aubergines Grillées",
                  "paragraph": "Entre-temps, prélever le zeste des oranges et les réserver. Dans une casserole, porter à ébullition le jus des oranges, le cari et le bouillon de légumes. Ajouter le couscous, mélanger, réduire le feu à doux, couvrir à demi et cuire 8 minutes ou jusqu'à tendreté.  "
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Couscous Perlé Et Aubergines Grillées",
                  "paragraph": "Dans une petite poêle, chauffer doucement la moitié de l'huile et ajouter l'ail, les câpres, le poivron, l'échalote, les raisins et le cumin. Cuire 5 minutes, retirer du feu et ajouter le reste de l'huile et assaisonner au goût. Réserver.  "
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Couscous Perlé Et Aubergines Grillées",
                  "paragraph": "Dans un petit bol, déposer les zestes d'orange réservés, la menthe hachée finement et les amandes. Mélanger.  "
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Couscous Perlé Et Aubergines Grillées",
                  "paragraph": "Servir une portion de couscous, une ou deux rondelles d'aubergine et arroser de la sauce. Terminer avec la garniture."
                }
              }
            }
          ]
        }
      ]
    }
