          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Saupoudrez les steaks de thon des deux côtés avec la moitié de la marinade sèche. Couvrez et laissez mariner au réfrigérateur pendant 30 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Préparez un gril pour une cuisson directe et préchauffez à haute température. Brossez et huilez la grille du gril. Si vous utilisez une plancha ou une poêle en fonte, placez-la sur la grille du gril et préchauffez."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Badigeonnez chaque steak de thon des deux côtés avec du beurre fondu, puis saupoudrez avec le reste de la marinade sèche."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Placez le thon sur la grille (ou sur la plancha) et grillez jusqu'à ce qu'il soit sombrement saisi à l'extérieur, mais encore rare (voire cru) au centre, environ 2 minutes de chaque côté, en retournant avec des pinces. Transférez le thon sur un plat et versez la sauce sur le dessus."
                }
              }
            }
          ]
        }
      ]
