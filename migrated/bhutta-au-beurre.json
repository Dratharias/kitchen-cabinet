          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "Préchauffez votre gril à feu vif ou chauffez le barbecue."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "Portez une casserole d'eau à ébullition. Ajoutez les épis de maïs et le sel et faites revenir à ébullition. Cuire pendant 3 minutes, puis égouttez et séchez avec du papier absorbant."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "À l'aide d'un hachoir ou d'un couteau robuste, coupez chaque épi de maïs en deux."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "Enrobez le maïs de beurre fondu à l'aide d'un pinceau à pâtisserie. Grillez jusqu'à ce que le maïs soit bien carbonisé de tous côtés, en tournant et en badigeonnant de beurre fondu toutes les 2 à 3 minutes. Essayez de construire progressivement la couleur plutôt que de brûler le maïs."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "Pendant que le maïs grille, mélangez la poudre de chili et le sel de mer."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "Pour finir, trempez un quartier de lime dans le mélange de sel et de chili et frottez sur toute la surface d'un morceau de maïs. Répétez avec les autres morceaux de maïs et les quartiers de lime."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Bhutta Au Beurre",
                  "paragraph": "Servez le maïs avec le mélange de sel et de chili restant et les quartiers de lime épicés. Fournissez beaucoup de serviettes en papier."
                }
              }
            }
          ]
        }
      ]
