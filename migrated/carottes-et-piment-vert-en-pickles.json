          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Coupez les carottes en bâtonnets, environ 4 x 1 cm, et mettez-les de côté."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Chauffez l'huile dans une petite casserole à feu moyen-élevé. Ajoutez les graines de moutarde, les graines d'oignon et les graines de fenouil et faites sauter pendant 20 secondes. Ajoutez les piments verts, les épices moulues et le sel et faites sauter pendant 20 secondes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez les bâtonnets de carottes et le vinaigre de riz dans la casserole et mélangez bien. Réduisez légèrement le feu, mettez le couvercle et laissez mijoter pendant 4 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Transférez dans un bol ou un bocal et laissez refroidir complètement avant de servir. Idéalement, laissez le pickle reposer au réfrigérateur pendant une journée avant de servir pour permettre aux saveurs de se mêler. Il se conserve au réfrigérateur pendant 2-3 jours."
                }
              }
            }
          ]
        }
