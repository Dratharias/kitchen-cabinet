          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une grande casserole non réactive, combinez tous les ingrédients. Portez à ébullition à feu moyen, en remuant constamment pour dissoudre le sucre."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Réduisez le feu et laissez mijoter la sauce, à découvert, jusqu'à ce qu'elle soit épaisse et riche en saveurs, environ 15 à 20 minutes. Remuez souvent pour éviter que la sauce ne brûle."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Utilisez immédiatement ou transférez dans un grand bocal, couvrez, laissez refroidir à température ambiante et réfrigérez. La sauce se conservera plusieurs semaines."
                }
              }
            }
          ]
