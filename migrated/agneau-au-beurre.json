          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une grande poêle, chauffez l'huile à feu moyen-élevé. Ajoutez l'agneau et faites cuire pendant 5 minutes jusqu'à ce qu'il change de couleur."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez la pâte de gingembre et d'ail, faites cuire pendant quelques minutes jusqu'à ce qu'elle devienne parfumée."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez de l'eau, faites cuire à couvert pendant environ 15 minutes, jusqu'à ce que la viande soit à moitié cuite."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez les épices, le yaourt et les tomates écrasées. Laissez mijoter à couvert pendant environ 15 minutes jusqu'à ce que la viande ramollisse."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Incorporez la crème épaisse et le kasoori methi. Faites cuire jusqu'à ce que l'huile se sépare, environ 15 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Garnissez de beurre, de crème et de coriandre."
                }
              }
            }
          ]
        }
      ]
