              "position": 6,
              "segment": {
                "data": {
                  "title": "Gingembre",
                  "paragraph": "Répartir sur du papier, linge, etc. Laisser refroidir complètement et sécher."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Vinaigre",
                  "paragraph": "Dans une casserole, mélanger le vinaigre de riz, sucre et sel."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Vinaigre",
                  "paragraph": "Mélanger et amener la solution à ébullition jusqu'à ce que l'odeur forte de vinaigre s'évapore et que le sucre soit complètement dissout."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Vinaigre",
                  "paragraph": "Lorsque le vinaigre à refroidit, mettre le gingembre dans un pot stérile et verser le vinaigre."
                }
              }
            }
          ]
