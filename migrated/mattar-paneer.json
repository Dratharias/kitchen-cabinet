          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Mattar Paneer",
                  "paragraph": "Réchauffez le masala oignon-tomate dans une casserole moyenne à feu moyen. Ajoutez le sel, la purée de tomates, le sucre, le garam masala et le cumin. Portez à frémissement doux et laissez cuire pendant 10 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Mattar Paneer",
                  "paragraph": "Ajoutez les petits pois surgelés et 120ml d'eau, ramenez à frémissement doux et laissez cuire pendant 5 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Mattar Paneer",
                  "paragraph": "Ajoutez les cubes de paneer et remuez délicatement pour qu'ils ne se cassent pas. Laissez mijoter doucement pendant 10 minutes, en remuant de temps en temps."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Mattar Paneer",
                  "paragraph": "Ajoutez la crème, portez à ébullition et retirez du feu. Servez garni de coriandre hachée, avec un bol de kachumber à côté."
                }
              }
            }
          ]
        }
      ]
