          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 400°F (200°C). Commencer la cuisson des pâtes dès que possible."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer à feu doux une poêle avec un fond d'huile d'olive pour qu'elle soit chaude, le fond de la poêle doit être couvert de 1 à 2 millimètres d'huile."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Pendant ce temps, couper des rondelles d'environ 1cm à 1,5cm dans le pied des champignons king. Quadriller les rondelles au couteau, environ un quart de l'épaisseur de la rondelle, de chaques côtés. Hacher les têtes de champignons."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Dans une autre poêle, dorer les têtes de champignons dans du beurre et de l'huile, avec une gousse d'ail hachée. Saler, poivrer"
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Déposer les rondelles dans la poêle et augmenter la température pour les faires dorés d'un côté. Saler, poivrer. S'il manque d'huile, en ajouter. Tourner les rondelles et poursuivre la cuisson 1 à 2 minutes pour les saisirs. Saler, poivrer."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le beurre et 2 gousses d'ail hachées dans la poêle des rondelles, et enfourner pour 5 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Déglacer les deux poêles avec du vin. ¾ tasse pour les rondelles, laisser réduire au quart. ¼ tasse pour les têtes, laisser réduire entièrement. Réserver dans une assiette les pétoncles et retirer les têtes de champignons du feu."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les pâtes cuites dans la poêle de réduction de beurre au vin et à l'ail, saler, poivrer."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le jus d'un demi citron et son zeste, le persil, les noix de pin torréfiées, goûter et rectifier l'assaisonnement."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "paragraph": "Servir avec du parmesan."
                }
              }
            }
          ]
        }
      ]
