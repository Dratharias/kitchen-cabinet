          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Placez les côtelettes d'agneau dans un plat peu profond. Pour la première marinade, mélangez tous les ingrédients dans un petit bol. Frottez la marinade sur les côtelettes, couvrez et réfrigérez pendant 2 heures."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Pendant que les côtelettes sont au réfrigérateur, préparez la deuxième marinade. Chauffez une poêle à fond épais à feu moyen. Ajoutez les graines de cumin et de coriandre ainsi que la gousse et faites-les griller pendant 2 minutes, en secouant la poêle pour éviter qu'ils ne brûlent. Versez-les directement dans votre mortier et laissez refroidir."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Mixez tous les autres ingrédients de la marinade jusqu'à obtenir une pâte, en utilisant un blender ou un mini robot culinaire."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Moudre les épices grillées refroidies en une poudre grossière et ajoutez-la à la pâte."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Lorsque le temps de la première marinade est écoulé, sortez les côtelettes du réfrigérateur et enrobez-les de la deuxième marinade. Couvrez et réfrigérez pendant 24 heures."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Préchauffez le gril à feu vif et sortez les côtelettes du réfrigérateur. Secouez-les à nouveau pour assurer un enrobage uniforme de la marinade. Placez-les sur une plaque à pâtisserie recouverte de papier d'aluminium et badigeonnez-les de beurre fondu."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Grillez les côtelettes pendant 2 à 3 minutes, jusqu'à ce qu'elles commencent à grésiller. Retournez-les, badigeonnez-les de beurre fondu et faites-les griller encore 2 à 3 minutes. Répétez l'opération jusqu'à ce qu'elles soient joliment caramélisées."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Côtelettes D Agneau Épicées",
                  "paragraph": "Laissez reposer les côtelettes pendant 3 minutes avant de servir, parsemées de feuilles de menthe ou de coriandre et de graines de grenade, si vous le souhaitez."
                }
              }
            }
          ]
        }
      ]
