          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Jarrets D Agneau",
                  "paragraph": "Placer les pieds d'agneau dans une grande casserole, couvrir d'eau bouillante et laisser reposer pendant 5 minutes, puis égoutter."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Jarrets D Agneau",
                  "paragraph": "Écraser le bâton de cannelle en morceaux à l'aide d'un pilon et d'un mortier. Attacher les graines de fenouil et de coriandre, la feuille de laurier et la moitié du bâton de cannelle écrasé dans un morceau de mousseline avec de la ficelle de cuisine pour faire un potli (paquet d'épices)."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Jarrets D Agneau",
                  "paragraph": "Remettre les pieds d'agneau égouttés dans la casserole et ajouter le potli et l'ail haché. Verser suffisamment d'eau bouillante pour couvrir confortablement. Porter à ébullition à feu moyen et laisser mijoter pendant 1 1/2 heure, ou jusqu'à ce que les pieds soient très tendres mais ne se désagrègent pas."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Oignons",
                  "paragraph": "Pendant ce temps, chauffer 60 ml d'huile dans une casserole à feu moyen. Ajouter les oignons blancs et cuire en remuant régulièrement, jusqu'à ce qu'ils soient tendres et brun foncé, environ 30 minutes. S'ils commencent à coller, ajouter un peu d'eau. Transférer dans un mélangeur ou un mini robot culinaire et mixer jusqu'à obtention d'une pâte."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Épices",
                  "paragraph": "Une fois cuits, retirer les pieds d'agneau sur une assiette. Passer le bouillon au tamis dans un bol ; jeter les résidus."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Épices",
                  "paragraph": "À l'aide d'un moulin à épices ou d'un mortier et d'un pilon, réduire en poudre fine 1 gousse, 1/2 cuil. à thé de grains de poivre noir, 1/4 cuil. à thé de graines de cumin, 4 gousses de cardamome verte et la moitié de la cannelle restante. À l'aide d'un mélangeur ou d'un mini robot culinaire, mixer la poudre d'épices avec les oignons rouges, les gousses d'ail entières et le gingembre haché jusqu'à obtention d'une pâte fine ; réserver."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Chauffer les 100 ml d'huile restants dans une grande casserole à feu moyen-vif. Ajouter le reste de la cannelle et des épices entières et laisser grésiller pendant 10 secondes, puis baisser le feu à moyen et ajouter la pâte d'ail. Faire sauter pendant 3 minutes jusqu'à ce qu'elle soit dorée, en remuant presque constamment."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Ajouter les jarrets d'agneau et faire sauter pendant 3 minutes, puis ajouter la pâte d'oignons rouges épicée. Faire sauter, en remuant régulièrement, pendant 15 à 20 minutes jusqu'à ce que la pâte soit bien cuite et libère son huile. Si la pâte commence à coller avant d'être prête, baisser un peu le feu et gratter le fond de la casserole ; elle arrêtera de coller une fois qu'elle aura libéré un peu d'huile."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Ajouter le piment en poudre, la coriandre moulue, le curcuma et le sel et cuire pendant 10 minutes. Ajouter un peu d'eau (environ 2 cuil. à soupe) lorsque le mélange commence à coller pour éviter qu'il ne brûle."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Ajouter le yogourt et cuire jusqu'à ce que l'huile se sépare complètement, environ 10 minutes. Ajouter la pâte d'oignons dorés et cuire pendant 3 minutes."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Ajouter 600 à 700 ml du bouillon de pieds d'agneau réservé (suffisamment pour couvrir les morceaux de jarret) et laisser mijoter jusqu'à ce qu'ils soient complètement tendres, environ 1 1/2 heure."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Finalisation Et Service",
                  "paragraph": "Ajouter les pieds d'agneau cuits et encore 400 ml de bouillon dans la casserole et laisser mijoter pendant 15 minutes. Ajouter le garam masala et le jus de lime, bien mélanger et retirer du feu."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Finalisation Et Service",
                  "paragraph": "Pour servir, répartir les pieds et la viande de jarret dans des bols de service. Verser beaucoup de sauce et parsemer avec certains des ingrédients de la garniture. Servir le reste de la garniture et du pain sur le côté."
                }
              }
            }
          ]
        }
      ]
    }
  }
