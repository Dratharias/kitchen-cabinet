          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four à 375°F (190°C). Bien huiler (ou mettre des moules en papier) 8 moules à muffins."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol, combinez le sucre, l'œuf, l'huile, le lait et la vanille dans un bol et mélanger jusqu'à homogénéité."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Dans un autre bol, combinez la farine, la poudre à pâte et le sel."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les ingrédients secs aux ingrédients humides."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter la crème sure et mélanger."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les pépites et mélanger, puis les bleuets et mélanger."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Diviser de façon égale dans les moules à muffins. Faire cuire les muffins pendant 25 minutes. Ajouter 5 minutes, si vous utilisez des bleuets congelés."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Sortir du four lorsque l'insertion d'un cure-dent en ressort propre."
                }
              }
            }
          ]
        }
