          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une casserole, faire fondre le beurre à feu moyen. Ajouter la farine et remuer pour former un roux. Laisser cuire pendant 1 à 2 minutes, en veillant à ne pas laisser le roux brunir."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le lait progressivement tout en continuant à remuer pour éviter les grumeaux. Continuer à remuer jusqu'à ce que la sauce épaississe, ce qui prendra environ 5 minutes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Assaisonner la sauce avec du sel, du poivre, de la poudre d'ail, du poivre de Cayenne et du gingembre moulu. Ajuster les assaisonnements selon vos préférences."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les fromages (cheddar fort, gruyère et mozzarella) à la sauce et remuer jusqu'à ce qu'ils soient fondus et que la sauce soit lisse."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Pendant ce temps, cuire les macaronis selon les instructions sur l'emballage jusqu'à ce qu'ils soient al dente. Égoutter les macaronis."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Incorporer les macaronis cuits dans la sauce au fromage, en veillant à bien les enrober de la sauce crémeuse."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Préchauffer le four en mode gril."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Transférer le mélange macaroni et fromage dans un plat de cuisson. Saupoudrer de fromage cheddar fort sur le dessus."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Placer le plat sous le gril du four pendant quelques minutes, jusqu'à ce que le fromage soit fondu et commence à dorer."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "paragraph": "Garnir de ciboulette fraîche hachée avant de servir."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "paragraph": "Dégustez votre délicieux macaroni au fromage gratiné fait maison !"
                }
              }
            }
          ]
        }
