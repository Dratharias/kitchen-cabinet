          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Méthode Au Fouet",
                  "paragraph": "Combinez la moutarde, le sel, le poivre et le vinaigre dans un bol lourd et fouettez pour mélanger. Incorporez progressivement l'huile en un filet très fin; la sauce doit s'épaissir. Incorporez le jus de citron et les herbes. Corrigez l'assaisonnement, en ajoutant plus de sel ou de vinaigre."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Méthode En Bocal",
                  "paragraph": "Combinez tous les ingrédients dans un bocal avec un couvercle hermétique. Secouez vigoureusement jusqu'à ce que le mélange soit homogène."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Méthode Au Blender",
                  "paragraph": "Combinez la moutarde, le sel, le poivre, le vinaigre et le jus de citron dans un blender et mélangez pour combiner. Ajoutez l'huile par le trou dans le couvercle du blender, en faisant tourner le blender à basse puis à moyenne vitesse. Arrêtez le blender et incorporez les herbes à la main."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Remarque",
                  "paragraph": "Quelle que soit la méthode que vous utilisez, la vinaigrette est meilleure lorsqu'elle est servie dans les quelques heures suivant sa préparation. Secouez ou fouettez bien avant d'utiliser."
                }
              }
            }
          ]
        }
      ]
