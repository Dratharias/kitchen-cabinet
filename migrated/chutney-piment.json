          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Mettre les piments séchés dans un bol et verser suffisamment d'eau bouillante pour les couvrir. Laisser tremper pendant 10 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Pendant ce temps, mettre les graines de coriandre et de cumin dans une poêle sèche et placer sur un feu moyen. Laisser chauffer et griller pendant 1-2 minutes, jusqu'à ce qu'elles soient parfumées."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Égoutter les piments et presser pour enlever l'eau restante (en portant des gants, ou le faire entre deux cuillères, pour protéger vos mains)."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Mixer tous les ingrédients ensemble dans un blender ou un mini robot culinaire jusqu'à obtenir un liquide lisse et épais. Couvrir et réfrigérer jusqu'à ce que ce soit prêt à servir. Le chutney se conserve jusqu'à 5 jours au réfrigérateur."
                }
              }
            }
          ]
        }
      ]
