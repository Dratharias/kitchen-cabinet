          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Potage De Panais Et Vanille",
                  "paragraph": "Faites chauffer l'huile dans une casserole à feu moyen, puis faites suer les échalotes et l'ail jusqu'à ce qu'ils soient translucides. Assaisonner de sel et poivre puis ajouter les panais et le thym"
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Potage De Panais Et Vanille",
                  "paragraph": "Baissez le feu très doux et couvrez la casserole. Laissez les panais cuire jusqu'à ce qu'ils soient presque tendres, en remuant souvent. Ajoutez ensuite votre bouillon et votre lait."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Potage De Panais Et Vanille",
                  "paragraph": "Fendez votre gousse de vanille au milieu dans le sens de la longueur et à l'aide du dos de votre couteau, grattez les graines. Ajoutez les graines et la gousse dans la casserole."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Potage De Panais Et Vanille",
                  "paragraph": "Portez la soupe à ébullition puis retirez du feu et récupérez également la gousse de vanille."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Potage De Panais Et Vanille",
                  "paragraph": "Ajoutez délicatement le mélange dans votre mixeur et mixez. Une fois lisse, remettez la soupe dans votre casserole et vérifiez l'assaisonnement, ajoutez du sel, du poivre et le jus de citron pour faire ressortir les saveurs."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Potage De Panais Et Vanille",
                  "paragraph": "Servir avec des noisettes, des herbes, des canneberges et un filet d'huile d'olive de bonne qualité."
                }
              }
            }
          ]
        }
      ]
