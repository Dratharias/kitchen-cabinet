          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Taillez les filets de poisson en goujonnettes, c'est-à-dire en bâtonnets de la taille d'un doigt."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Préparez 3 bols, un de farine, un d'oeuf battu avec un peu d'eau ou de lait et finalement un contenant la chapelure."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Assaisonnez les goujonnettes de sel et de piment, roulez-les ensuite dans la farine, puis dans l'oeuf et enfin dans la chapelure."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Faites frire les goujonnettes dans la friteuse à 190°C (375°F) jusqu'à une belle coloration dorée."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez une pincée de sel dès la sortie de la friteuse."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Servir avec l'aïoli."
                }
              }
            }
          ]
