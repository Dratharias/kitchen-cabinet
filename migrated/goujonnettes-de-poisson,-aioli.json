          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol, mettez le jaune d'oeuf, la moutarde, l'ail, le vinaigre, une pincée de sel et mélangez bien, tout en écrasant l'ail."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Versez l'huile en filet très fin tout en fouettant pour créer une émulsion."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Vérifiez ensuite l'assaisonnement."
                }
              }
            }
          ]
