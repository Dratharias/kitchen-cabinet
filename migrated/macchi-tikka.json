          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Macchi Tikka",
                  "paragraph": "Sécher le poisson avec du papier absorbant et le placer dans un plat peu profond. Mélanger les ingrédients de la première marinade et badigeonner le poisson. Couvrir et réfrigérer pendant la préparation de la deuxième marinade."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Macchi Tikka",
                  "paragraph": "Faire chauffer l'huile dans une petite poêle à feu moyen. Ajouter l'ail et faire revenir jusqu'à ce qu'il soit légèrement doré, 7-8 minutes. Retirer l'ail haché à l'aide d'un petit tamis et égoutter sur du papier absorbant; réserver."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Macchi Tikka",
                  "paragraph": "Chauffer une poêle sèche à feu moyen. Ajouter la farine de pois chiche et griller jusqu'à ce qu'elle soit dorée, en remuant régulièrement pour qu'elle ne brûle pas. Verser dans un grand bol et laisser refroidir, puis ajouter l'ail frit et tous les autres ingrédients de la deuxième marinade. Bien mélanger."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Macchi Tikka",
                  "paragraph": "Disposer le poisson sur une grande assiette, côté peau vers le bas (s'il a la peau). Appliquer la deuxième marinade sur la chair du poisson (en garniture), couvrir soigneusement de film alimentaire et réfrigérer pendant 2 heures."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Macchi Tikka",
                  "paragraph": "Préchauffer le gril à feu vif. Transférer le poisson sur une plaque à pâtisserie et badigeonner de beurre fondu. Griller pendant 3 minutes, arroser à nouveau de beurre, puis griller jusqu'à ce qu'il soit bien caramélisé et que le poisson soit juste cuit, 3-5 minutes de plus."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Macchi Tikka",
                  "paragraph": "Servir le poisson grillé immédiatement, accompagné de coriandre, d'oignon rouge et de quartiers de lime."
                }
              }
            }
          ]
        }
      ]
