          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "Chauffer une poêle profonde à feu moyen-élevé."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "Ajouter l'huile et laisser chauffer quelques secondes."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "Ajouter les oignons et les faire revenir en remuant fréquemment."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "Laisser les oignons mijoter et libérer leur eau."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "Continuer à cuire jusqu'à ce que les oignons soient tendres et brun foncé (environ 25-30 minutes)."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "Remuer constamment et ajouter un peu d'eau si nécessaire pour éviter de brûler."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Caraméliser Les Oignons 25 30 Minutes",
                  "paragraph": "(Optionnel) Vous pouvez filtré l'huile dans avec un tamis et utiliser l'huile pour des vinaigrettes et sauces"
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Préparer La Sauce Tomate Environ 45 Minutes",
                  "paragraph": "Ajouter les pâtes d'ail et de gingembre aux oignons caramélisés et faire sauter jusqu'à ce qu'ils soient dorés clair."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Préparer La Sauce Tomate Environ 45 Minutes",
                  "paragraph": "Incorporer le piment en poudre, la purée de tomates et le sel."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Préparer La Sauce Tomate Environ 45 Minutes",
                  "paragraph": "Ajouter les tomates hachées et remuer."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Préparer La Sauce Tomate Environ 45 Minutes",
                  "paragraph": "Laisser mijoter pendant environ 20 minutes en remuant régulièrement."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Préparer La Sauce Tomate Environ 45 Minutes",
                  "paragraph": "Les tomates doivent se décomposer et légèrement caraméliser."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Préparer La Sauce Tomate Environ 45 Minutes",
                  "paragraph": "Ajuster la consistance avec de l'eau si nécessaire."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Conserver La Sauce",
                  "paragraph": "Transférer la sauce non utilisée dans un bocal propre."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Conserver La Sauce",
                  "paragraph": "Couvrir et laisser refroidir."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Conserver La Sauce",
                  "paragraph": "Conserver au réfrigérateur et utiliser dans la semaine."
                }
              }
            },
            {
              "position": 17,
              "segment": {
                "data": {
                  "title": "Conserver La Sauce",
                  "paragraph": "La sauce peut également être congelée en portions individuelles."
                }
              }
            },
            {
              "position": 18,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Utilisez une poêle à fond épais pour une meilleure répartition de la chaleur."
                }
              }
            },
            {
              "position": 19,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Ne laissez pas les oignons brûler, car cela donnerait un goût amer à la sauce."
                }
              }
            },
            {
              "position": 20,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Assurez-vous que les tomates sont bien cuites et caramélisées pour une saveur optimale."
                }
              }
            },
            {
              "position": 21,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Ajustez la quantité de piment en poudre selon votre goût."
                }
              }
            },
            {
              "position": 22,
              "segment": {
                "data": {
                  "title": "Conseils",
                  "paragraph": "Cette sauce peut être utilisée pour accompagner des pâtes, du riz, des légumes ou de la viande."
                }
              }
            }
          ]
        }
