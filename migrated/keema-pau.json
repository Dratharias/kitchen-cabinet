          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Râper le gingembre et l'ail, à l'aide d'une microplane ou de la section la plus fine de votre râpe, dans un petit bol ; mettre de côté."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Mixer les oignons verts, la coriandre, la menthe et 10g de piment vert haché ensemble pour faire une pâte, à l'aide d'un mélangeur ou d'un mini robot culinaire."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Chauffer l'huile dans une grande casserole à feu moyen. Ajouter l'oignon et faire revenir doucement pendant 5 minutes, en remuant régulièrement, sans les laisser brunir. Ajouter le gingembre râpé et l'ail et cuire pendant 2 minutes, en remuant presque constamment. Ajouter la coriandre moulue et cuire pendant 2–3 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Augmenter le feu, incorporer le yogourt et faire sauter pendant 3 minutes, à ce stade le yogourt devrait commencer à se séparer. Baisser le feu à moyen, ajouter l'agneau haché, le sel et les feuilles de laurier et bien mélanger. Faire sauter, en remuant régulièrement, jusqu'à ce que l'humidité commence à quitter la viande, puis saupoudrer la farine sur la surface et bien remuer ; cela aide à emprisonner l'humidité."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Ajouter la pâte verte, baisser le feu au minimum et laisser mijoter doucement pendant 20 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Ajouter les pois et les piments verts entiers et laisser mijoter à feu très doux pendant encore 15 minutes, en remuant de temps en temps. Lorsque le temps est écoulé, mettre le couvercle, éteindre le feu et laisser le keema reposer pendant 10 minutes avant de servir."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Faire griller légèrement et beurrer les côtés coupés des petits pains."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Keema Pau",
                  "paragraph": "Répartir le keema entre 3 ou 4 bols et garnir d'oignon rouge et de coriandre. Servir avec les petits pains grillés et les quartiers de lime."
                }
              }
            }
          ]
        }
      ]
