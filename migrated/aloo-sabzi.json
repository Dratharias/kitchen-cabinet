          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Faites bouillir les pommes de terre dans de l'eau salée jusqu'à ce qu'elles soient juste tendres. Égouttez et laissez refroidir, puis coupez-les en petits morceaux."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Dans un petit bol, mélangez la coriandre moulue, la poudre de piment, le curcuma, le poivre noir et le sel. Mettez de côté."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Placez une grande casserole sur feu moyen, ajoutez l'huile et laissez-la chauffer, puis ajoutez les graines de cumin. Laissez-les crépiter pendant 20 secondes, puis ajoutez l'asafoetida et remuez bien. Ajoutez le gingembre haché et les piments verts entiers et remuez à nouveau."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Ajoutez le mélange d'épices secs et faites cuire en remuant pendant 1 minute, puis versez 700ml d'eau bouillante."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Ajoutez les pommes de terre cuites, en en émiettant environ la moitié avec vos mains pendant que vous le faites. Ajoutez les pois chiches, puis baissez le feu pour laisser mijoter vivement. Laissez cuire pendant 15 minutes en remuant régulièrement."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Ajoutez le garam masala, le fenugrec, l'amchur et la coriandre hachée. Remuez bien et laissez cuire encore 2 minutes."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Incorporez le beurre, le paneer et le jus de citron vert, laissez sur le feu pendant 1 minute, puis éteignez le feu."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Aloo Sabzi",
                  "paragraph": "Servez le curry chaud garni de coriandre, d'oignon rouge haché et d'une cuillerée de yaourt. Accompagnez de quartiers de citron vert, de carotte et de piment vert en pickle et de bedmi puri si vous le souhaitez."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Remarque",
                  "paragraph": "Si vous servez du bedmi puri, préparez et étalez-le avant de commencer le curry (jusqu'à la fin de l'étape 4, ici). Chauffez l'huile pour la friture une fois que le curry a fini de mijoter et faites frire les puri farcis juste avant de servir."
                }
              }
            }
          ]
        }
      ]
    }
