          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Préchauffez votre four à 180 degrés C et graissez un moule à gâteau à fond mobile scellé de 9 pouces de diamètre. Assurez-vous qu'il s'agit bien d'un sac scellé, sinon le jus des fruits s'échappera."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Dans une casserole, ajoutez le sucre en poudre et la margarine, placez sur feu doux et laissez fondre le sucre et la margarine en un caramel. Cela devrait prendre quelques minutes, mélangez-le un peu avec une spatule de temps en temps. Lorsque le caramel prend une couleur ambrée, retirez-le du feu – veillez à ne pas le laisser trop longtemps car il brûlerait rapidement et deviendrait amer. Soyez également très prudent avec le caramel chaud, il est extrêmement chaud et peut être dangereux."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Versez le caramel dans votre moule à cake en recouvrant complètement le fond si possible."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Disposez soigneusement toutes les lanières de mangue dans le moule à gâteau, en commençant par les bords et en progressant."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Mettez le moule de côté et réalisez rapidement votre préparation à gâteau,"
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Mélanger tous les ingrédients humides dans un bol doseur."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Dans un grand bol à mélanger, tamisez ensemble les ingrédients secs. Versez le mélange de lait et pliez à l'aide de votre spatule en effectuant un mouvement en 8."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Versez la préparation à gâteau directement sur la mangue dans le moule à cake et donnez un petit coup sur la surface pour éliminer les poches d'air."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Mettez le gâteau au four sur la grille inférieure pour cuire pendant 55 minutes, ou jusqu'à ce qu'un cure-dent inséré dans le gâteau et retiré en ressorte propre."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Une fois le gâteau cuit, laissez-le refroidir légèrement pendant 5 minutes avant de le démouler."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Gâteau Renversé À La Mangue",
                  "paragraph": "Servir le gâteau avec de la crème de coco, des feuilles de menthe fraîche et un peu de jus de citron vert."
                }
              }
            }
          ]
        }
