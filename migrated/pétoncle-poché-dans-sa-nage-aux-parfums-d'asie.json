          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une casserole, portez à ébullition le fumet de poisson, le gingembre, la citronnelle, les branches de coriandre et la lime kaffir. Laissez frémir à feu moyen durant 30 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Filtrez le bouillon au tamis, puis vérifiez l'assaisonnement."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Portez à nouveau à ébullition le bouillon, plongez-y les pétoncles et éteignez le feu aussitôt."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Laissez cuire 1 à 2 minutes maximum selon la taille des pétoncles. Ajoutez les champignons, puis servez aussitôt dans des bols."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Par bol, répartissez 2 pétoncles, les champignons et versez du bouillon dessus. Un peu de coriandre fraîche hachée peut être ajoutée sur le dessus."
                }
              }
            }
          ]
        }
