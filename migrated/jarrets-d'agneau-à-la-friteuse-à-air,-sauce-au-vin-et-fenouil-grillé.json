          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Agneau",
                  "paragraph": "Cuire les jarrets à 350°F pendant 30 minutes par côtés. Après une heure de cuisson, vérifier si la chair se détache de l'os, sinon continuer la cuisson à 325°F quelques minutes. Réserver les os."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Agneau",
                  "paragraph": "Commencer a griller le fenouil dans une grande poêle et du beurre. Salé lorsqu'il est près de la fin de la cuisson."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Dans une casserole, mettre le beurre et faire revenir les oignons avec les carottes jusqu'à ce qu'une légère caramélisation débute."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Ajouter les épices et les branches de fenouil et rôtir 2 à 3 minutes. Ajouter les os."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Déglacer la friteuse à air avec l'eau et le vin. Gratter avec une cuillère en bois les sucs grillés des jarrets et récupérer le gras. Si le gras a figer parce que la friteuse à air a trop refroidit, redémarrer la à 350°F pendant 2 à 3 minutes."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Transvider le liquide dans la casserole de légumes, porter à ébullition."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Lorsque le liquide a réduit de moitié, avec une pince, retirer les os et les branches de fenouil. Couper la chaleur."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Sauce",
                  "paragraph": "Mettre le liquide avec les légumes dans un mixeur avec la moutarde, et réduire en sauce. Ajouter du sel et poivre, goûter, et ajuster jusqu'à obtenir le goût recherché. Le sel doit se goûter sans être omniprésent, et la sauce légèrement poivrée."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Suggestions",
                  "paragraph": "Couper la viande en cubes et réchauffer dans la friteuse à air, une poêle, four, ou simplement dans la sauce. Pas de micro-onde, ça tuera le goût de la viande rôti."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Suggestions",
                  "paragraph": "Accompagner de couscous nappé de sauce."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Suggestions",
                  "paragraph": ""
                }
              }
            }
          ]
        }
