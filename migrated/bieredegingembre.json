        {
          "subtitle": "Levain de Gingembre (Ginger Bug)",
          "is_ingredient": true,
          "total_prep_time": 7205,
          "servings": { "yield": 250, "value": "ml" },
          "content_ingredients": [
            {
              "quantity": 250,
              "product": { "name": "eau non chlorée" },
              "ingredient_units": [{ "unit": { "name": "ml" } }]
            },
            {
              "quantity": 50,
              "product": { "name": "gingembre frais bio haché (avec la peau)" },
              "ingredient_units": [{ "unit": { "name": "g" } }]
            },
            {
              "quantity": 50,
              "product": { "name": "sucre blanc" },
              "ingredient_units": [{ "unit": { "name": "g" } }]
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "title": "Activation",
                "paragraph": "Dans un bocal en verre, mélanger l'eau, le gingembre haché et le sucre. Couvrir avec un tissu respirant maintenu par un élastique."
              },
              "segment_prep_time": [
                {
                  "duration": 5,
                  "style": { "str_value": "Préparation", "type": "PrepTime" }
                }
              ]
            },
            {
              "position": 2,
              "segment": {
                "title": "Nourrissage",
                "paragraph": "Chaque jour, ajouter 10g de gingembre haché et 10g de sucre, puis remuer. Le levain est prêt lorsqu'il est visiblement pétillant et actif, généralement après 3 à 7 jours à une température ambiante de 20-25°C."
              },
              "segment_prep_time": [
                {
                  "duration": 7200,
                  "style": { "str_value": "Fermentation", "type": "PrepTime" }
                }
              ]
            }
          ]
        },
        {
          "subtitle": "Levain de Fruits (Fruit Starter)",
          "is_ingredient": true,
          "total_prep_time": 7205,
          "servings": { "yield": 200, "value": "ml" },
          "content_ingredients": [
            {
              "quantity": 200,
              "product": { "name": "eau non chlorée" },
              "ingredient_units": [{ "unit": { "name": "ml" } }]
            },
            {
              "quantity": 25,
              "product": {
                "name": "fruits bio (fraises, bleuets, framboises)"
              },
              "ingredient_units": [{ "unit": { "name": "g" } }]
            },
            {
              "quantity": 20,
              "product": { "name": "sucre blanc" },
              "ingredient_units": [{ "unit": { "name": "g" } }]
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "paragraph": "Écraser légèrement les fruits et les placer dans un bocal avec l'eau et le sucre. Couvrir avec un tissu respirant."
              },
              "segment_prep_time": [
                {
                  "duration": 5,
                  "style": { "str_value": "Préparation", "type": "PrepTime" }
                }
              ]
            },
            {
              "position": 2,
              "segment": {
                "paragraph": "Remuer deux fois par jour. Le levain est prêt lorsque le liquide pétille et qu'une odeur de fermentation agréable se dégage. Filtrer les fruits avant utilisation. La température idéale est de 20-25°C."
              },
              "segment_prep_time": [
                {
                  "duration": 7200,
                  "style": { "str_value": "Fermentation", "type": "PrepTime" }
                }
              ]
            }
          ]
        },
        {
          "subtitle": "Bière de Gingembre (Maison)",
          "total_prep_time": 4370,
          "servings": { "yield": 1, "value": "litre" },
          "content_ingredients": [
            {
              "quantity": 1,
              "product": { "name": "eau" },
              "ingredient_units": [{ "unit": { "name": "l" } }]
            },
            {
              "quantity": 30,
              "product": { "name": "gingembre frais râpé" },
              "ingredient_units": [{ "unit": { "name": "g" } }]
            },
            {
              "quantity": 90,
              "product": { "name": "sucre" },
              "ingredient_units": [{ "unit": { "name": "g" } }]
            },
            {
              "quantity": 50,
              "product": { "name": "Levain de Gingembre (filtré)" },
              "ingredient_units": [{ "unit": { "name": "ml" } }]
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "paragraph": "Dans une casserole, faire mijoter l'eau, le gingembre et le sucre pendant 5 minutes. Retirer du feu et filtrer pour enlever les solides."
              },
              "segment_prep_time": [
                {
                  "duration": 10,
                  "style": { "str_value": "Infusion", "type": "PrepTime" }
                }
              ]
            },
            {
              "position": 2,
              "segment": {
                "paragraph": "Laisser le liquide refroidir complètement jusqu'à atteindre la température ambiante (environ 20-25°C). Un liquide trop chaud tuerait les levures sauvages."
              },
              "segment_prep_time": [
                {
                  "duration": 30,
                  "style": {
                    "str_value": "Refroidissement",
                    "type": "PrepTime"
                  }
                }
              ]
            },
            {
              "position": 3,
              "segment": {
                "paragraph": "Ajouter le levain de gingembre actif. Embouteiller dans des bouteilles résistantes à la pression et laisser fermenter à température ambiante pendant 2 à 4 jours. Réfrigérer lorsque le niveau de carbonatation souhaité est atteint."
              },
              "segment_prep_time": [
                {
                  "duration": 5,
                  "style": { "str_value": "Assemblage", "type": "PrepTime" }
                },
                {
                  "duration": 4320,
                  "style": { "str_value": "Fermentation", "type": "PrepTime" }
                }
              ]
            }
          ]
        },
