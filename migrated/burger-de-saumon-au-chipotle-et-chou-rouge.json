          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Pour Le Chou Rouge Mariné",
                  "paragraph": "Dans un grand bol, mélanger l'ail, le zeste et le jus de lime, le vinaigre, l'huile d'olive, le piment, le sel, le poivre et la coriandre."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Pour Le Chou Rouge Mariné",
                  "paragraph": "Ajouter le chou rouge émincé. Bien mélanger et réserver pendant la préparation du reste."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Pour Les Galettes De Saumon",
                  "paragraph": "Hacher le saumon finement à l'aide d'un couteau (ne pas mixer)."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Pour Les Galettes De Saumon",
                  "paragraph": "Dans un bol, mélanger le saumon avec l'ail, la coriandre, le panko, le zeste et jus de lime, le paprika, les oignons verts, le chipotle, la moutarde, le sel et le poivre."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Pour Les Galettes De Saumon",
                  "paragraph": "Former 5 galettes de taille égale. Réfrigérer pendant 15 minutes pour raffermir."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Pour La Mayonnaise Au Chipotle",
                  "paragraph": "Dans un bol, mélanger la mayonnaise, le chipotle, la sauce pimentée, les oignons verts et l'huile si utilisée."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Pour La Mayonnaise Au Chipotle",
                  "paragraph": "Goûter et ajuster l'assaisonnement si nécessaire."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Cuisson Des Galettes",
                  "paragraph": "Faire chauffer une poêle avec un filet d'huile à feu moyen."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Cuisson Des Galettes",
                  "paragraph": "Cuire chaque galette environ 4 minutes de chaque côté, jusqu'à ce qu'elles soient bien dorées et cuites à cœur."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Montage Des Burgers",
                  "paragraph": "Griller ou réchauffer les pains à burger si désiré."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Montage Des Burgers",
                  "paragraph": "Tartiner les pains avec la mayonnaise au chipotle."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Montage Des Burgers",
                  "paragraph": "Déposer une galette de saumon, ajouter une portion de chou rouge mariné."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Montage Des Burgers",
                  "paragraph": "Compléter avec les garnitures facultatives comme tomate, laitue ou avocat."
                }
              }
            }
          ]
        }
