          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Peser l'eau froide (12-15°C), saupoudrer la gélatine sur l'eau, mélanger légèrement à la cuillère puis laisser gonfler pendant 5 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Dans un petit cul-de-poule, mélanger l'eau chaude (50-55°C) et la vanille, puis ajouter le sucre et mélanger. Réserver."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Faire fondre complètement la gélatine hydratée à feu doux, jusqu'à 60°C en mélangeant continuellement avec une cuillère (environ 5 minutes)."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Transférer la gélatine chaude aux autres ingrédients dans le cul-de-poule."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Battre le mélange 10 minutes à vitesse maximale avec la mixette."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Huiler légèrement un plat en plastique carré (ziploc) avec de l'huile en aérosol."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Étaler le mélange dans le plat préalablement huilé et identifié, fermer le couvercle et laisser prendre la guimauve au réfrigérateur."
                }
              }
            }
          ]
        }
      ]
