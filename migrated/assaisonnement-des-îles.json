          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Mélangez les poivrons verts et rouges, les piments jalapeño, le céleri, l'oignon, l'ail, la ciboulette, le persil, le thym, l'origan et la marjolaine dans un robot culinaire jusqu'à obtenir une pâte grossière."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez l'huile, le jus de lime, la sauce soja, le sel, le poivre et le piment de la Jamaïque et mixez jusqu'à obtenir une pâte lisse."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Utilisez immédiatement ou transférez dans un bocal, couvrez et réfrigérez. L'assaisonnement est meilleur s'il est utilisé dans les quelques heures suivant sa préparation."
                }
              }
            }
          ]
        }
