          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Préchauffez le four à 170 degrés C. Graissez légèrement un moule à gâteau scellé à fond amovible (9 pouces/23 cm de diamètre et 3/4 pouces/10 cm de profondeur)."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Faites d'abord la base. Mixez les biscuits biscoff dans un mixeur jusqu'à obtenir une fine miette. Continuez à mélanger et ajoutez le beurre fondu."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Versez le mélange de biscuits dans le moule à gâteau graissé et utilisez une cuillère pour presser le mélange afin de former une couche de biscuit uniforme au fond et sur les côtés."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Placez le moule dans votre four et faites cuire pendant 10 minutes."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Pendant ce temps, préparez la garniture, nettoyez votre mixeur et ajoutez tous les ingrédients de la garniture sauf les myrtilles. Mixez le mélange pendant environ une minute ou jusqu'à ce qu'il soit complètement lisse."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Une fois le fond cuit, versez-y le mélange de garniture."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Remplissez une plaque à pâtisserie profonde d'eau tiède d'environ 1 à 2 pouces de hauteur, puis placez-y le moule à gâteau. Attention, si vous utilisez un moule à gâteau qui n'est pas scellé, vous devez envelopper le fond du moule avec du papier d'aluminium pour empêcher l'eau de pénétrer."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Transférez délicatement la plaque sur la grille du milieu de votre four pour cuire pendant 1 heure."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Pendant ce temps, pour préparer la sauce aux myrtilles, ajoutez tous les ingrédients dans une petite casserole et laissez mijoter à feu doux pendant 10 minutes. Une fois que la sauce a épaissi et a presque une consistance sirupeuse. Retirez-le du feu et laissez-le refroidir."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Après une heure de cuisson, sortez le cheesecake du four et de la plaque et laissez-le refroidir complètement. Résistez à la tentation de couper le gâteau avant qu'il n'ait complètement refroidi, car il prend complètement pendant qu'il refroidit."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Une fois le cheesecake complètement refroidi, servir avec la sauce aux myrtilles."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Cheesecake Végétalien Style New York",
                  "paragraph": "Le cheesecake se conserve 5 jours au réfrigérateur."
                }
              }
            }
          ]
        }
      ]
