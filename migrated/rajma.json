          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Rajma",
                  "paragraph": "Chauffez l'huile dans une casserole moyenne à feu moyen. Lorsque chaud, ajoutez les purées de gingembre et d'ail et faites sauter pendant 3 à 4 minutes, en remuant presque constamment, jusqu'à ce que l'ail perde son odeur crue."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Rajma",
                  "paragraph": "Ajoutez la gousse de cardamome, la feuille de laurier et le bâton de cannelle et faites cuire pendant 1 minute. Ajoutez le cumin moulu, la poudre de chili, la purée de tomate et le sel, et faites cuire pendant 3 minutes, ou jusqu'à ce que vous voyiez l'huile commencer à se séparer sur les bords."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Rajma",
                  "paragraph": "Ajoutez le masala oignon-tomate et portez à ébullition en remuant, puis ajoutez les haricots rouges, avec leur liquide. Laissez mijoter pendant environ 15 minutes, jusqu'à ce que le liquide ait réduit et épaissi."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Rajma",
                  "paragraph": "Ajoutez le garam masala, les tomates, la coriandre hachée et les allumettes de gingembre et laissez mijoter pendant 2 à 3 minutes. Incorporez le beurre."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Rajma",
                  "paragraph": "Servez garni d'oignon rouge, d'allumettes de gingembre et de coriandre déchirée, avec des quartiers de lime à presser sur le côté."
                }
              }
            }
          ]
        }
      ]
    }
