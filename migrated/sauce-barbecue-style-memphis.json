          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Sauce Barbecue Style Memphis",
                  "paragraph": "Combinez tous les ingrédients du mélange humide dans une grande casserole non réactive et portez lentement à ébullition, à découvert, à feu moyen."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Sauce Barbecue Style Memphis",
                  "paragraph": "Pendant ce temps, combinez les ingrédients du mélange sec dans un bol et mélangez-les avec vos doigts."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Sauce Barbecue Style Memphis",
                  "paragraph": "Réduisez le feu et incorporez les ingrédients du mélange sec au mélange de sauce. Laissez mijoter doucement la sauce, à découvert, jusqu'à ce qu'elle soit épaisse, concentrée et riche en saveurs, environ 15 à 20 minutes. Utilisez immédiatement ou transférez dans des bocaux, couvrez, laissez refroidir à température ambiante et réfrigérez. La sauce se conservera plusieurs semaines au réfrigérateur."
                }
              }
            }
          ]
        }
