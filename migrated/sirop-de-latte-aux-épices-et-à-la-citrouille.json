          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Placez les cubes de citrouille dans une casserole moyenne et couvrez-les d'eau."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Posez un couvercle sur la poêle puis placez la poêle sur feu moyen."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Pendant ce temps, dans une autre casserole, ajoutez le sucre, l'eau, le gingembre, la cannelle, la muscade, la vanille et l'anis étoilé, puis portez le mélange à ébullition pour infuser."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Lorsque le potiron est cuit, mixez-le en purée onctueuse avec un peu de jus de cuisson."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Ajouter 1/2 tasse de purée de potiron au mélange sucre/sirop d'eau. Les restes de citrouille peuvent être transformés en soupe en ajoutant du bouillon de légumes et des assaisonnements."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Laisser mijoter le sirop de citrouille pendant 5 minutes ou jusqu'à ce qu'il épaississe jusqu'à obtenir une consistance légèrement glacée. (Le sirop épaissit une fois refroidi, alors ne l'épaississez pas trop)"
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Passez le sirop au tamis dans une bouteille de votre choix."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Une fois refroidi, utilisez le sirop pour préparer de délicieux lattés épicés à la citrouille."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Le sirop peut être conservé dans une bouteille scellée dans votre placard pendant quelques mois."
                }
              }
            }
          ]
        }
      ]
