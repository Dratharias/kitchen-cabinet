          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Décortiquez les crevettes, réservez les têtes pour la réalisation d'une sauce, bisque ou huile de crustacés."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Incisez légèrement tout le long du dos de chaque crevette, pour en extraire le boyau (filament noir). Réserver au frais."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Taillez feuilles de coriandre en 2 le sens de la longueur."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Préchauffez l'huile de la friteuse à 375°F."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Assaisonnez les crevettes avec du sel et un peu de piment d'Espelette."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Dans un bol, diluez la farine dans suffisamment d'eau pour obtenir une colle alimentaire."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Dans chaque feuille de rouleau de printemps, taillez 3 rectangles."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "paragraph": "Sur le plan de travail, disposez les rectangles et sur chacun, déposez une crevette et une feuille de coriandre. Roulez chaque rectangle de pâte et fermez les bouts avec un peu de colle alimentaire préparée. Réservez au frais, si nécessaire."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "paragraph": "Plongez les rouleaux dans l'huile de la friteuse et laissez cuire jusqu'à obtenir une belle coloration dorée."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez une pincée de sel à la sortie de la friteuse."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "paragraph": "Servez aussitôt accompagné d'une vinaigrette asiatique ou une mayonnaise."
                }
              }
            }
          ]
        }
      ]
    }
