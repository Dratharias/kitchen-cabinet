          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Soupe De Betteraves Jardinière",
                  "paragraph": "Faites suer doucement l'oignon, l'ail et les carottes dans une casserole avec l'huile d'olive et quelques herbes fraîches, j'ai utilisé de la sauge, du romarin et de la marjolaine. Assaisonner avec un peu de sel de céleri."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Soupe De Betteraves Jardinière",
                  "paragraph": "Ajoutez les betteraves râpées, la pomme de terre et la tomate et laissez cuire encore quelques minutes avant de déglacer avec du bouillon ou de l'eau. Ajoutez ensuite une feuille de laurier, de l'aneth, du vinaigre et un assaisonnement supplémentaire."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Soupe De Betteraves Jardinière",
                  "paragraph": "Mettez le couvercle sur la casserole et laissez cuire la soupe pendant 15 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Soupe De Betteraves Jardinière",
                  "paragraph": "Vérifiez si la soupe est assaisonnée à votre goût puis servez avec un filet d'huile d'olive, décorez d'herbes fraîches et d'une tranche de levain."
                }
              }
            }
          ]
        }
