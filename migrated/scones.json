          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Fouetter ensemble la farine, le sucre, le sel et la levure chimique dans un grand bol. Râper le beurre surgelé à l'aide d'une râpe boîte. Ajoutez-le au mélange de farine et mélangez avec un coupe-pâte, deux fourchettes ou vos doigts jusqu'à ce que le mélange se rassemble en chapelure de la taille d'un pois."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Placer au réfrigérateur ou au congélateur pendant que vous mélangez les ingrédients humides ensemble."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Fouetter 1/2 tasse de crème épaisse, l'œuf et l'extrait de vanille dans un petit bol. Arroser le mélange de farine, ajouter les compléments, puis mélanger jusqu'à ce que tout semble humidifié."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Pour faire des scones triangulaires : versez sur le comptoir et, avec les mains farinées, façonnez la pâte en boule du mieux que vous pouvez. La pâte sera collante. Si c'est trop collant, rajouter un peu de farine. S'il semble trop sec, ajoutez 1 à 2 cuil. à soupe de crème épaisse en plus. Presser en un disque de 8 pouces et, avec un couteau bien aiguisé ou un grattoir, couper en 8 quartiers."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Pour faire des petits scones: presser la pâte en deux disques de 5 pouces et couper chacun en 8 quartiers."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Pour faire 10 à 12 scones : Continuez à mélanger la pâte dans le bol jusqu'à ce qu'elle se rassemble. Déposer les scones, environ 1/4 tasse de pâte chacun, à 3 pouces d'intervalle sur une plaque à pâtisserie tapissée."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Badigeonner les scones avec la crème épaisse restante et pour plus de croquant, saupoudrer de sucre grossier."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Placer les scones sur une assiette ou une plaque à pâtisserie tapissée et réfrigérer pendant au moins 15 minutes."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Entre-temps, préchauffer le four à 400 °F."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Tapisser une grande plaque à pâtisserie de papier parchemin ou de tapis de cuisson en silicone."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Cuire au four de 18 à 26 minutes ou jusqu'à ce qu'ils soient dorés sur les bords et légèrement dorés sur le dessus. Les scones plus gros prennent plus de 25 minutes."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Scones",
                  "paragraph": "Retirer du four et laisser refroidir quelques minutes."
                }
              }
            }
          ]
        }
      ]
    }
