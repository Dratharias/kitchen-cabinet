          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Faire tremper les haricots dans beaucoup d'eau pendant la nuit ou au moins 8 heures."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Le lendemain, égoutter les haricots et les pulser dans un robot culinaire pour les briser légèrement. Ensuite, ajouter 500 ml d'eau et mélanger jusqu'à obtenir une consistance lisse."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Filtrer les haricots mélangés à travers un tamis dans une casserole et utiliser le dos de la cuil. à soupe pour presser autant de liquide que possible (Vous pouvez jeter la pulpe restante, ou l'utiliser pour épaissir les ragoûts, les soupes ou même la mélanger dans des pains)."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter 1/2 cuil. à thé de sel au liquide et mélanger. Vous remarquerez que certaines des protéines se sont déjà déposées au fond de la casserole. Assurez-vous de les détacher avec le fouet ou elles brûleront."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Porter le liquide à ébullition douce, en fouettant constamment. Laisser mijoter pendant 1 minute, en remuant de temps en temps, jusqu'à ce que le mélange adhère au fouet et ne s'égalise pas instantanément lorsque vous le remuez."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Lorsque vous penchez la casserole, le liquide devrait se déplacer lentement. Si cela semble trop liquide, laissez-le cuire un peu plus longtemps."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Laissez reposer au réfrigérateur pendant 3 à 4 heures pour que le mélange prenne et devienne plus ferme."
                }
              }
            }
          ]
        }
