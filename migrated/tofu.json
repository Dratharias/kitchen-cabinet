                      "name": "cuil. à thé"
                    }
                  }
                }
              ]
            },
            {
              "data": {
                "quantity": 250,
                "multiply_factor": 1
              },
              "product": {
                "data": {
                  "name": "eau"
                }
              },
              "ingredient_units": [
                {
                  "unit": {
                    "data": {
                      "name": "ml"
                    }
                  }
                }
              ]
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Faire tremper les pois chiches dans beaucoup d'eau pendant la nuit ou au moins 8 heures."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Le lendemain, égoutter les pois chiches et les ajouter au récipient d'un mélangeur à haute vitesse (comme le Vitamix) avec le gingembre (vous pouvez garder la peau), le piment vert (retirer simplement la tige) et 250 ml d'eau. Ensuite, mélanger pendant 1 minute à vitesse élevée jusqu'à obtenir une consistance lisse."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Verser le mélange dans une poêle antiadhésive et ajouter le curcuma et 1/2 cuil. à thé de sel. Porter à ébullition, puis réduire le feu et cuire pendant 2 à 5 minutes, en remuant constamment avec une spatule. Les amidons vont se déposer au fond et coller, il est donc important de remuer constamment pour éviter que cela se produise."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Continuer la cuisson jusqu'à ce qu'il se transforme en une pâte épaisse qui ne s'étale plus dans la poêle et adhère à la spatule. Si c'est encore liquide, cuire un peu plus longtemps."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Laissez reposer au réfrigérateur pendant 3 à 4 heures pour que le mélange prenne et devienne plus ferme."
                }
              }
            }
          ]
        },
        {
          "data": {
            "total_prep_time": 0,
            "servings": null,
            "subtitle": "Soja",
            "is_ingredient": false
          },
          "content_ingredients": [
            {
              "data": {
                "quantity": 500,
                "multiply_factor": 1
              },
              "product": {
                "data": {
                  "name": "feves de soja"
                }
              },
              "ingredient_units": [
                {
                  "unit": {
                    "data": {
                      "name": "g"
                    }
                  }
                }
              ]
            },
            {
              "data": {
                "quantity": 3,
                "multiply_factor": 1
              },
              "product": {
                "data": {
                  "name": "jus de citron"
                }
              },
              "ingredient_units": [
                {
                  "unit": {
                    "data": {
                      "name": "cuil."
                    }
                  }
                }
              ]
            },
            {
              "data": {
                "quantity": 2400,
                "multiply_factor": 1
              },
              "product": {
                "data": {
                  "name": "eau"
                }
              },
              "ingredient_units": [
                {
                  "unit": {
                    "data": {
                      "name": "ml"
                    }
                  }
                }
              ]
            }
          ],
          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Faire tremper les fèves de soja toute la nuit dans 3 fois la quantité d'eau. Le lendemain, égoutter les fèves de soja et les diviser en quatre parties égales."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Pulser une partie dans un robot culinaire pour les écraser légèrement.Ajouter 600 ml d'eau et mixer jusqu'à obtenir une consistance lisse. Filtrer les fèves de soja mixées à travers une passoire dans une casserole et utiliser le dos de la cuillère pour en extraire autant de liquide que possible (vous pouvez également utiliser une étamine pour cela).Jeter la pulpe ou l'utiliser dans une pâtisserie."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Répéter la même étape avec les lots restants de fèves de soja (si votre robot culinaire a une capacité suffisante, vous pouvez mixer davantage à la fois, mais j'obtiens généralement de meilleurs résultats en le faisant en quatre fois)."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Une fois que vous avez filtré tout le lait de soja dans la casserole, enlever la couche épaisse de mousse à la surface. Porter le mélange à ébullition douce tout en le fouettant de temps en temps pour éviter qu'il ne colle au fond de la casserole. Retirer toute mousse qui pourrait se former. Pendant ce temps, presser le jus de citron. Vous en voulez environ 50 ml."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Lorsque le liquide commence à bouillir, baisser le feu et laisser mijoter pendant 5 minutes pour éliminer la saveur de fève crue. Ensuite, éteindre le feu, laisser reposer une minute pour qu'il refroidisse légèrement (il devrait être à environ 90 °C) et ajouter le jus de citron. Mettre la casserole de côté pendant 10 minutes pour qu'elle commence à cailler."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "paragraph": "Tapisser un moule avec une étamine, le placer dans un plateau profond (pour récupérer tout liquide résiduel) et utiliser une cuillère trouée pour transférer les solides dans le moule. Replier l'étamine sur les solides et placer un poids (par exemple une grosse boîte de tomates) par-dessus pour presser le tofu."
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "paragraph": "Laissez reposer au réfrigérateur pendant 3 à 4 heures pour que le mélange prenne et devienne plus ferme. Si vous le voulez plus ferme, pressez-le simplement un peu plus longtemps avec le poids (ou augmentez le poids la prochaine fois)."
                }
              }
            }
          ]
        },
