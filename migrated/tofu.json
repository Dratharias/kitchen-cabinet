          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Ajoutez vos lentilles et l'eau bouillante dans un mixeur et laissez reposer pendant 10 à 15 minutes pour que les lentilles cuisent légèrement."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Mélangez jusqu'à obtenir une consistance lisse, en ajoutant du sel et des épices selon votre goût."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Transférez le mélange dans une petite casserole avec l'eau à température ambiante et faites cuire à feu moyen, en remuant continuellement jusqu'à ce que le mélange épaississe. Cela devrait prendre environ 5 à 7 minutes."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Transférez le mélange dans un récipient de votre choix ; cela servira de moule."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Laissez reposer au réfrigérateur pendant 3 à 4 heures pour que le mélange prenne et devienne plus ferme."
                }
              }
            }
          ]
