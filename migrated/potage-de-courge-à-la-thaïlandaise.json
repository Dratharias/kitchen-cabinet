          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "paragraph": "Dans une casserole, chauffer la moitié de l'huile à feu moyen. Cuire l'oignon et l'ail de 1 à 2 minutes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "paragraph": "Ajouter les carottes et la courge dans la casserole. Cuire de 2 à 3 minutes. Saler."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "paragraph": "Ajouter la pâte de cari rouge et cuire 30 secondes, jusqu'à ce que les arômes se libèrent."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "paragraph": "Ajouter le bouillon et le lait de coco. Porter à ébullition, puis laisser mijoter de 25 à 30 minutes à feu doux-moyen."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "paragraph": "Transférer la préparation à la courge dans le contenant du mélangeur électrique. Mélanger 1 minute, jusqu'à l'obtention d'une préparation lisse et onctueuse."
                }
              }
            }
          ]
        }
