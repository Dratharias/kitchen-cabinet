          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Pour faire la sauce au citron, ajoutez tous les ingrédients dans une petite casserole, à l'exception de la maïzena."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Placez la casserole sur feu doux. Laissez mijoter le mélange pendant 10 minutes en remuant de temps en temps."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Pendant ce temps, mélangez la maïzena dans un petit bol avec suffisamment d'eau pour obtenir une consistance lisse et liquide."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Incorporer le mélange de maïzena et continuer à fouetter jusqu'à ce que la sauce épaississe. Ajoutez un peu plus d'eau s'il épaissit trop ou un peu plus de mélange de farine de maïs s'il est encore trop liquide. Réservez la sauce jusqu'au moment de servir."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "La sauce peut être conservée dans un récipient hermétique au réfrigérateur jusqu'à 3 semaines."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Pour le tofu croustillant"
                }
              }
            },
            {
              "position": 7,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Ajouter les ingrédients secs de la pâte dans un bol à mélanger et bien mélanger."
                }
              }
            },
            {
              "position": 8,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Incorporer suffisamment de kombucha pour obtenir une consistance de type pâte à crêpes."
                }
              }
            },
            {
              "position": 9,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Faites chauffer votre huile dans une grande casserole (remplie à mi-hauteur maximum) à feu moyen."
                }
              }
            },
            {
              "position": 10,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Pour tester que votre huile est suffisamment chaude, plongez une cuillère en bois dans l'huile et si des bulles se forment autour, l'huile est suffisamment chaude."
                }
              }
            },
            {
              "position": 11,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Trempez délicatement les cubes de tofu dans la pâte avant de les placer délicatement dans l'huile."
                }
              }
            },
            {
              "position": 12,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Faites frire les cubes de tofu pendant 3 minutes ou jusqu'à ce qu'ils soient dorés et croustillants. Je les retourne à mi-cuisson à l'aide d'une araignée ou d'une écumoire."
                }
              }
            },
            {
              "position": 13,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Retirez le tofu croustillant de l'huile et placez-le sur une assiette recouverte de papier absorbant."
                }
              }
            },
            {
              "position": 14,
              "segment": {
                "data": {
                  "title": "Tofu Croustillant Au Citron",
                  "paragraph": "Assaisonnez avec du sel et réservez-les jusqu'au moment de servir."
                }
              }
            },
            {
              "position": 15,
              "segment": {
                "data": {
                  "title": "Servir",
                  "paragraph": "Faites revenir vos légumes au wok à feu vif en ajoutant une touche de sauce en fin de friture."
                }
              }
            },
            {
              "position": 16,
              "segment": {
                "data": {
                  "title": "Servir",
                  "paragraph": "Servir les légumes avec du riz, les boulettes de tofu croustillantes et beaucoup de sauce. Je saupoudre de noix de cajou grillées et de graines de sésame."
                }
              }
            }
          ]
        }
      ]
    }
