          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Sambal D Échalotes",
                  "paragraph": "Chauffez l'huile dans un wok non réactif ou une petite poêle à feu moyen. Ajoutez la pâte de crevettes et faites cuire jusqu'à ce qu'elle soit parfumée, 30 secondes à 1 minute. Ajoutez les échalotes, les piments et l'ail et faites cuire jusqu'à ce qu'ils soient dorés, 6 à 8 minutes, en réduisant le feu si nécessaire pour éviter de brûler les échalotes."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Sambal D Échalotes",
                  "paragraph": "Transférez le mélange dans un robot culinaire et hachez finement. Ajoutez le jus de lime, le sel et le poivre. Transférez dans un bocal, couvrez et réfrigérez. Le sambal se conservera presque indéfiniment."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Variation",
                  "paragraph": "Pour un sambal plus audacieux, plus intense, faites cuire la moitié des piments, en laissant l'autre moitié crue. Ajoutez ces piments crus lorsque vous hachez le sambal."
                }
              }
            }
          ]
        }
      ]
