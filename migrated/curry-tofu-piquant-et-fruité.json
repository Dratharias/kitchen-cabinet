          "content_segments": [
            {
              "position": 1,
              "segment": {
                "data": {
                  "title": "Curry Tofu Piquant Et Fruité",
                  "paragraph": "Placez une grande casserole antiadhésive sur feu doux et ajoutez l'huile. Lorsque la poêle est chaude, ajoutez les gousses de cardamome, les feuilles de curry, le bâton de cannelle et le piment vert. Laissez-les infuser l'huile et libérer leur saveur pendant quelques minutes avant d'ajouter l'oignon, l'ail et le gingembre et laissez le tout cuire 10 minutes. Il est important de laisser les oignons bien dorés, cela libérera tous leurs sucres, ce qui donnera une belle saveur de base à votre curry."
                }
              }
            },
            {
              "position": 2,
              "segment": {
                "data": {
                  "title": "Curry Tofu Piquant Et Fruité",
                  "paragraph": "Une fois les oignons dorés, ajoutez toutes les épices et le sel marin. Cuire encore quelques minutes en remuant souvent."
                }
              }
            },
            {
              "position": 3,
              "segment": {
                "data": {
                  "title": "Curry Tofu Piquant Et Fruité",
                  "paragraph": "Ajoutez la purée de tomates, le poulet végétalien et la pomme. Remuez bien pour que le poulet et la pomme soient enrobés de toutes les belles saveurs."
                }
              }
            },
            {
              "position": 4,
              "segment": {
                "data": {
                  "title": "Curry Tofu Piquant Et Fruité",
                  "paragraph": "Ajoutez la boîte de tomates hachées et environ une tasse d'eau (240 ml). Je fais simplement couler la boîte avec l'eau et je l'ajoute."
                }
              }
            },
            {
              "position": 5,
              "segment": {
                "data": {
                  "title": "Curry Tofu Piquant Et Fruité",
                  "paragraph": "Mélangez bien puis placez un couvercle sur la casserole et laissez mijoter le curry pendant 20 minutes. En remuant de temps en temps."
                }
              }
            },
            {
              "position": 6,
              "segment": {
                "data": {
                  "title": "Curry Tofu Piquant Et Fruité",
                  "paragraph": "Au bout de 20 minutes, le curry devrait avoir épaissi, sentir bon et les pommes ramollies. Servir avec du riz, des chutneys et des samosas."
                }
              }
            }
          ]
        }
      ]
